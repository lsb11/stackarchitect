---
import { pageUpdated } from '../data/pageUpdated';
import Base from '../layouts/Base.astro';
import { READ_DATE } from '../data/priceSources';
import PriceSources from '../components/PriceSources.astro';
import { STOCKY_EOL_SHORT } from '../utils/stockyDeadline';
import { PRODUCTS } from '../data/products';
import Disclosure from '../components/Disclosure.astro';
import AuthorCard from '../components/AuthorCard.astro';
// src/pages/shopify-automation-guides.astro
// Stack Architect — Free Shopify Automation & AI Guides Hub 2026
// Canonical: https://stackarchitect.xyz/shopify-automation-guides

const SITE_URL = "https://stackarchitect.xyz";
const PAGE_PATH = "/shopify-automation-guides/";
const CANONICAL = `${SITE_URL}${PAGE_PATH}`;

// Single source of truth for the modified date. The schema dateModified, the
// meta description and the visible hero tag all derive from this — never
// hardcode any of them, or the three drift apart (they previously read
// 2026-07-17, "July 2026" and "2026.06.20" respectively).
const DATE_MODIFIED = pageUpdated('/shopify-automation-guides/')!;

const UPDATED_LABEL = new Date(DATE_MODIFIED).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });

// ── Guide rows ──
// The single source for the ten cluster lists, the ItemList JSON-LD and every
// guide count on the page. A guide listed under two clusters (abandoned cart,
// under Email and CRO) is two rows but one guide, so `guides` dedupes by href.
// Never type the count: the ItemList declared 30 while the lists showed a
// different set, and the title said "40+" against 34.
type GuideRow = {
  cluster: string; href: string; title: string; desc: string; time: string;
  item?: string; arrow?: string; pill?: [string, string]; style?: string;
};
const rows: GuideRow[] = [
  { cluster: 'ai', href: '/blog/shopify-ai-playbook-2026/', item: 'gpi-ai', arrow: 'arr-ai', title: 'The Complete Shopify AI Playbook 2026: How to Use AI to Run Your Entire Store', desc: '7 operational stages, free tools first: product research, ads, email, tracking, support, GEO', pill: ['Playbook', 'pill-ai'], time: '20 min' },
  { cluster: 'ai', href: '/blog/shopify-agentic-storefronts-setup-guide-2026/', item: 'gpi-ai', arrow: 'arr-ai', title: 'Shopify Agentic Storefronts: Complete Setup Guide 2026. Sell on ChatGPT, Google AI Mode & Copilot', desc: 'Eligibility requirements, Knowledge Base App setup, product data optimisation, what to do if not eligible yet', pill: ['Guide', 'pill-ai'], time: '18 min' },
  { cluster: 'ai', href: '/best-ai-tools-shopify/', item: 'gpi-hl', arrow: 'arr-ai', title: 'Best AI Tools for Shopify 2026: 9 Tools Ranked by ROI', desc: 'GetResponse, Writesonic, AdCreative.ai and 6 more: honest verdicts with free options noted', pill: ['Comparison', 'pill-level'], time: '15 min' },

  { cluster: 'support', href: '/blog/tidio-for-shopify-complete-setup-guide/', item: 'gpi-support', arrow: 'arr-support', title: 'Tidio for Shopify: Complete Setup Guide 2026. Install Lyro AI, Automate Order Queries, Replace Gorgias Free', desc: 'Step-by-step: install, widget config, Lyro AI training, chatbot flows, Shopify order sync, live in 30 minutes', pill: ['Setup Guide', 'pill-support'], time: '12 min' },
  { cluster: 'support', href: '/blog/tidio-vs-gorgias-shopify/', item: 'gpi-support', arrow: 'arr-support', title: 'Tidio vs Gorgias for Shopify 2026: Which Customer Support Tool Is Actually Worth It?', desc: 'Full feature table, pricing breakdown, decision framework by store size: honest verdict', pill: ['Comparison', 'pill-support'], time: '12 min' },

  { cluster: 'tracking', href: '/blog/shopify-meta-roas-dropped-2026-fix/', item: 'gpi-roas', arrow: 'arr-red', title: "Shopify Meta ROAS Dropped in 2026? Here's Exactly Why: and the Free Fix", desc: 'iOS 26 + Shopify pixel change + Meta algorithm: diagnose your gap and fix it free in about 45 minutes', pill: ['Q1 2026 Changes', 'pill-alert'], time: '18 min' },
  { cluster: 'tracking', href: '/blog/shopify-server-side-tracking-complete-setup-guide/', item: 'gpi-hl', title: 'Shopify Server-Side Tracking: Complete Setup Guide 2026 (Meta, Google & TikTok)', desc: 'One Make.com scenario, three platform branches: the complete free setup guide', pill: ['Intermediate', 'pill-level'], time: '12 min' },
  { cluster: 'tracking', href: '/blog/how-to-fix-shopify-conversion-tracking-after-ios-updates/', item: 'gpi-new', title: 'How to Fix Shopify Conversion Tracking After iOS Updates 2026: Complete Diagnosis Guide', desc: 'iOS 14.5 ATT → iOS 17 Link Tracking → iOS 26: the full timeline, your exact gap, specific fix for each cause', time: '14 min' },
  { cluster: 'tracking', href: '/shopify-google-ads-conversion-tracking/', item: 'gpi-hl', title: 'Free Shopify Google Ads Conversion Tracking: GCLID + Enhanced Conversions (Product Page)', desc: 'Full product guide: why Google Ads misses Shopify purchases, how server-side Enhanced Conversions fixes it, comparison vs Stape and Littledata', time: '10 min' },
  { cluster: 'tracking', href: '/blog/shopify-google-analytics-4-setup-free-2026/', item: 'gpi-new', title: 'How to Set Up Google Analytics 4 on Shopify Free 2026: No Apps, No Code', desc: 'Native GA4 via Google & YouTube channel plus Make.com server-side purchase events: complete tracking at $0', time: '16 min' },

  { cluster: 'tiktok', href: '/tiktok-events-api-shopify/', item: 'gpi-tiktok', arrow: 'arr-tiktok', title: 'TikTok Events API for Shopify: Free Server-Side Tracking (Product Guide + Make.com Scenario)', desc: 'Pixel mode warning, CompletePayment event name, Advanced Matching, deduplication: full free setup with scenario blueprint', pill: ['Free', 'pill-new'], time: '8 min' },

  { cluster: 'inventory', href: '/stocky-alternative/', item: 'gpi-hl', arrow: 'arr-sky', style: 'background:rgba(245,182,77,.04);border-color:rgba(245,182,77,.2);', title: 'Shopify Stocky Has Shut Down: Replace It Free, and Export While You Still Can', desc: 'Timeline, data export checklist, supplier data warning, free 4-minute replacement', pill: ['Ended 31 Aug', 'pill-urgent'], time: '10 min' },
  { cluster: 'inventory', href: '/blog/the-ultimate-guide-to-shopify-inventory-management/', item: 'gpi-new', arrow: 'arr-sky', title: 'The Ultimate Guide to Shopify Inventory Management 2026: Free Systems That Scale', desc: 'Complete inventory system: order logging, live stock calculations, low-stock alerts, supplier management, velocity analysis, all free', time: '18 min' },
  { cluster: 'inventory', href: '/blog/shopify-stocky-data-export-before-shutdown/', item: 'gpi-hl', arrow: 'arr-sky', style: 'background:rgba(245,182,77,.03);border-color:rgba(245,182,77,.15);', title: 'Shopify Stocky Data Export: What to Save While the Read-Only Export Lasts', desc: 'Exactly what is stranded behind the read-only export window, and how to export purchase orders, stocktakes and supplier records now', pill: ['Read-only export', 'pill-urgent'], time: '10 min' },
  { cluster: 'inventory', href: '/stocky-migration-risk-scorer/', arrow: 'arr-sky', title: 'Stocky Migration Risk Scorer: Free Calculator', desc: "Score your store's migration risk in 60 seconds and get a prioritised action list", pill: ['Tool', 'pill-new'], time: '2 min' },

  { cluster: 'email', href: '/replace-klaviyo-free/', item: 'gpi-email', arrow: 'arr-email', title: 'Replace Klaviyo Free 2026: Pricing, UK Costs, and the Migration Path', desc: 'The Feb 2025 active-profile billing change, tier pricing in USD with UK VAT, Systeme.io and GetResponse compared, and the 30-minute migration', pill: ['Pillar Guide', 'pill-level'], time: '22 min' },
  { cluster: 'email', href: '/blog/shopify-abandoned-cart-recovery-free-2026/', item: 'gpi-email', arrow: 'arr-email', title: 'Shopify Abandoned Cart Recovery Free 2026: Make.com + Systeme.io', desc: 'No app, no monthly fees: full 3-email sequence via Make.com webhook + Systeme.io automation. Complete 30-minute setup guide.', time: '10 min' },

  { cluster: 'profit', href: '/shopify-profit-loss-automation/', item: 'gpi-profit', arrow: 'arr-profit', title: 'Shopify P&L Automation: Live Profit and Loss in Google Sheets Free (2026)', desc: 'Complete template, field mapping reference, Looker Studio dashboard: auto-updates every order with net profit calculated', pill: ['Product Guide', 'pill-level'], time: '8 min' },

  { cluster: 'cro', href: '/blog/shopify-conversion-rate-optimisation-free-2026/', item: 'gpi-new', title: 'Shopify Conversion Rate Optimisation Free 2026: 12 Free CRO Tools in Priority Order', desc: 'Fix the tracking gap first, then: abandoned cart, Tidio live chat, Microsoft Clarity, GA4 funnels, post-purchase email, PageSpeed, all at $0', time: '11 min' },
  { cluster: 'cro', href: '/blog/shopify-abandoned-cart-recovery-free-2026/', item: 'gpi-new', title: 'Shopify Abandoned Cart Recovery Free 2026: Make.com + Systeme.io', desc: '3-email recovery sequence with no app, no monthly fees: set up in 30 minutes', time: '10 min' },
  { cluster: 'cro', href: '/capi-shield/', title: 'CAPI Shield: Fix the Tracking Gap Before Any CRO Work', desc: 'Server-side Meta tracking: covers the purchase events browser tracking loses, which make conversion rate look artificially low', pill: ['Start Here', 'pill-level'], time: '6 min' },

  { cluster: 'make', href: '/make-com-shopify/', item: 'gpi-make', arrow: 'arr-make', title: 'Make.com for Shopify 2026: Setup, Free-Tier Limits, and Zapier vs Shopify Flow', desc: 'What Make.com does for Shopify, connecting in 3 min, the scenarios every store needs, free-plan credit limits, and the honest comparison against Zapier and Shopify Flow', pill: ['Start Here', 'pill-make'], time: '20 min' },
  { cluster: 'make', href: '/blog/when-to-upgrade-free-make-google-workspace/', item: 'gpi-workspace', arrow: 'arr-workspace', title: "When to Upgrade from Free Make.com to Google Workspace: Shopify Operator's Guide 2026", desc: 'The 7 upgrade signals, the cost calculation, 5-step migration with zero downtime', pill: ['Decision Guide', 'pill-workspace'], time: '14 min' },
  { cluster: 'make', href: '/best-free-shopify-apps-2026/', item: 'gpi-new', title: 'Best Free Shopify Apps 2026: What Apps Really Cost and What to Cut', desc: 'Real monthly cost of common app stacks, which paid apps are genuinely replaceable and which are not, and the free replacement for every category', pill: ['Pillar Guide', 'pill-new'], time: '18 min' },
  { cluster: 'make', href: '/blog/shopify-bfcm-automation-checklist-2026/', item: 'gpi-new', title: 'Shopify BFCM Automation Checklist 2026: 14 Things to Set Up Before Black Friday', desc: 'Tracking setup, a Make.com budget check in October: the complete BFCM preparation checklist', pill: ['BFCM 2026', 'pill-alert'], time: '14 min' },

  { cluster: 'workflow', href: '/blog/google-apps-script-quotas-explained-how-to-avoid-limits-and-scale-your-automations/', item: 'gpi-hl', title: 'Google Apps Script Quotas & Limits 2026: Every Error, Every Fix (Free)', desc: 'The definitive guide to every quota limit, error code, and fix strategy', time: '9 min' },
  { cluster: 'workflow', href: '/blog/the-complete-guide-to-reliable-shopify-automations/', item: 'gpi-new', title: "The Complete Guide to Reliable Shopify Automations 2026: Architecture That Doesn't Break", desc: 'Error handling, deduplication, reconciliation, monitoring: the patterns that separate production-grade from fragile', time: '14 min' },
];
const listRows = (cluster: string) => rows.filter((r) => r.cluster === cluster);
const guides = rows.filter((r, i) => rows.findIndex((x) => x.href === r.href) === i);
const GUIDE_COUNT = guides.length;

const seo = {
  title: `Free Shopify Automation Guides 2026 — ${GUIDE_COUNT} Guides`,
  description:
    `${GUIDE_COUNT} free Shopify automation guides: server-side tracking, Google Ads, TikTok CAPI, email, inventory and P&L. No code, $0. Updated ${UPDATED_LABEL}.`,
  ogImage: "https://stackarchitect.xyz/og.png",
  author: "Stack Architect",
};

// ── Affiliate links — all routed through /go/ for Brave safety ──
const aff = {
  make:        "/go/make/",
  systeme:     "/go/systeme/",
  tidio:       "/go/tidio/",
  getresponse: "/go/getresponse/",
  beehiiv:     "/go/beehiiv/",
  workspace:   "/go/workspace/",
};

// ── FAQ ──
// One array feeds both the rendered grid and the FAQPage JSON-LD. `a` is the
// visible answer HTML; the schema text is that HTML with the tags stripped, so
// the two cannot disagree (they did: the schema had 10 questions to the grid's
// 12, with different wording and a different GMV figure).
//
// The vendor prices in these answers were read on the vendors' own pricing
// pages on READ_DATE (src/data/priceSources.ts), so the schema text now
// carries them too, exactly as the visible answer does.
const faqs = [
  {
    q: "How do I fix Shopify Meta ROAS dropping in 2026?",
    a: `Three changes converged in Q1 2026 to break Meta tracking: iOS 26's Link Tracking Protection, Shopify's January 13 pixel default switching to Optimized mode, and Meta's algorithm shift. Fix: switch App Pixel to Always On in Settings → Customer Events, set Meta data sharing to Maximum, and implement server-side CAPI via Make.com. <strong>Measure your own result as Additional Conversions Reported in Meta Events Manager, typically within 7–14 days.</strong> The full guide is <a href="https://stackarchitect.xyz/blog/shopify-meta-roas-dropped-2026-fix/">free here</a>.`,
  },
  {
    q: "What replaces Shopify Stocky now that it shut down on 31 August 2026?",
    a: `<strong>Stocky Swap</strong> is a free Make.com webhook that automatically logs every Shopify order to a Google Sheet you own: no vendor lock-in, no monthly fees. Deploys in 4 minutes on any Shopify plan. Shopify Stocky was removed from the App Store February 2, 2026 and ended service August 31; inventory data stays exportable read-only for at least 90 days after that. (Source: <a href="https://help.shopify.com/en/manual/products/inventory/transitioning-from-stocky" rel="nofollow">Shopify, “Transitioning from Stocky”</a>, read 10 September 2026.) The <a href="https://stackarchitect.xyz/blog/the-ultimate-guide-to-shopify-inventory-management/">Ultimate Inventory Guide</a> covers the complete free system including stock alerts, supplier tracking, and velocity analysis.`,
  },
  
  {
    q: "How does TikTok Events API work with Shopify?",
    a: `TikTok's Events API sends purchase events server-to-server via Make.com, bypassing iOS restrictions. <strong>The critical detail: TikTok's purchase event is called CompletePayment, not "Purchase".</strong> Using the wrong name sends events to the wrong category in Events Manager. You cannot change pixel mode after creation, so verify before starting.`,
  },
  {
    q: "Is Make.com actually free for Shopify automation?",
    a: `Yes. Make.com's free plan gives 1,000 credits/month (formerly called operations), 10× more than Zapier's 100 free tasks, including webhook triggers and HTTP modules. <strong>One Shopify Order Payment webhook can simultaneously branch to Meta CAPI, Google Enhanced Conversions, TikTok Events API, Google Sheets inventory, and P&amp;L.</strong> Most stores under 250 orders/month run the complete stack free indefinitely.`,
  },
  {
    q: "Can Tidio replace Gorgias for Shopify customer support?",
    a: `Yes. Tidio says Lyro resolves 67% of conversations instantly (<a href="https://www.tidio.com/" target="_blank" rel="noopener">tidio.com</a>). Lyro handles order status, shipping and product FAQs without human intervention. Gorgias costs $10+/month for its helpdesk alone, $40/month with its AI Agent. Tidio's permanently functional free tier includes 50 one-time Lyro AI conversations. Setup takes 30 minutes.`,
  },
  
  {
    q: "How do I track Shopify profit and loss for free?",
    a: `A Make.com webhook auto-populates revenue, COGS, Shopify transaction fees, and net profit into a Google Sheet for every order within 60 seconds of purchase. <strong>Paid P&amp;L apps charge $35–$299/month, from TrueProfit's Basic plan to Lifetimely's L plan.</strong> If CAPI Shield or Stocky Swap is already deployed, this adds a single branch to your existing scenario: setup takes under 3 minutes.`,
  },
  {
    q: "How do I fix iOS conversion tracking on Shopify in 2026?",
    a: `iOS updates since 2021 have cumulatively broken browser-based conversion tracking. The fix is server-side tracking via Conversions API: purchase events sent server-to-server bypass iOS restrictions entirely. <strong>Switch your Shopify App Pixel to Always On mode (5 minutes), then implement CAPI Shield for server-side Meta coverage (about 6 minutes once your Make.com account and Meta access are in place).</strong> The full diagnosis guide covers each iOS change specifically: <a href="https://stackarchitect.xyz/blog/how-to-fix-shopify-conversion-tracking-after-ios-updates/">How to Fix Shopify Conversion Tracking After iOS Updates</a>.`,
  },
  {
    q: "Which Shopify apps are a waste of money in 2026?",
    a: `The most commonly overpaid-for apps: <strong>Elevar ($225/mo) and Triple Whale (GMV-based)</strong> for server-side tracking: replaced free by CAPI Shield. <strong>Zapier ($19.99+/mo)</strong> for automation: replaced free by Make.com with 10× more operations. <strong>Klaviyo ($20+/mo)</strong> for email under 2,000 contacts: replaced free by Systeme.io. <strong>BeProfit and TrueProfit ($35–$249/mo)</strong> for P&amp;L: replaced free by P&amp;L Auto. Full breakdown: <a href="https://stackarchitect.xyz/best-free-shopify-apps-2026/">Shopify Apps That Are a Waste of Money</a>.`,
  },
  {
    q: "How do I recover abandoned carts on Shopify for free?",
    a: `The free method uses Make.com and Systeme.io: no Shopify app required. Create a Shopify <code>checkouts/create</code> webhook pointing to a Make.com scenario. Make.com extracts the customer email and cart data, sends it to Systeme.io via API, and triggers a 3-email recovery sequence (1 hour, 24 hours, 72 hours) that stops automatically after purchase. <strong>Setup takes 30 minutes and costs $0/month.</strong> Full setup: <a href="https://stackarchitect.xyz/blog/shopify-abandoned-cart-recovery-free-2026/">Shopify Abandoned Cart Recovery Free 2026</a>.`,
  },
  {
    q: "How do I improve my Shopify conversion rate for free?",
    a: `<strong>Before any CRO work, verify your tracking is accurate</strong>: iOS restrictions and ad blockers hide real purchases, making conversion rates look artificially low. Fix this first with CAPI Shield (free, 6 minutes). Then: abandoned cart recovery via Make.com + Systeme.io, Tidio Lyro AI for live chat, Microsoft Clarity for session recordings, GA4 funnel analysis for drop-off diagnosis. All free. Full priority-order guide: <a href="https://stackarchitect.xyz/blog/shopify-conversion-rate-optimisation-free-2026/">Shopify CRO Free 2026: 12 Free Tools</a>.`,
  },
];
const stripHtml = (s: string) =>
  s.replace(/<[^>]+>/g, '').replace(/&ldquo;|&rdquo;/g, '"').replace(/&amp;/g, '&').replace(/\s+/g, ' ').trim();

// ── Schema.org structured data ──
const schemaItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Free Shopify Automation & AI Guides 2026",
  "description": `${GUIDE_COUNT} step-by-step guides covering every operational layer of a Shopify store. Server-side tracking, Meta ROAS recovery, Google Ads Enhanced Conversions, TikTok CAPI, AI customer support, Klaviyo replacement, email marketing, abandoned cart recovery, CRO, Make.com automation, inventory, P&L, and agentic storefronts.`,
  "url": CANONICAL,
  "numberOfItems": guides.length,
  // The name is the row title up to its first em dash: the visible title's
  // subtitle carries figures (the Lean Stack's monthly saving, for one) that
  // stay out of schema.
  "itemListElement": guides.map((g, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": g.title.split(' — ')[0],
    "url": `${SITE_URL}${g.href}`,
  })),
};

const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": stripHtml(f.a) },
  })),
};

const schemaBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Stack Architect", "item": SITE_URL },
    { "@type": "ListItem", "position": 2, "name": "Free Shopify Automation Guides 2026", "item": CANONICAL }
  ]
};

const schemaWebPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": seo.title,
  "description": seo.description,
  "url": CANONICAL,
  "author": { "@id": "https://stackarchitect.xyz/#org" },
  "publisher": { "@id": "https://stackarchitect.xyz/#org" },
  "dateModified": DATE_MODIFIED,
  "inLanguage": "en-GB",
  "isPartOf": { "@type": "WebSite", "url": SITE_URL, "name": "Stack Architect" }
};

const schemaSoftwareApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "CAPI Shield: Free Shopify Server-Side Tracking",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "description": "Free server-side CAPI tracking for Shopify. Replaces Elevar and Triple Whale at $0/month.",
  "url": `${SITE_URL}/capi-shield/`
};
import TableOfContents from '../components/TableOfContents.astro';

const tocHeadings = [
  {
    "id": "ai-heading",
    "text": "AI Tools &amp; Agentic Commerce: The Complete 2026 Picture"
  },
  {
    "id": "support-heading",
    "text": "AI Customer Support: Replace Gorgias Free with Tidio"
  },
  {
    "id": "tracking-heading",
    "text": "Ad Tracking: Fix Meta ROAS, Server-Side Setup, iOS Recovery"
  },
  {
    "id": "tiktok-heading",
    "text": "TikTok Events API: Free Server-Side Tracking for Shopify"
  },
  {
    "id": "inventory-heading",
    "text": "Inventory: Replace Stocky and Build a Free System That Scales"
  },
  {
    "id": "email-heading",
    "text": "Email Marketing: Replace Klaviyo at $0/Month, or Pay Less with GetResponse"
  },
  {
    "id": "profit-heading",
    "text": "Profit Reporting: Live P&amp;L in Google Sheets, Free"
  },
  {
    "id": "cro-heading",
    "text": "Conversion Rate Optimisation: 12 Free CRO Tools in Priority Order"
  },
  {
    "id": "make-heading",
    "text": "Make.com, App Costs &amp; The Free Stack: Complete Guide"
  },
  {
    "id": "workflow-heading",
    "text": "Workflow Stability: Build Automations That Don't Break at Scale"
  },
  {
    "id": "common-questions-about-shopify-automation-in-2026",
    "text": "Common Questions About Shopify Automation in 2026"
  },
  {
    "id": "related-guides-tools",
    "text": "Related guides & tools"
  }
];

---
<Base verifiedDate={READ_DATE} title={seo.title} description={seo.description}>
<Fragment slot="head">
<script type="application/ld+json" set:html={JSON.stringify(schemaWebPage)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaItemList)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaSoftwareApp)} />

  <!-- ── FONTS ── -->

  <!-- ── FAVICON ── -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  

  <!-- ── ANALYTICS ── -->
  
</Fragment>
<div id="top"></div>

<!-- ══════════════════════════════
     NAVIGATION
════════════════════════════════ -->

<!-- ══════════════════════════════
     MAIN
════════════════════════════════ -->
<main id="main-content">
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" style="max-width:1100px;margin:0 auto;padding:16px 24px 0;font-size:12px;color:var(--text-4);font-family:var(--mono);">
    <ol style="list-style:none;padding:0;margin:0;display:flex;gap:8px;flex-wrap:wrap;">
      <li><a href="https://stackarchitect.xyz" style="color:var(--text-4);text-decoration:none;">Stack Architect</a></li>
      <li aria-hidden="true" style="color:var(--border-2);">/</li>
      <li style="color:var(--g);" aria-current="page">Shopify Automation Guides 2026</li>
    </ol>
  </nav>

  <!-- ══ HERO ══ -->
  <section class="gp-hero">
    <span class="gp-hero-tag">Guide_Library · Automation + AI · Updated {UPDATED_LABEL}</span>
    <h1>
      Free Shopify Automation <em>&amp; AI</em> Guides (2026)
      <small>Fix Meta ROAS · Google Ads · Replace paid apps · AI tools, tracking, email, support, inventory: $0, no code</small>
    </h1>

    <p id="answer" class="gp-hero-sub">A free Shopify automation stack replaces paid apps at zero cost: Make.com webhooks for server-side Meta, Google and TikTok tracking, Systeme.io for email, Google Sheets for inventory and P&amp;L, and AI tools for support. <strong>These guides cover all ten categories: start anywhere.</strong></p>

  <TableOfContents headings={tocHeadings} />
    <div class="gp-stats" role="list" aria-label="Key statistics">
      <div class="gp-stat" role="listitem"><span class="gs-val">{GUIDE_COUNT}</span><span class="gs-label">Live guides</span></div>
      <div class="gp-stat" role="listitem"><span class="gs-val">$0</span><span class="gs-label">Monthly cost</span></div>
      <div class="gp-stat" role="listitem"><span class="gs-val">$0</span><span class="gs-label">Monthly cost</span></div>
      <div class="gp-stat" role="listitem"><span class="gs-val">$0</span><span class="gs-label">Cost to implement</span></div>
      <div class="gp-stat" role="listitem"><span class="gs-val">10</span><span class="gs-label">Topic clusters</span></div>
    </div>
