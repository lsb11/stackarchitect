          <thead><tr><th scope="col">A</th><th scope="col">B</th><th scope="col">C</th><th scope="col">D</th><th scope="col">E</th></tr></thead>
          <tbody>
            <tr><td class="bold">SKU</td><td class="bold">Product_Title</td><td class="bold">Location</td><td class="bold">Available_Qty</td><td class="bold">Last_Updated</td></tr>
