---
import Base from '../layouts/Base.astro';
import Disclosure from '../components/Disclosure.astro';
import AuthorCard from '../components/AuthorCard.astro';
import TableOfContents from '../components/TableOfContents.astro';
// src/pages/shopify-google-sheets-automation.astro
// Stack Architect — Shopify to Google Sheets Automation

const SITE = "https://stackarchitect.xyz";
const PAGE = `${SITE}/shopify-google-sheets-automation/`;
const DATE_PUBLISHED = "2026-07-23";
const DATE_MODIFIED = "2026-08-08";
const DATE_VERIFIED = "2026-08-08";

const AFF = {
  make: "/go/make/",
  workspace: "/go/workspace/",
};

const QUOTAS_GUIDE = "/blog/google-apps-script-quotas-explained-how-to-avoid-limits-and-scale-your-automations/";

// ── Structured data ──────────────────────────────────────────
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${PAGE}#webpage`,
      "url": PAGE,
      "name": "Shopify to Google Sheets Automation Free (2026) — Orders, Inventory & Sync",
      "description": "Free Shopify to Google Sheets automation via Make.com and Google Apps Script. Export orders, sync inventory levels, and choose real-time vs scheduled sync — with the exact scenario structure and where Apps Script and Sheets API quotas actually break.",
      "datePublished": DATE_PUBLISHED,
      "dateModified": DATE_MODIFIED,
      "inLanguage": "en-GB",
      "isPartOf": { "@id": `${SITE}/#website` },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE}/` },
          { "@type": "ListItem", "position": 2, "name": "Shopify to Google Sheets Automation", "item": PAGE }
        ]
      },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["#hero-headline", "#export-h", "#faq-h"]
      }
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      "url": SITE,
      "name": "Stack Architect",
      "description": "Free automation tools for Shopify operators — $0 stack replacing paid apps.",
      "publisher": { "@id": `${SITE}/#org` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${PAGE}#software`,
      "name": "Shopify to Google Sheets Sync",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "url": PAGE,
      "description": "Free Shopify order and inventory sync to Google Sheets via Make.com webhooks or Google Apps Script — no paid CSV export app required.",
      "featureList": [
        "Real-time order export via Shopify webhook",
        "Scheduled/batch sync for reconciliation",
        "Inventory level sync per SKU and location",
        "Make.com scenario with Iterator for multi-line-item orders",
        "Google Apps Script alternative with zero monthly cost",
        "Free via Make.com (1,000 credits/month)",
        "No code required",
        "Your data in your own Google account"
      ],
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
      "author": { "@id": `${SITE}/#org` },
      "isRelatedTo": [
        { "@type": "SoftwareApplication", "name": "Make.com", "url": "https://www.make.com" },
        { "@type": "SoftwareApplication", "name": "Google Sheets", "url": "https://sheets.google.com" },
        { "@type": "SoftwareApplication", "name": "Google Apps Script", "url": "https://script.google.com" },
        { "@type": "SoftwareApplication", "name": "Shopify", "url": "https://www.shopify.com" }
      ]
    },
    {
      "@type": ["Article", "TechArticle"],
      "@id": `${PAGE}#article`,
      "headline": "Shopify to Google Sheets Automation Free (2026) — Orders, Inventory & Sync Strategy",
      "description": "How to export Shopify orders and sync inventory to Google Sheets for free using Make.com and Google Apps Script — including when to use real-time webhooks vs scheduled sync, the actual Make.com scenario structure, where Apps Script quotas and Google Sheets API limits break, and when to outgrow Sheets entirely.",
      "author": { "@id": `${SITE}/#org` },
      "publisher": { "@id": `${SITE}/#org` },
      "datePublished": DATE_PUBLISHED,
      "dateModified": DATE_MODIFIED,
      "inLanguage": "en-GB",
      "url": PAGE,
      "wordCount": 3400,
      "timeRequired": "PT11M",
      "mainEntityOfPage": { "@id": `${PAGE}#webpage` },
      "about": [
        { "@type": "Thing", "name": "Google Sheets automation", "sameAs": "https://workspace.google.com/products/sheets/" },
        { "@type": "Thing", "name": "Make.com automation platform", "sameAs": "https://www.make.com" },
        { "@type": "Thing", "name": "Google Apps Script", "sameAs": "https://developers.google.com/apps-script" },
        { "@type": "Thing", "name": "Google Sheets API", "sameAs": "https://developers.google.com/workspace/sheets/api" }
      ],
      "mentions": [
        { "@type": "SoftwareApplication", "name": "Make.com" },
        { "@type": "SoftwareApplication", "name": "Google Sheets" },
        { "@type": "SoftwareApplication", "name": "Google Apps Script" },
        { "@type": "SoftwareApplication", "name": "Shopify" }
      ],
      "educationalLevel": "beginner",
      "proficiencyLevel": "Beginner"
    },
    {
      "@type": "HowTo",
      "@id": `${PAGE}#howto`,
      "name": "How to sync Shopify orders and inventory to Google Sheets for free",
      "description": "Build a free Shopify-to-Google-Sheets sync covering orders and inventory using Make.com webhooks. No code, deploys in about 15 minutes.",
      "totalTime": "PT15M",
      "estimatedCost": { "@type": "MonetaryAmount", "currency": "USD", "value": "0" },
      "tool": [
        { "@type": "HowToTool", "name": "Make.com (free tier)" },
        { "@type": "HowToTool", "name": "Google Sheets" },
        { "@type": "HowToTool", "name": "Shopify Webhooks" }
      ],
      "step": [
        { "@type": "HowToStep", "position": 1, "name": "Create your Google Sheet",
          "text": "Create a Google Sheet with two tabs: Orders and Inventory. In Orders add columns: Order_ID, Date, Customer_Email, SKU, Product_Title, Quantity, Line_Price, Order_Total, Fulfilment_Status. In Inventory add: SKU, Product_Title, Location, Available_Qty, Last_Updated." },
        { "@type": "HowToStep", "position": 2, "name": "Activate Make.com free",
          "text": "Sign up for Make.com free tier — 1,000 credits/month at no cost. Create a new scenario with a Webhooks module as the trigger.", "url": AFF.make },
        { "@type": "HowToStep", "position": 3, "name": "Add the Shopify order payment webhook",
          "text": "In Shopify Admin go to Settings → Notifications → Webhooks. Create a webhook for Order payment pointing at your Make.com webhook URL, format JSON." },
        { "@type": "HowToStep", "position": 4, "name": "Add an Iterator and write order rows",
          "text": "Add an Iterator module on order.line_items so multi-item orders write one row per SKU, not one row per order. Add a Google Sheets — Add a Row module after it, mapped to your Orders tab." },
        { "@type": "HowToStep", "position": 5, "name": "Add the inventory levels webhook",
          "text": "Create a second Shopify webhook for Inventory levels update. Build a second Make.com scenario that uses Google Sheets — Update a Row (Search Column) keyed on SKU + Location, so each SKU has one live row instead of an endless append log." },
        { "@type": "HowToStep", "position": 6, "name": "Test and verify both scenarios",
          "text": "Place a test order with two different products and confirm two rows land in Orders. Adjust stock on one variant in Shopify Admin and confirm the matching Inventory row updates in place rather than duplicating." }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${PAGE}#faq`,
      "mainEntity": [
        { "@type": "Question", "name": "Can I export Shopify orders to Google Sheets for free?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. A Shopify Order payment webhook connected to a Make.com scenario writes every order to a Google Sheet automatically, free on Make.com's tier covering 1,000 credits/month. Google Apps Script is a second free route that runs entirely inside the Sheet itself with no external tool, at the cost of the quota limits Apps Script imposes at higher volume." } },
        { "@type": "Question", "name": "Should I use real-time webhooks or a scheduled sync for Shopify to Sheets?",
          "acceptedAnswer": { "@type": "Answer", "text": "Use real-time webhooks for anything where staleness has a cost — inventory levels, live P&L, fulfilment dashboards. Use a scheduled pull for bulk backfills, low-urgency reporting, and as a reconciliation safety net, since Shopify webhook delivery is not guaranteed and a periodic catch-up pass catches anything a webhook missed. Most reliable setups run both: webhooks for speed, a daily scheduled reconciliation for correctness." } },
        { "@type": "Question", "name": "How do I sync Shopify inventory levels to Google Sheets?",
          "acceptedAnswer": { "@type": "Answer", "text": "Subscribe to the Shopify Inventory levels update webhook, which fires per SKU per location — a single multi-item order can trigger several separate inventory events, not one. The payload contains inventory_item_id and location_id, not the product title, so you need a mapping step (via the Shopify API or a lookup tab) to resolve those IDs to a readable SKU. Write with an update-in-place module keyed on SKU + location rather than appending, or the sheet fills with duplicate rows instead of current stock levels." } },
        { "@type": "Question", "name": "Why does my Google Apps Script Shopify sync stop working at volume?",
          "acceptedAnswer": { "@type": "Answer", "text": "Apps Script cap depends on which sync method you use. A webhook-triggered doPost() web app hits the 30-concurrent-execution ceiling and Sheets service call rate limits first, surfacing as 'Service invoked too many times' during order bursts. A time-driven scheduled pull instead runs into the 90-minute daily trigger runtime cap on consumer accounts once order volume grows. Neither limit can be raised by upgrading — see the full breakdown in the Google Apps Script quotas guide." } },
        { "@type": "Question", "name": "Does Make.com also have rate limits when writing to Google Sheets?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Make.com writes through the Google Sheets API, which enforces its own quota independent of Apps Script: 300 read requests and 300 write requests per minute per project, with a 60-per-minute cap per user, and no daily limit, per Google's published Sheets API usage limits. A single high-volume order burst is unlikely to hit this on a typical store, but a scenario writing one row per line item on large multi-item orders, or an Iterator misconfigured to fire far more calls than expected, can." } },
        { "@type": "Question", "name": "What is the actual Make.com scenario structure for syncing Shopify to Sheets?",
          "acceptedAnswer": { "@type": "Answer", "text": "One scenario per webhook topic. Orders: Webhooks trigger → Iterator over line_items → Google Sheets Add a Row per item, mapped to an Orders tab. Inventory: a separate Webhooks trigger on Inventory levels update → Google Sheets Update a Row (Search Column) keyed on SKU and location, so stock stays a single current row instead of an endless log. Both scenarios share the same Google Sheets connection but write to different tabs with different write patterns — append for orders, update-in-place for inventory." } },
        { "@type": "Question", "name": "How many Shopify orders can Google Sheets handle before I need a database?",
          "acceptedAnswer": { "@type": "Answer", "text": "Google Sheets caps a spreadsheet at 10 million cells total across all tabs (a beta doubling this to 20 million was announced in April 2026). For a 9-column Orders tab that's roughly 1.1 million rows before hitting the ceiling, but formula recalculation across SUMIF and VLOOKUP ranges slows well before that — most operators notice lag in the low hundreds of thousands of rows. At that point BigQuery, a hosted Postgres/Airtable base, or a purpose-built reporting layer replaces Sheets as the system of record, with Sheets kept only as a lightweight view on top." } },
        { "@type": "Question", "name": "Do I need Google Workspace for Shopify to Google Sheets automation?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. Free Gmail accounts work for most stores. Google Workspace raises the daily Apps Script trigger-runtime ceiling from 90 minutes to 6 hours and UrlFetch calls from 20,000 to 100,000 per day — relevant only if you're running the Apps Script route at high volume, not the Google Sheets API limits Make.com uses, which are the same regardless of account type." } }
      ]
    }
  ]
});

const tocHeadings = [
  { "id": "export-h", "text": "Exporting Shopify orders to Google Sheets" },
  { "id": "sync-h", "text": "Real-time vs scheduled sync — and when each is appropriate" },
  { "id": "inventory-h", "text": "Syncing inventory levels to Sheets" },
  { "id": "quotas-h", "text": "Why Apps Script hits quota walls at volume" },
  { "id": "sheets-limits-h", "text": "Google Sheets API limits you'll hit even with Make.com" },
  { "id": "make-h", "text": "The Make.com approach — the actual scenario structure" },
  { "id": "structure-h", "text": "The Google Sheet structure to build" },
  { "id": "setup-h", "text": "Deploy it — step by step" },
  { "id": "outgrown-h", "text": "When you've outgrown Sheets entirely" },
  { "id": "faq-h", "text": "Frequently asked questions" },
  { "id": "related-h", "text": "Related guides" }
];
---
<Base title="Shopify to Google Sheets — Orders &amp; Inventory Free 2026" description="Export Shopify orders and sync inventory to Google Sheets free via Make.com or Apps Script — real-time vs scheduled, and where the quotas break." verifiedDate={DATE_VERIFIED}>
<Fragment slot="head">
<script type="application/ld+json" set:html={schema} />

  <link rel="dns-prefetch" href="https://www.make.com" />

  <style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;}
body{overflow-x:hidden;}
::selection{background:rgba(52,211,119,.2);color:#f2f5f3;}
::-webkit-scrollbar{width:4px;}
::-webkit-scrollbar-track{background:#0c0f0d;}
::-webkit-scrollbar-thumb{background:rgba(52,211,119,.3);border-radius:2px;}
:root{
  --g:#34d377;--g-dim:#15803d;--g-bg:rgba(52,211,119,.08);--g-border:rgba(52,211,119,.2);
  --bg:#0c0f0d;--bg-2:#0f1311;--bg-3:#121614;--bg-4:#171c19;
  --border:#222825;--border-2:#2f3733;
  --text:#f2f5f3;--text-2:#b6c0ba;--text-3:#93a09a;--text-4:#93a09a;--text-inv:#0c0f0d;
  --red:#f08a8a;--red-bg:rgba(240,138,138,.07);--red-border:rgba(240,138,138,.18);
  --sky:#8ccfe8;--sky-bg:rgba(140,207,232,.07);--sky-border:rgba(140,207,232,.18);
  --vio:#c3b8ef;--vio-bg:rgba(195,184,239,.07);--vio-border:rgba(195,184,239,.18);
  --amber:#f5b64d;
  --mono:'JetBrains Mono',monospace;
  --sans:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
}
html,body{font-family:var(--sans);background:var(--bg);color:var(--text-3);line-height:1.75;-webkit-font-smoothing:antialiased;}
.tag{display:inline-flex;align-items:center;gap:6px;font-family:var(--mono);font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:5px 12px;border-radius:3px;background:var(--g-bg);border:1px solid var(--g-border);color:var(--g);}
.tag-dim{background:rgba(255,255,255,.03);border-color:var(--border-2);color:var(--text-4);}
.tag-sky{background:var(--sky-bg);border-color:var(--sky-border);color:var(--sky);}
.tag-vio{background:var(--vio-bg);border-color:var(--vio-border);color:var(--vio);}
.tag-amber{background:rgba(245,182,77,.08);border-color:rgba(245,182,77,.2);color:var(--amber);}
.dot{display:inline-block;width:7px;height:7px;min-width:7px;border-radius:50%;background:var(--g);animation:dotPing 2.2s cubic-bezier(.4,0,.6,1) infinite;}
@keyframes dotPing{0%{box-shadow:0 0 0 0 rgba(52,211,119,.5);}70%{box-shadow:0 0 0 8px rgba(52,211,119,0);}100%{box-shadow:0 0 0 0 rgba(52,211,119,0);}}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;font-family:var(--sans);font-size:16px;font-weight:700;text-decoration:none;letter-spacing:-.01em;padding:16px 32px;border-radius:6px;border:none;cursor:pointer;white-space:nowrap;background:var(--g);color:var(--text-inv);transition:background .2s,transform .15s,box-shadow .2s;min-height:52px;}
.btn:hover{background:#45e28a;transform:translateY(-2px);box-shadow:0 8px 28px rgba(52,211,119,.3);}
.btn.pulse{animation:btnGlow 2.8s ease-in-out infinite;}
@keyframes btnGlow{0%,100%{box-shadow:0 0 16px rgba(52,211,119,.1);}50%{box-shadow:0 0 28px rgba(52,211,119,.28);}}
.btn.pulse:hover{animation:none;}
.btn-sm{font-size:14px;padding:12px 22px;min-height:44px;}
.btn-outline{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--sans);font-size:15px;font-weight:600;text-decoration:none;letter-spacing:-.01em;padding:15px 28px;border-radius:6px;border:1.5px solid var(--border-2);cursor:pointer;white-space:nowrap;background:transparent;color:var(--text-2);transition:border-color .2s,color .2s,background .2s;min-height:52px;}
.btn-outline:hover{border-color:var(--g);color:var(--g);background:var(--g-bg);}
.section{padding:100px 24px;}.section-alt{padding:100px 24px;background:var(--bg-2);border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
.inner{max-width:1000px;margin:0 auto;}.inner-sm{max-width:720px;margin:0 auto;}.inner-md{max-width:860px;margin:0 auto;}
.sec-head{text-align:center;margin-bottom:56px;}
.sec-head h2{font-family:var(--sans);font-weight:700;font-size:clamp(24px,4vw,38px);letter-spacing:-.03em;color:var(--text);line-height:1.1;margin-bottom:10px;}
.sec-head p{font-size:15px;color:var(--text-3);max-width:520px;margin:14px auto 0;line-height:1.75;}
.bg-grid{background-color:var(--bg);background-image:radial-gradient(ellipse 80% 40% at 50% 0%,rgba(52,211,119,.06) 0%,transparent 60%),radial-gradient(circle,var(--border) 1px,transparent 1px);background-size:100% 100%,44px 44px;}
.stat-strip{display:grid;grid-template-columns:repeat(4,1fr);background:var(--border);gap:1px;border:1px solid var(--border);border-radius:8px;overflow:hidden;}
.stat-cell{background:var(--bg);padding:20px 12px;text-align:center;}
.stat-v{font-family:var(--mono);font-size:20px;font-weight:700;color:var(--g);line-height:1;}
.stat-l{font-size:11px;color:var(--text-4);text-transform:uppercase;letter-spacing:.1em;margin-top:6px;font-family:var(--mono);}
.divider{height:1px;background:var(--border);margin:0;}
.hero{padding:96px 24px 80px;text-align:center;position:relative;overflow:hidden;}
.hero-inner{max-width:900px;margin:0 auto;position:relative;}
.hero-proof{display:inline-flex;align-items:center;gap:12px;background:rgba(255,255,255,.04);border:1px solid var(--border-2);border-radius:100px;padding:9px 22px;margin-bottom:36px;flex-wrap:wrap;justify-content:center;}
.hero-proof-txt{font-family:var(--mono);font-size:11px;color:var(--text-4);letter-spacing:.08em;}
.hero h1{font-size:clamp(34px,6vw,64px);font-weight:700;color:var(--text);line-height:1.02;letter-spacing:-.04em;margin:0 auto 22px;max-width:820px;}
.hero h1 .green{color:var(--g);}
.hero h1 .dim{color:var(--text-4);}
.hero-sub{font-size:clamp(15px,2vw,18px);color:var(--text-3);max-width:600px;margin:0 auto 30px;line-height:1.7;}
.hero-sub strong{color:var(--text-2);font-weight:600;}
.trust-row{display:flex;flex-wrap:wrap;justify-content:center;gap:22px;margin-bottom:36px;}
.trust-item{display:flex;align-items:center;gap:7px;font-size:13px;color:var(--text-3);}
.hero-ctas{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:14px;margin-bottom:14px;}
.hero-cta-note{font-size:13px;color:var(--text-4);line-height:1.6;}
.hero-cta-note a{color:rgba(52,211,119,.7);text-decoration:underline;}
.expert-byline{display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.025);border:1px solid var(--border);border-radius:8px;padding:12px 18px;max-width:fit-content;margin:0 auto 20px;}
.expert-byline span{font-family:var(--mono);font-size:10px;color:var(--text-4);letter-spacing:.08em;}
.expert-byline strong{color:var(--text-3);}
.sheet-preview{background:#0a0e1a;border:1px solid var(--border-2);border-radius:12px;overflow:hidden;margin:20px 0;}
.sheet-header{background:rgba(255,255,255,.03);border-bottom:1px solid var(--border);padding:10px 16px;display:flex;align-items:center;gap:10px;}
.sheet-tab{font-family:var(--mono);font-size:11px;padding:5px 14px;border-radius:4px 4px 0 0;cursor:default;}
.sheet-tab.active{background:var(--bg-3);color:var(--g);border:1px solid var(--border-2);border-bottom:1px solid var(--bg-3);margin-bottom:-1px;}
.sheet-tab.inactive{color:var(--text-4);}
.sheet-table{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:12px;}
.sheet-table th{background:rgba(255,255,255,.04);color:var(--text-4);padding:8px 12px;text-align:left;border-bottom:1px solid var(--border);border-right:1px solid var(--border);font-weight:700;letter-spacing:.08em;font-size:10px;text-transform:uppercase;white-space:nowrap;}
.sheet-table td{padding:8px 12px;border-bottom:1px solid rgba(255,255,255,.03);border-right:1px solid rgba(255,255,255,.02);color:var(--text-3);white-space:nowrap;}
.sheet-table td.green{color:var(--g);}
.sheet-table td.formula{color:var(--sky);font-style:italic;}
.sheet-table td.bold{color:var(--text);font-weight:700;}
.sheet-table tr:last-child td{border-bottom:none;}
.flow-grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:32px;}
.flow-step{background:var(--bg);padding:30px 24px;}
.flow-num{font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.18em;color:var(--g);margin-bottom:14px;text-transform:uppercase;}
.flow-title{font-weight:700;font-size:15px;color:var(--text);margin-bottom:8px;line-height:1.3;}
.flow-desc{font-size:13px;color:var(--text-3);line-height:1.65;}
.flow-tool{font-family:var(--mono);font-size:10px;color:var(--text-4);background:rgba(255,255,255,.03);border:1px solid var(--border);padding:3px 8px;border-radius:3px;display:inline-block;margin-top:10px;}
@media(max-width:700px){.flow-grid-3{grid-template-columns:1fr;}}
.step-cards{display:flex;flex-direction:column;gap:12px;margin:20px 0;}
.step-card{background:var(--bg-3);border:1px solid var(--border);border-radius:10px;padding:20px 20px 20px 24px;display:flex;gap:16px;align-items:flex-start;}
.step-num{width:28px;height:28px;min-width:28px;border-radius:50%;background:rgba(52,211,119,.1);border:1px solid rgba(52,211,119,.25);display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:11px;font-weight:700;color:var(--g);flex-shrink:0;}
.step-title{font-size:15px;font-weight:700;color:var(--text);margin-bottom:4px;line-height:1.3;}
.step-desc{font-size:13px;color:var(--text-3);line-height:1.65;}
.step-tool{font-family:var(--mono);font-size:10px;color:var(--text-4);background:rgba(255,255,255,.03);border:1px solid var(--border);padding:3px 8px;border-radius:3px;display:inline-block;margin-top:7px;}
.callout{background:var(--bg-3);border:1px solid var(--border-2);border-radius:10px;padding:22px 22px 22px 26px;margin:24px 0;border-left:3px solid var(--g);text-align:left;}
.callout.warn{border-left-color:var(--amber);background:rgba(245,182,77,.04);}
