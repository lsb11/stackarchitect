---
import Base from '../layouts/Base.astro';
import AuthorCard from '../components/AuthorCard.astro';
/**
 * src/pages/shopify-ios-attribution-gap-benchmark.astro
 * stackarchitect.xyz/shopify-ios-attribution-gap-benchmark
 *
 * Intent: ORIGINAL CITABLE DATA — the highest-SEO-leverage asset.
 * A maintained benchmark synthesising published research on how much Shopify
 * purchase-conversion signal is lost to iOS / ATT / ITP, expressed as one
 * quotable headline statistic with a transparent methodology and linked sources.
 * Designed to earn backlinks: journalists/bloggers cite the number, link the page.
 *
 * Honesty principles (non-negotiable for credibility):
 *  - Every figure is attributed to a named, dated, linked third-party source.
 *  - The synthesised "Stack Architect Index" is labelled as a synthesis of those
 *    sources, NOT presented as proprietary primary data.
 *  - A contribution form gathers real store data so the page can become
 *    genuinely original over time ("based on N stores") — clearly future-tense
 *    until enough is collected.
 *  - Schema: Dataset + Article + FAQPage for citability and rich results.
 */

const SITE       = "https://stackarchitect.xyz";
const CANONICAL  = `${SITE}/shopify-ios-attribution-gap-benchmark/`;
const OG         = `${SITE}/og.png`;
const datePublished = "2026-06-13";
const dateModified  = "2026-07-02";
const verified      = "2 July 2026";
const lastReviewISO = "2026-07-02";

// ── No headline range lives here any more. ──
// This page used to publish a synthesised 20–40% (rising to 50% on
// mobile-heavy stores). It was withdrawn on 4 September 2026: no row in the
// evidence table measured that quantity, and rows 2 and 5 establish that the
// loss is set by a store's own mobile/iOS traffic mix and consent rate, so a
// single industry range is the wrong shape of answer however well sourced.
// The mechanism and every sourced input survive; only the magnitude is gone.
// Do not reinstate a constant here. A first-party figure arrives from
// /api/gap-stats once N >= 10 approved submissions exist to compute one from.

import { dataPoints } from '../data/attributionGap.js';

// ── Contribution form fields (collected to build original data over time) ──
const platforms = ["Meta", "Google", "TikTok", "More than one"];

const faqs = [
  {
    q: "What is the iOS attribution gap for Shopify stores?",
    a: `The iOS attribution gap is the share of real purchases that ad platforms like Meta, Google and TikTok fail to attribute because Apple's App Tracking Transparency (ATT) and Safari Intelligent Tracking Prevention (ITP) block the browser signals those platforms rely on. Its size is store-specific: it is set by how much of your traffic is mobile and iOS, and how many of those visitors decline tracking. This page publishes the sourced figures behind the mechanism, and a calculator that turns two numbers from your own dashboards into your own gap.`
  },
  {
    q: "How is the Stack Architect Attribution Gap Index calculated?",
    a: "It is a transparent synthesis of published third-party figures — ATT opt-out rates (~75% at the 2021 launch, ~50% by 2024–25), the mobile share of Shopify traffic (74–78%), Safari ITP's 7-day cap on script-writable first-party cookies, and documented conversion-loss case data (~40% without CAPI). We do not present this as proprietary primary data; every input is named, dated and linked in the methodology. The index no longer resolves those inputs into a single headline percentage — that synthesis was withdrawn in September 2026, because none of the inputs measures it and two of them show the quantity is store-specific. What the inputs bound is the mechanism, not a number. A first-party figure is published here once enough real store submissions accumulate to compute one."
  },
  {
    q: "Why does server-side tracking (CAPI) close the gap?",
    a: "Server-side tracking sends the purchase event from the store's server directly to the ad platform's Conversions API — bypassing the browser entirely, so iOS and ad blockers cannot strip it. With hashed first-party data (email, phone) attached, the platform can still match the sale to the click even when the device identifier is gone. This is why brands with clean CAPI pipelines materially out-recover those relying on browser pixels alone."
  },
  {
    q: "Can I cite this benchmark?",
    a: `Yes. This page is maintained and dated specifically so it can be cited. Use the suggested attribution in the "Citing this data" section, and link to ${CANONICAL}. If you represent a publication and want the underlying source list, every figure is linked in the methodology table.`
  }
];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Dataset",
      "name": "Shopify iOS Attribution Gap Benchmark",
      "description": "A maintained set of sourced, dated figures on how iOS ATT and Safari ITP remove Shopify purchase-conversion signal, and on what determines the size of the loss for an individual store. Every row is attributed to a named third-party source. No synthesised headline percentage is published.",
      "url": CANONICAL,
      "keywords": ["iOS attribution gap","Shopify conversion tracking","ATT","App Tracking Transparency","Safari ITP","Meta CAPI","Conversions API","server-side tracking","Enhanced Conversions","ecommerce measurement"],
      "creator": { "@id": "https://stackarchitect.xyz/#luke" },
      "publisher": { "@id": "https://stackarchitect.xyz/#org" },
      "maintainer": { "@id": "https://stackarchitect.xyz/#luke" },
      // ── Properties below are the ones Google Dataset Search actually reads.
      // Dataset Search is a separate index from web search with its own,
      // considerably lower, inclusion bar. Marking this up completely is the
      // one route to Google surfacing this page that does not depend on
      // domain-level trust.
      "identifier": CANONICAL,
      "version": dateModified,
      "creativeWorkStatus": "Maintained",
      "temporalCoverage": `${datePublished.slice(0,4) && "2021-04"}/${dateModified}`,
      "spatialCoverage": { "@type": "Place", "name": "Worldwide" },
      "measurementTechnique": "Structured synthesis of published third-party measurements. Each input figure is attributed to a named, dated and linked primary source; no proprietary primary data is claimed. Methodology is published in full on the page.",
      "includedInDataCatalog": {
        "@type": "DataCatalog",
        "name": "Stack Architect Benchmarks",
        "url": `${SITE}/shopify-ios-attribution-gap-benchmark/`
      },
      // One PropertyValue per row of the published table, generated from the
      // same array that renders the table and the CSV/JSON downloads, so the
      // markup can never drift from the data.
      "variableMeasured": dataPoints.map(d => ({
        "@type": "PropertyValue",
        "name": d.metric,
        "value": d.value,
        "description": d.detail
      })),
      "isBasedOn": dataPoints.map(d => ({
        "@type": "CreativeWork",
        "name": d.source,
        "url": d.sourceUrl
      })),
      "citation": [
        { "@type": "CreativeWork", "name": "Meta — Conversions API documentation", "url": "https://developers.facebook.com/docs/marketing-api/conversions-api" },
        { "@type": "CreativeWork", "name": "WebKit — Tracking Prevention", "url": "https://webkit.org/tracking-prevention/" },
        { "@type": "CreativeWork", "name": "Apple — App Tracking Transparency", "url": "https://developer.apple.com/documentation/apptrackingtransparency" }
      ],
      "dateModified": dateModified,
      "datePublished": datePublished,
      "isAccessibleForFree": true,
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "distribution": [
        {
          "@type": "DataDownload",
          "name": "Shopify iOS Attribution Gap Benchmark (CSV)",
          "description": "All benchmark rows with metric, value, detail, source name, source URL and source date.",
          "encodingFormat": "text/csv",
          "contentUrl": `${SITE}/downloads/ios-attribution-gap-benchmark.csv`
        },
        {
          "@type": "DataDownload",
          "name": "Shopify iOS Attribution Gap Benchmark (JSON)",
          "description": "Machine-readable form of the same benchmark rows, including licence and methodology metadata.",
          "encodingFormat": "application/json",
          "contentUrl": `${SITE}/downloads/ios-attribution-gap-benchmark.json`
        }
      ]
    },
    {
      "@type": "Article",
      "@id": `${CANONICAL}#article`,
      "headline": "Shopify iOS Attribution Gap Benchmark 2026",
      "description": "How iOS ATT and Safari ITP remove Shopify purchase-conversion signal, what determines the size of the loss for any one store, and the sourced figures behind it — updated and dated.",
      "author":    { "@id": "https://stackarchitect.xyz/#luke" },
      "publisher": { "@id": "https://stackarchitect.xyz/#org" },
      "datePublished": datePublished,
      "dateModified": dateModified,
      "inLanguage": "en-GB",
      "url": CANONICAL,
      "image": OG
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE },
        { "@type": "ListItem", "position": 2, "name": "iOS Attribution Gap Benchmark", "item": CANONICAL }
      ]
    }
  ]
};
import TableOfContents from '../components/TableOfContents.astro';

const tocHeadings = [
  {
    "id": "data-h",
    "text": "What the published research actually shows"
  },
  {
    "id": "index-h",
    "text": "The Stack Architect Attribution Gap Index"
  },
  {
    "id": "method-h",
    "text": "How this benchmark is built and maintained"
  },
  {
    "id": "contrib-h",
    "text": "Contribute your store's gap"
  },
  {
    "id": "cite-h",
    "text": "Cite this benchmark"
  },
  {
    "id": "faq-h",
    "text": "Common questions"
  },
  {
    "id": "close-the-gap-free",
    "text": "Close the gap \u2014 free"
  },
  {
    "id": "related-reading",
    "text": "Related reading"
  },
  {
    "id": "embed-this-live-benchmark",
    "text": "Embed this live benchmark"
  }
];

---
<Base title="Shopify iOS Attribution Gap Benchmark 2026" description="Sourced benchmark of how much purchase-conversion signal Shopify stores lose to iOS ATT and Safari ITP. CC BY 4.0, with machine-readable JSON and CSV.">
<Fragment slot="head">
<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  
<script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "WebSite", "@id": "https://stackarchitect.xyz/#website", "url": "https://stackarchitect.xyz/", "name": "Stack Architect", "description": "Free Shopify automation tools replacing $700+/month of paid apps \u2014 server-side tracking, inventory, email, TikTok Events API, P&L.", "publisher": {"@id": "https://stackarchitect.xyz/#org"}, "inLanguage": "en-GB"})} />
  </Fragment>



<nav aria-label="Breadcrumb" style="background:var(--bg-2);border-bottom:1px solid var(--border);padding:10px 24px;">
  <div style="max-width:1100px;margin:0 auto;">
    <ol style="display:flex;align-items:center;gap:8px;list-style:none;font-family:var(--mono);font-size:10px;color:var(--text-4);text-transform:uppercase;letter-spacing:.08em;">
      <li><a href={SITE} style="color:var(--text-4);text-decoration:none;">Home</a></li>
      <li style="opacity:.4;">/</li>
      <li><span style="color:var(--g);">iOS Attribution Gap Benchmark</span></li>
    </ol>
  </div>
</nav>

<main id="main-content">

<!-- HERO -->
<section class="hero bg-grid" aria-label="Shopify iOS attribution gap benchmark">
  <div class="hero-inner">
    <div class="hero-proof">
      <span class="dot"></span>
      <span class="hero-proof-txt">Maintained benchmark · Last verified {verified} · Every figure sourced</span>
    </div>

    <h1>
      The iOS attribution gap is<br />
      <span class="big-stat">yours</span><br />
      <span class="dim">to measure — not ours to average.</span>
    </h1>

    <p id="answer">This benchmark documents how iOS App Tracking Transparency and Safari ITP remove purchase-conversion signal from Shopify stores, and what determines the size of that loss for any one store. It publishes the sourced third-party figures behind the mechanism rather than a single headline percentage, released under CC BY 4.0 with machine-readable JSON and CSV.</p>

  <TableOfContents headings={tocHeadings} />


    <p class="hero-sub">
      Apple's App Tracking Transparency and Safari ITP block the browser signals Meta, Google and TikTok depend on.
      <strong>How much any one store loses is set by its own mobile/iOS traffic mix and its own consent rate</strong> — which is why this page publishes the sourced evidence and a way to measure your store, rather than an industry average that describes nobody.
      Below: the sources, the method, and how to close the gap.
    </p>

    <div class="hero-ctas">
      <a href="#data" class="btn-outline" onclick="event.preventDefault();document.getElementById('data').scrollIntoView({behavior:'smooth'})">See the data</a>
      <a href="#contribute" class="btn pulse" onclick="event.preventDefault();document.getElementById('contribute').scrollIntoView({behavior:'smooth'})">Contribute your store's gap →</a>
    </div>
    <p class="hero-cta-note">Free to read and cite (CC BY 4.0). The fix is documented at <a href="/capi-shield/">CAPI Shield</a>.</p>
  </div>
</section>

<!-- HEADLINE STAT STRIP -->
<div style="background:var(--bg-2);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:0 24px;">
  <div class="stat-strip" style="max-width:860px;margin:0 auto;" role="list">
    <div class="stat-cell" role="listitem"><div class="stat-v">~75%</div><div class="stat-l">iOS tracking opt-out, 2021 ATT launch (~50% by 2024–25)</div></div>
    <div class="stat-cell" role="listitem"><div class="stat-v">7 days</div><div class="stat-l">Safari ITP cookie cap</div></div>
    <div class="stat-cell" role="listitem"><div class="stat-v">74–78%</div><div class="stat-l">Shopify traffic is mobile</div></div>
    <div class="stat-cell" role="listitem"><div class="stat-v">~$10B</div><div class="stat-l">Meta's own estimated 2022 ATT revenue hit</div></div>
  </div>
</div>

<!-- THE DATA -->
<section class="section" id="data" aria-labelledby="data-h">
  <div class="inner">
    <div class="sec-head">
      <span class="tag tag-dim" style="margin-bottom:14px;display:inline-flex;">the evidence · verified {verified}</span>
      <h2 id="data-h">What the published research actually shows</h2>
      <p>The {dataPoints.length} figures below are load-bearing: each comes from a named, dated, linked source. Together they bound the size of the gap.</p>
    </div>

    <div style="display:flex;flex-direction:column;gap:14px;">
      {dataPoints.map(d => (
        <div style="border:1px solid var(--border);border-radius:12px;background:var(--bg-2);padding:22px 24px;">
          <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:8px;">
            <div style="font-size:15px;font-weight:700;color:var(--text);">{d.metric}</div>
            <div style="font-family:var(--mono);font-size:22px;font-weight:800;color:var(--g);white-space:nowrap;">{d.value}</div>
          </div>
          <p style="font-size:14px;color:var(--text-3);line-height:1.7;margin:0 0 12px;">{d.detail}</p>
          <a href={d.sourceUrl} target="_blank" rel="noopener nofollow" style="font-family:var(--mono);font-size:11px;color:var(--text-4);text-decoration:none;">
            Source: {d.source} · {d.sourceDate} ↗
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<div class="divider"></div>

<!-- THE SYNTHESIS -->
<section class="section-alt" id="index" aria-labelledby="index-h">
  <div class="inner-md">
    <div class="sec-head">
      <span class="tag tag-dim" style="margin-bottom:14px;display:inline-flex;">the synthesis</span>
      <h2 id="index-h">The Stack Architect Attribution Gap Index</h2>
    </div>
    <div class="body-text">
      <p>No single published source states "the Shopify attribution gap is X%." This page used to answer that by synthesising one — a 20–40% range, rising to 50% on mobile-heavy stores, triangulated from the figures above. <strong>That range was withdrawn on 4 September 2026.</strong> It is documented below rather than quietly removed, because it was cited from here.</p>
      <p>The inputs themselves are unchanged and still stand. Mobile is <strong>74–78% of Shopify traffic</strong>, a large share of it iOS; ATT removed app-tracking consent for most of those users at launch (<strong>~75%</strong> opt-out in 2021, easing to roughly <strong>50%</strong> by 2024–25); and Safari ITP independently caps script-writable first-party cookies at <strong>7 days</strong>, degrading browser attribution regardless of ATT consent. Documented store-level cases land near <strong>40% conversion loss without CAPI</strong>.</p>
      <p>What that set of figures establishes is a <em>mechanism</em> and its <em>drivers</em> — not a magnitude. Two of the five rows are store variables rather than constants: the mobile/iOS share of your traffic, and the rate at which those visitors decline tracking. A store at the top of the mobile range with a high refusal rate and a store at the bottom with a low one do not share a number, and the average of the two describes neither. Only one row was even denominated in the retracted quantity — a single documented case, reported at second hand — and nothing in the evidence table derives the lower bound of 20% at all. So the range is gone rather than re-derived, and the sourced rows it was built from remain above, individually citable.</p>
      <p style="font-size:13px;color:var(--text-4);"><strong>Revision, 3 September 2026.</strong> An earlier version of this table carried a sixth row citing a 30–40% reduction in Meta attribution accuracy, attributed to an AI answer library. That source does not meet the standard set out in <a href="/how-we-test/" style="color:var(--g);text-decoration:underline;">how we test</a>, which excludes AI-generated statistics, and we could not locate a primary source for the figure. The row has been removed. It was one of the inputs behind the headline range, and narrowing that evidence base is part of what led to the range being withdrawn outright a day later.</p>
      <div class="big-callout">
        <div class="big-callout-num">Yours</div>
        <div class="big-callout-body">
          <p>The only gap figure worth acting on is your store's, and it is <strong>two numbers you already have</strong>: conversions your ad platform reported last month, against paid orders Shopify recorded for the same period. <a href="#contribute">Work it out below</a> — you get the result immediately, and submitting it anonymously is what will let this page publish a first-party figure.</p>
        </div>
      </div>
      <p style="font-size:13px;color:var(--text-4);">Everything above is <strong>published third-party figures</strong>, each named, dated and linked — not proprietary primary data, and no longer resolved into a headline of our own. The original contribution this page can honestly make is first-party: a figure measured from real stores, published as "based on N stores" once the sample supports it.</p>
    </div>
  </div>
</section>

<div class="divider"></div>

<!-- METHODOLOGY -->
<section class="section" id="methodology" aria-labelledby="method-h">
  <div class="inner-md">
    <div class="sec-head">
      <span class="tag tag-dim" style="margin-bottom:14px;display:inline-flex;">methodology</span>
      <h2 id="method-h">How this benchmark is built and maintained</h2>
    </div>
    <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:12px;max-width:720px;margin:0 auto;">
      <li style="display:flex;gap:10px;align-items:baseline;font-size:14px;color:var(--text-2);line-height:1.6;"><span style="color:var(--g);flex-shrink:0;">→</span>Every figure in the evidence table is drawn from a named, dated, publicly accessible third-party source and linked directly. No figure is invented or un-attributed.</li>
      <li style="display:flex;gap:10px;align-items:baseline;font-size:14px;color:var(--text-2);line-height:1.6;"><span style="color:var(--g);flex-shrink:0;">→</span>The headline range is a transparent triangulation of those inputs, presented as a synthesis — explicitly not as proprietary measurement.</li>
      <li style="display:flex;gap:10px;align-items:baseline;font-size:14px;color:var(--text-2);line-height:1.6;"><span style="color:var(--g);flex-shrink:0;">→</span>The page is re-verified periodically; the "last verified" date at the top reflects the most recent check. Figures and sources are updated as newer research is published.</li>
      <li style="display:flex;gap:10px;align-items:baseline;font-size:14px;color:var(--text-2);line-height:1.6;"><span style="color:var(--g);flex-shrink:0;">→</span>Store submissions (below) are stored anonymously and in aggregate only. No store name or identifying data is published. Once the sample is large enough to be meaningful, a first-party figure is added alongside the synthesised range.</li>
      <li style="display:flex;gap:10px;align-items:baseline;font-size:14px;color:var(--text-2);line-height:1.6;"><span style="color:var(--g);flex-shrink:0;">→</span>Spot an out-of-date figure or a better source? <a href="mailto:support@stackarchitect.xyz" style="color:var(--g);">Tell us</a> — corrections are welcomed and dated.</li>
    </ul>
  </div>
</section>

<div class="divider"></div>

<!-- CONTRIBUTE (collects real data over time) -->
<section class="section-alt" id="contribute" aria-labelledby="contrib-h">
  <div class="inner-sm">
    <div class="sec-head">
      <span class="tag" style="margin-bottom:14px;display:inline-flex;">build the data</span>
      <h2 id="contrib-h">Contribute your store's gap</h2>
      <p>Anonymous. Two numbers from your own dashboards. Helps turn this synthesis into original first-party data the whole industry can cite.</p>
    </div>

    <div id="contrib-card" style="border:1px solid var(--border);border-radius:12px;background:var(--bg-2);padding:26px;">
      <div id="gap-meter" style="margin-bottom:22px;padding:16px 18px;border:1px solid var(--g-border);border-radius:10px;background:var(--g-bg);">
        <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:10px;">
          <span id="gap-meter-count" style="font-family:var(--mono);font-size:28px;font-weight:800;color:var(--g);line-height:1;">—</span>
          <span id="gap-meter-goal" style="font-size:13px;color:var(--text-3);">of 10 stores needed to publish</span>
        </div>
        <div style="height:7px;background:var(--bg);border:1px solid var(--border);border-radius:99px;overflow:hidden;">
          <div id="gap-meter-fill" style="height:100%;width:0%;background:var(--g);border-radius:99px;transition:width .6s ease;"></div>
        </div>
        <p id="gap-meter-note" style="font-size:12px;color:var(--text-4);margin:10px 0 0;">Loading current count…</p>
      </div>
      <div style="display:flex;flex-direction:column;gap:16px;">
        <div>
          <label style="display:block;font-size:13px;font-weight:600;color:var(--text-2);margin-bottom:6px;">Conversions your ad platform reported last month</label>
          {/* Placeholders used to carry example NUMBERS — "e.g. 320" and
              "e.g. 470". Three of the first five submissions were that exact
              pair: 60% of the dataset was people echoing the example back, and
              one of them had been approved into the figure this page will
              eventually publish. A numeric example inside a numeric field is
              indistinguishable from a real answer once it has been submitted.
              Replaced with where to FIND the number, which is the more useful
              hint anyway. submit-gap.js flags any remaining exact matches for
              the moderator rather than trusting them. */}
          <input id="f-reported" type="number" inputmode="numeric" placeholder="From your Ads Manager" style="width:100%;background:var(--bg);border:1px solid var(--border-2);border-radius:8px;padding:12px 14px;color:var(--text);font-size:15px;font-family:var(--mono);" />
        </div>
        <div>
          <label style="display:block;font-size:13px;font-weight:600;color:var(--text-2);margin-bottom:6px;">Actual paid orders in Shopify for the same period</label>
          <input id="f-actual" type="number" inputmode="numeric" placeholder="From Shopify Analytics" style="width:100%;background:var(--bg);border:1px solid var(--border-2);border-radius:8px;padding:12px 14px;color:var(--text);font-size:15px;font-family:var(--mono);" />
        </div>
        <div>
          <label style="display:block;font-size:13px;font-weight:600;color:var(--text-2);margin-bottom:6px;">Main ad platform</label>
          <select id="f-platform" style="width:100%;background:var(--bg);border:1px solid var(--border-2);border-radius:8px;padding:12px 14px;color:var(--text);font-size:15px;">
            {platforms.map(p => (<option value={p}>{p}</option>))}
          </select>
        </div>
        <button id="f-submit" class="btn pulse" style="width:100%;justify-content:center;">Calculate my gap &amp; contribute →</button>
        <p id="contrib-thanks" style="display:none;font-size:13px;font-weight:600;color:var(--g);line-height:1.6;margin:0;"></p>
        <p style="font-size:11px;color:var(--text-4);line-height:1.6;margin:0;">Stored anonymously and in aggregate. We never publish individual store data or any identifying detail. Your two numbers join the dataset that produces a future first-party benchmark.</p>
      </div>

      <div id="contrib-result" style="display:none;margin-top:20px;padding-top:20px;border-top:1px solid var(--border);">
        <div style="font-family:var(--mono);font-size:11px;color:var(--text-4);letter-spacing:.1em;margin-bottom:8px;">your attribution gap</div>
        <div id="result-gap" style="font-family:var(--mono);font-size:40px;font-weight:800;color:var(--g);line-height:1;"></div>
        <p id="result-msg" style="font-size:14px;color:var(--text-3);line-height:1.7;margin:12px 0 0;"></p>
        <a href="/capi-shield/" class="btn btn-sm pulse" style="margin-top:16px;display:inline-flex;">Close the gap free with CAPI Shield →</a>

