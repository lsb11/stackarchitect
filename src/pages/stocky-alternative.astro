---
import Base from '../layouts/Base.astro';
import AuthorCard from '../components/AuthorCard.astro';
import TableOfContents from '../components/TableOfContents.astro';
import CrossLinkCallout from '../components/CrossLinkCallout.astro';
import appsData from '../data/apps.json';

// src/pages/stocky-alternative.astro
// The Stocky pillar. Absorbs the migration hub, the migration checklist, and
// four blog posts (vs Prediko, vs Inventory Planner, purchase orders, the $0
// rebuild).
//
// EVERGREEN BY CONSTRUCTION. This page is read both before and after the
// 31 August 2026 shutdown and must need no edit on 1 September. Two rules keep
// it true on both sides of that date:
//   1. The shutdown is referred to by DATE, never by tense — "Shopify set
//      31 August 2026 as the shutdown date", never "Stocky shuts down soon" or
//      "Stocky has shut down".
//   2. The reader is forked on STATE, not on date — "can you still open Stocky
//      in your admin?" — because that question has a correct answer on any day,
//      and a store that uninstalled after the February 2026 delisting was
//      already on the far side of it before August.
// Nothing on this page counts down, and nothing assumes the deadline is ahead.

const SITE = 'https://stackarchitect.xyz';
const canonical = `${SITE}/stocky-alternative/`;

const title = "Stocky Alternative — Replace Shopify Stocky for $0";
const description =
  "Stocky's final date: 31 August 2026. What the shutdown deletes, how to export while you still can, what to do if you didn't, and the $0 replacement.";

const dateModified = "2026-08-10";
const datePublished = "2026-01-15";

const appSlug = 'stocky';
const appName = 'Stocky';
const parentExists = appsData.some((app) => app.id === appSlug);

// The three dates. All are historical statements of fact and read correctly
// whether the page is loaded before or after the shutdown.
const timeline = [
  {
    when: "7 July 2025",
    what: "Inventory transfers between locations and min/max forecasting were removed from Stocky.",
    so: "If reorder triggers or stock movement between warehouses stopped behaving long before the shutdown, this is why.",
  },
  {
    when: "2 February 2026",
    what: "Stocky was delisted from the Shopify App Store — no new installs, and no reinstalls.",
    so: "Anyone who uninstalled the app after this date could not get it back, whatever their history with it.",
  },
  {
    when: "31 August 2026",
    what: "Full shutdown. The app stops, and so do its APIs.",
    so: "Any third-party tool wired into Stocky's API stops at the same moment, and anything not exported by that date is gone.",
  },
];

// Market map. Prices are the vendors' publicly listed starting rates as
// gathered for this page; none has been verified against a vendor pricing page
// under the standard in /how-we-test/, and the table says so.
const market = [
  { product: "Stocky Swap (this site)", entry: "$0", strength: "A real-time order-to-stock ledger you own, on Make.com's free tier plus Google Sheets. The only genuinely free route." },
  { product: "Shopify Admin (native)", entry: "$0", strength: "Stock tracking, transfers, adjustments, basic purchase orders and low-stock alerts — included on every Shopify plan." },
  { product: "Sensible Forecasting", entry: "$29/mo", strength: "Simple reorder-point forecasting for smaller catalogues." },
  { product: "Forstock", entry: "$39/mo", strength: "Flat-rate AI forecasting with supplier management." },
  { product: "Sumtracker", entry: "$49/mo", strength: "Multi-channel stock sync across Shopify, Amazon, eBay and Etsy, plus bundles." },
  { product: "Prediko", entry: "$119/mo", strength: "AI demand planning and fast purchase-order creation; 70+ WMS/3PL integrations; 14-day full trial." },
  { product: "Inventory Planner (Sage)", entry: "$119.99/mo", strength: "Established forecasting and replenishment with Open-to-Buy budgeting; scales steeply by SKU count." },
  { product: "Fabrikatör", entry: "$99/mo", strength: "Planning plus backorders and landed-cost tracking." },
  { product: "Qoblex", entry: "$99/mo", strength: "Inventory, orders, B2B and accounting integrations in one." },
  { product: "Cin7 Core", entry: "$349/mo", strength: "Large multi-channel operations." },
  { product: "Katana / Craftybase", entry: "varies", strength: "Manufacturers only: raw materials, bills of materials, COGS." },
];

// What Shopify Admin does and does not replace. This split, not the feature
// list of any paid tool, is what decides whether a store needs to spend money.
const nativeCovers = [
  "Stock tracking across multiple locations",
  "Inventory transfers between locations",
  "Stock adjustments with reason codes",
  "Basic purchase order creation and receiving",
  "Vendor records against purchase orders",
  "Low-stock alerts",
  "Inventory reporting in Analytics",
];
const nativeMisses = [
  "Demand forecasting that adjusts for seasonality and trend",
  "Automated, velocity-based reorder recommendations",
  "Safety-stock buffers and reorder-point calculation",
  "Supplier lead-time and minimum-order-quantity tracking",
  "Open-to-Buy budgeting for seasonal cash flow",
  "Bills of materials for anything you manufacture",
  "A stock ledger you own outside Shopify",
];

const tocHeadings = [
  { id: "answer-h",    text: "Replacing Shopify Stocky" },
  { id: "dates-h",     text: "The Three Dates That Define the Shutdown" },
  { id: "fork-h",      text: "Which Path Are You On?" },
  { id: "export-h",    text: "Path A — Getting Your Data Out" },
  { id: "missed-h",    text: "Path B — You Did Not Export in Time" },
  { id: "native-h",    text: "What Shopify Admin Replaces, and What It Does Not" },
  { id: "po-h",        text: "Rebuilding the Purchase Order Workflow" },
  { id: "free-h",      text: "The Free Ledger Route" },
  { id: "market-h",    text: "The Paid Market, Honestly" },
  { id: "choose-h",    text: "Which One, Honestly, For Your Store" },
  { id: "plan-h",      text: "The Replacement Sequence" },
  { id: "faq-h",       text: "Common Questions" },
  { id: "sources-h",   text: "Sources and Primary Documentation" },
];

// HowTo steps. Deliberately the REPLACEMENT sequence, not the export
// walkthrough: the export has a hard expiry and would leave stale structured
// data behind it, whereas rebuilding inventory management without Stocky is
// a procedure that stays valid indefinitely.
const howToSteps = [
  {
    heading: "Audit what you actually used Stocky for",
    text: "Write down which Stocky features you touched in a normal month. The honest split is forecasting and automated purchase orders on one side, order and stock tracking on the other. This single answer decides whether you need to spend money, and almost every other decision follows from it.",
  },
  {
    heading: "Move the basics to Shopify Admin",
    text: "Shopify Admin natively handles stock tracking across locations, transfers, adjustments with reason codes, basic purchase orders, vendor records and low-stock alerts, on every plan at no cost. If your whole Stocky workflow sits inside that list, migrate to Admin and stop — there is nothing left to buy.",
  },
  {
    heading: "Deploy a free order-to-stock ledger if you need one outside Shopify",
    text: "If you need a live stock ledger you own rather than one inside Shopify, add a Shopify order webhook that fires into a free Make.com scenario writing to a Google Sheet. Every order then decrements stock in a sheet in your own Google account. It takes about four minutes and costs nothing.",
  },
  {
    heading: "Rebuild supplier records by hand",
    text: "Supplier names, contacts, lead times, minimum order quantities and payment terms were never exportable from Stocky. Recreate them in whatever system you move to, working from purchase invoices, email history and accounting records. Budget real time for this — it is the slowest part of the whole migration.",
  },
  {
    heading: "Add a forecasting tool only if the audit says you need one",
    text: "If step one found genuine dependence on demand forecasting, automated replenishment, multi-channel sync or bills of materials, shortlist a paid platform against that specific gap. If it did not, buying forecasting means paying monthly for capability you will not open.",
  },
  {
    heading: "Verify before you depend on it",
    text: "Run the new system alongside your existing records for two to four weeks and reconcile: do order counts match, do stock levels agree with Shopify Admin, and has every integration that used to call Stocky's API been repointed? Forecasting tools in particular need weeks of sales data before their output is worth reading.",
  },
];

const faqs = [
  {
    q: "What replaces Shopify Stocky?",
    a: "For most stores, Shopify Admin does. Its native inventory tools cover stock tracking across locations, transfers, adjustments, basic purchase orders, vendor records and low-stock alerts on every plan at no cost. What they do not cover is demand forecasting, automated replenishment, supplier lead-time tracking and bills of materials. Stores that genuinely used those features need a paid platform; stores that used Stocky to watch stock and log orders do not.",
  },
  {
    q: "Does Stocky data migrate to Shopify automatically?",
    a: "No. Shopify confirmed that historical Stocky data — purchase orders, stocktakes, inventory adjustment logs, cost prices entered in Stocky, and reorder settings — does not transfer to Shopify Admin. Only data that already lives in Shopify itself is unaffected: order history, products, customers, current inventory levels and financial reports.",
  },
  {
    q: "Can supplier records be exported from Stocky?",
    a: "No, and this is the detail that catches most stores out. Stocky has no supplier export at all. Supplier names, contacts, lead times, minimum order quantities and payment terms have to be documented by hand and recreated in whatever system you move to. Stores that exported everything else still lose this unless they copied it out manually.",
  },
  {
    q: "What can I do if I never exported my Stocky data?",
    a: "More than you would expect. Current stock levels, order history, products and customers all live in Shopify and were never at risk. Purchase order history can usually be reconstructed from supplier invoices, email and your accounting system, which is where the same information exists in a form you control. Stocktake history and reorder settings are genuinely gone — take a fresh physical count as your new baseline and recompute reorder points from Shopify sales velocity.",
  },
  {
    q: "Do I need to pay for a Stocky replacement?",
    a: "Only if you depended on forecasting, automated purchase orders, multi-channel sync or manufacturing workflows. Shopify Admin covers basic inventory management for free, and a free Make.com scenario writing to a Google Sheet covers a live order-to-stock ledger you own. Paid platforms start around $29 to $49 a month for simple forecasting and around $119 a month for the established planning tools.",
  },
  {
    q: "Is Prediko or Inventory Planner the better Stocky replacement?",
    a: "They are close competitors at a near-identical entry price. Prediko is newer, AI-forward and Shopify-native in feel, with a full-featured 14-day trial that makes it the cheaper way to test fit. Inventory Planner is more established, owned by Sage, and stronger on Open-to-Buy budgeting and enterprise multi-channel work, but its price rises steeply with SKU count. Neither is worth buying if your honest answer is that you used Stocky for tracking rather than forecasting.",
  },
  {
    q: "Do third-party tools that connected to Stocky still work?",
    a: "No. Stocky's APIs stop at the same moment the app does, so anything wired into them breaks at that point rather than degrading gracefully. If a dashboard, spreadsheet or automation pulls inventory data from Stocky, it needs repointing at Shopify's own inventory data or at whatever replacement you have chosen.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonical}#article`,
      headline: "Stocky Alternative — Replace Shopify Stocky for $0",
      description,
      inLanguage: "en-GB",
      datePublished,
      dateModified,
      author: { "@id": `${SITE}/#luke` },
      publisher: { "@id": `${SITE}/#org` },
      isPartOf: { "@id": `${SITE}/#website` },
      mainEntityOfPage: { "@id": `${canonical}#webpage` },
      about: { "@type": "SoftwareApplication", name: "Stocky", operatingSystem: "Shopify", applicationCategory: "Inventory Management" },
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: "en-GB",
      dateModified,
      isPartOf: { "@id": `${SITE}/#website` },
    },
    {
      "@type": "HowTo",
      "@id": `${canonical}#howto`,
      name: "How to replace Shopify Stocky",
      description:
        "Rebuild Shopify inventory management after Stocky: audit real usage, move basics to Shopify Admin, add a free order-to-stock ledger, rebuild suppliers by hand, and buy forecasting only if the audit calls for it.",
      inLanguage: "en-GB",
      author: { "@id": `${SITE}/#luke` },
      publisher: { "@id": `${SITE}/#org` },
      totalTime: "PT1H",
      estimatedCost: { "@type": "MonetaryAmount", currency: "USD", value: "0" },
      step: howToSteps.map((s, i) => ({
        "@type": "HowToStep",
        position: i + 1,
        name: s.heading,
        text: s.text,
        url: `${canonical}#plan-step-${i + 1}`,
      })),
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      isPartOf: { "@id": `${canonical}#webpage` },
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  publishDate={datePublished}
  updatedDate={dateModified}
  breadcrumb={[{ label: "Home", href: "/" }, { label: "Stocky Alternative" }]}
>
<main class="max-w-4xl mx-auto px-4 py-12">

  <h1 id="answer-h" class="text-4xl md:text-5xl font-bold text-white mb-6" style="text-align:left;">
    Replacing <span class="green">Shopify Stocky.</span><br><span class="dim">Data, Deadline, Alternatives.</span>
  </h1>

  <p id="answer" style="text-align:left;">Shopify set 31 August 2026 as Stocky's shutdown date. After it, the app and its APIs stop and its data — purchase orders, stocktakes, cost prices, suppliers — is permanently deleted rather than moved into Shopify Admin. Your path depends on one thing: whether you can still open Stocky in your admin today.</p>

  <TableOfContents headings={tocHeadings} />

  <p class="text-xl text-gray-300 leading-relaxed mb-8" style="margin-top:2rem;">
    Stocky was Shopify's own free inventory app — purchase orders, supplier management, stocktakes and basic demand
    forecasting, built into the admin at no cost. Its retirement is unusual precisely because it was free: the obvious
    upgrade path leads to platforms charging a hundred dollars a month or more for capability most stores using Stocky
    never touched. This page is the whole picture in one place — what the shutdown took, how to get data out or
    reconstruct it, what Shopify Admin now covers for nothing, and what the paid market is actually worth.
  </p>

  <!-- ── the three dates ────────────────────────────────────────── -->
  <h2 id="dates-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3rem;">The Three Dates That Define the Shutdown</h2>
  <p class="text-gray-300 leading-relaxed mb-4">
    Stocky did not end in a single event. It was wound down in stages, and understanding the staging explains a lot of
    behaviour merchants noticed and could not account for at the time.
  </p>
  <div style="overflow-x:auto;margin:1.5rem 0;">
    <table style="width:100%;border-collapse:collapse;font-size:.95rem;">
      <thead>
        <tr style="border-bottom:1px solid var(--border);">
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;white-space:nowrap;">Date</th>
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">What changed</th>
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Why it matters</th>
        </tr>
      </thead>
      <tbody>
        {timeline.map((t) => (
          <tr style="border-bottom:1px solid var(--border);">
            <td style="padding:10px 12px;color:#fff;font-weight:600;font-family:var(--mono);white-space:nowrap;">{t.when}</td>
            <td style="padding:10px 12px;color:#fff;">{t.what}</td>
            <td style="padding:10px 12px;color:var(--text-3);">{t.so}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="text-gray-300 leading-relaxed mb-4">
    The staging matters for one practical reason. A store that uninstalled Stocky in, say, March 2026 to tidy up its
    app list was already in the post-shutdown position five months early, because reinstalling was no longer possible.
    That is why the useful question on this page is not what the date is, but whether the app still opens for you.
  </p>

  <!-- ── the fork ───────────────────────────────────────────────── -->
  <h2 id="fork-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3rem;">Which Path Are You On?</h2>
  <p class="text-gray-300 leading-relaxed mb-4">
    Open your Shopify admin and try to open Stocky. The answer puts you on one of two paths, and they need different
    work in a different order.
  </p>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;margin:1.5rem 0;">
    <div style="border-radius:10px;border:1.5px solid rgba(52,211,119,.3);background:rgba(52,211,119,.04);padding:24px;">
      <div style="font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.12em;color:var(--g);text-transform:uppercase;margin-bottom:12px;">Path A · Stocky still opens</div>
      <p class="text-gray-300" style="margin:0 0 .75rem;font-size:.95rem;line-height:1.7;">
        You have an export window, and it is the only irreversible part of the whole migration. Everything else can be
        redone later; this cannot. Go to <a href="#export-h" style="color:var(--g);text-decoration:underline;">Path A</a>
        and do it before anything else, even if you have not decided where you are going.
      </p>
      <p class="text-gray-400" style="margin:0;font-size:.85rem;">Shopify has said read-only access continues for an unspecified limited period after the shutdown date. Do not plan around that window lasting.</p>
    </div>
    <div style="border-radius:10px;border:1px solid var(--border);background:var(--bg-2);padding:24px;">
      <div style="font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.12em;color:var(--amber);text-transform:uppercase;margin-bottom:12px;">Path B · Stocky is gone</div>
      <p class="text-gray-300" style="margin:0 0 .75rem;font-size:.95rem;line-height:1.7;">
        Either you never exported, or you uninstalled after the February 2026 delisting and could not get it back.
        There is no route back into the app. Go to
        <a href="#missed-h" style="color:var(--g);text-decoration:underline;">Path B</a> — a good deal more is
        reconstructible than most people assume.
      </p>
      <p class="text-gray-400" style="margin:0;font-size:.85rem;">The good news arrives early: everything that lived in Shopify rather than in Stocky was never at risk.</p>
    </div>
  </div>

  <!-- ── PATH A ─────────────────────────────────────────────────── -->
  <h2 id="export-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3.5rem;">Path A — Getting Your Data Out</h2>
  <p class="text-gray-300 leading-relaxed mb-4">
    This is the only step with a hard expiry, so it goes before any decision about replacements. The destination can
    wait; the export cannot. Work through it in this order — it takes well under an hour for most stores, and the
    tedious part is not the exporting.
  </p>

  <ol class="space-y-3 my-6" style="padding-left:1.25rem;">
    <li class="text-gray-300"><strong class="text-white">Export purchase order history as CSV.</strong> In your Shopify admin go to Apps, then Stocky, then open the Reports dropdown and select the purchase order report. <em>Set the date range to your full history</em> — the default truncates older orders, which is how stores end up with a partial archive they believe is complete. The export carries PO numbers, line items, quantities, unit costs and dates.</li>
    <li class="text-gray-300"><strong class="text-white">Export stocktake history and the inventory adjustment log.</strong> Same Reports dropdown, same full date range. These are the records of what you counted and what you corrected, and nothing else in your stack holds them.</li>
    <li class="text-gray-300"><strong class="text-white">Export product cost and ABC data.</strong> Then spot-check five SKUs against recent supplier invoices before you archive it. Stocky's stored cost prices drift from reality, and merchants have found costs understated by thousands on a single container order during exactly this check. A cost file you have not sanity-checked is worse than none, because you will trust it.</li>
    <li class="text-gray-300"><strong class="text-white">Document every supplier by hand.</strong> Name, contact, lead time, minimum order quantity, payment terms. There is no supplier export in Stocky — not a hidden one, not an API one, none. This is the slow, dull part of the migration and the part no tool can recover for you afterwards.</li>
    <li class="text-gray-300"><strong class="text-white">Record reorder points and safety-stock settings</strong> for your priority SKUs. Also non-exportable, and also judgement you accumulated over time rather than data you can look up again.</li>
    <li class="text-gray-300"><strong class="text-white">Store everything in one dated cloud folder</strong>, outside Shopify and not on a single device — then open the files and confirm they are complete before you trust them. An export you have not opened is an assumption.</li>
  </ol>

  <div style="background:#1a1410;border:1px solid #5a3a1a;border-radius:12px;padding:1.25rem 1.5rem;margin:1.5rem 0;">
    <p class="text-gray-300" style="margin:0;">
      <strong class="text-white">The supplier trap, stated plainly.</strong> Every other item on that list is a
      download. Suppliers are a transcription job. Stores that treated the export as done because the CSVs were
      downloaded discovered afterwards that their vendor relationships — the contacts, the terms, the lead times they
      had tuned over years — were the one thing they had not saved. If you do nothing else on this page, do this.
    </p>
  </div>

  <p class="text-gray-300 leading-relaxed mb-4">
    The full button-by-button walkthrough, including the supplier workaround, lives in the
    <a href="/blog/shopify-stocky-data-export-before-shutdown/" style="color:var(--g);text-decoration:underline">Stocky data export guide</a>.
    For the deadline mechanics and a field-by-field account of what gets deleted, see the
    <a href="/stocky-shutdown/" style="color:var(--g);text-decoration:underline">Stocky shutdown breakdown</a>.
  </p>

  <!-- ── PATH B ─────────────────────────────────────────────────── -->
  <h2 id="missed-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3.5rem;">Path B — You Did Not Export in Time</h2>
  <p class="text-gray-300 leading-relaxed mb-4">
    Most writing about this shutdown stops at "export before the deadline", which is useless to anyone reading it
    afterwards. So here is the honest accounting of what an unexported store has actually lost, and what it has not.
    The short version: less than you fear, and the recovery work is mostly bookkeeping rather than data recovery.
  </p>

  <h3 class="text-xl font-bold text-white mb-3" style="margin-top:2rem;">What was never at risk</h3>
  <p class="text-gray-300 leading-relaxed mb-4">
    Everything that lived in Shopify rather than inside Stocky is untouched, and that is more than most people expect:
    your complete order history, your product catalogue, your customer records, your <strong>current inventory
    levels</strong>, and your financial reports. Your <em>sales</em> history was never in question. It is your
    <em>purchasing</em> history — what you ordered, from whom, at what cost — that sat inside the app.
  </p>
  <p class="text-gray-300 leading-relaxed mb-4">
    That distinction does more work than it first appears. Current stock levels surviving means you are not starting
    from zero: you know what you hold, you just do not have the paper trail of how it got there.
  </p>

  <h3 class="text-xl font-bold text-white mb-3" style="margin-top:2rem;">What is reconstructible, and from where</h3>
  <ul class="space-y-3 my-6">
    <li class="text-gray-300"><strong class="text-white">Purchase order history → your accounting system and your inbox.</strong> Every PO that turned into a real delivery generated a supplier invoice, and that invoice is in Xero, QuickBooks or whatever you use, along with the amount, the date and the supplier. Your email holds the orders you sent. This is not the same as a clean CSV, but it reconstructs the substance of what you bought and what you paid.</li>
    <li class="text-gray-300"><strong class="text-white">Cost prices → Shopify's own cost-per-item field, then supplier invoices.</strong> If costs were maintained on the product variant in Shopify as well as in Stocky, they survived. Where they were only in Stocky, your most recent supplier invoice per SKU is the more accurate source anyway — recall that Stocky's stored costs were known to drift.</li>
    <li class="text-gray-300"><strong class="text-white">Supplier records → invoices, email, and your payments ledger.</strong> Everyone rebuilds these by hand regardless of which path they are on, because suppliers were never exportable. Path B is not disadvantaged here at all. Work through twelve months of supplier payments and you will have the list.</li>
    <li class="text-gray-300"><strong class="text-white">Reorder points → Shopify sales velocity.</strong> These were always judgement calls rather than facts. Pull ninety days of unit sales per SKU from Shopify Analytics, divide by the period to get daily velocity, and multiply by your supplier lead time plus a buffer. That is the same arithmetic that produced the original numbers.</li>
  </ul>

  <h3 class="text-xl font-bold text-white mb-3" style="margin-top:2rem;">What is genuinely gone</h3>
  <p class="text-gray-300 leading-relaxed mb-4">
    Two things, and it is worth being straight about them rather than pretending there is a workaround.
    <strong>Stocktake history</strong> — the record of physical counts and the variances they revealed — has no
    external counterpart, because nobody invoices you for a stocktake. <strong>Inventory adjustment logs</strong> are
    the same: the reasons you wrote against shrinkage, damage and correction existed only in the app.
  </p>
  <p class="text-gray-300 leading-relaxed mb-4">
    The practical response is to stop trying to recover them and establish a new baseline instead. Take a physical
    count now, record it as your opening position, and start logging adjustments from that point in whatever system you
    are moving to. Historic stocktake data was mostly useful for spotting a trend in shrinkage; you can start that
    trend again from today, and in a quarter you will have something usable.
  </p>
  <p class="text-gray-300 leading-relaxed mb-4">
    One more item to check rather than assume: anything that read from Stocky's API stopped when the API did. If a
    reporting dashboard, a spreadsheet or an automation used to pull inventory data and has been quietly returning
    nothing since, that is why, and it needs repointing at Shopify's own inventory data or at your replacement.
  </p>

  <!-- ── native ─────────────────────────────────────────────────── -->
  <h2 id="native-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3.5rem;">What Shopify Admin Replaces, and What It Does Not</h2>
  <p class="text-gray-300 leading-relaxed mb-4">
    Shopify's position on the shutdown is that basic inventory management now lives in Shopify Admin on every plan.
    That is true, and it is materially incomplete. The split below is the single most useful thing on this page,
    because which column your workflow sits in decides whether you need to spend anything at all.
  </p>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;margin:1.5rem 0;">
    <div style="border-radius:10px;border:1.5px solid rgba(52,211,119,.3);background:rgba(52,211,119,.04);padding:24px;">
      <div style="font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.12em;color:var(--g);text-transform:uppercase;margin-bottom:12px;">Shopify Admin covers — no app needed</div>
      <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;">
        {nativeCovers.map((c) => (
          <li style="font-size:.9rem;color:var(--text-3);line-height:1.6;display:flex;gap:8px;"><span style="color:var(--g);flex-shrink:0;">✓</span>{c}</li>
        ))}
      </ul>
    </div>
    <div style="border-radius:10px;border:1px solid rgba(220,120,80,.5);background:var(--bg-2);padding:24px;">
      <div style="font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.12em;color:var(--amber);text-transform:uppercase;margin-bottom:12px;">Shopify Admin does not cover</div>
      <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;">
        {nativeMisses.map((c) => (
          <li style="font-size:.9rem;color:var(--text-3);line-height:1.6;display:flex;gap:8px;"><span style="color:var(--amber);flex-shrink:0;">—</span>{c}</li>
        ))}
      </ul>
    </div>
  </div>
  <p class="text-gray-300 leading-relaxed mb-4">
    If everything you used Stocky for sits in the left column, migrate to Shopify Admin and you are finished — no app,
    no subscription, no further reading required. That is a genuine outcome for a large share of stores, and it is the
    one the comparison articles written by inventory vendors tend to skip.
  </p>
  <p class="text-gray-300 leading-relaxed mb-4">
    If you need something from the right column, split it further. The last item — a stock ledger you own outside
    Shopify — is covered free by the ledger route below. Everything above it is forecasting and supplier intelligence,
    and that is where paid tools genuinely earn their fee.
  </p>

  <!-- ── purchase orders ────────────────────────────────────────── -->
  <h2 id="po-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3.5rem;">Rebuilding the Purchase Order Workflow</h2>
  <p class="text-gray-300 leading-relaxed mb-4">
    Purchase orders are the loss stores feel most sharply, because for most of Stocky's life they had no equivalent
    anywhere else in the admin. Two assumptions trip merchants up here, and both are worth naming.
  </p>
  <p class="text-gray-300 leading-relaxed mb-4">
    The first is "Shopify owns Stocky, so my data will simply move to Shopify." It does not — Shopify has been explicit
    that historical purchase orders and stocktakes are not migrated. The second is "there is read-only access
    afterwards, so I can collect it later." Read-only access is offered for an unspecified limited period, but the APIs
    stop on the shutdown date and no new export capability is promised. Betting on that window is a wager with no
    upside, since the export takes five minutes.
  </p>
  <p class="text-gray-300 leading-relaxed mb-4">
    Going forward, there are three sensible ways to raise a purchase order, and they map cleanly onto how much
    purchasing you actually do:
  </p>
  <ul class="space-y-3 my-6">
    <li class="text-gray-300"><strong class="text-white">Shopify Admin, free.</strong> Native inventory now includes purchase order creation, vendor records, transfers and receiving. For a store raising a handful of POs a month against a stable supplier list, this is the whole answer. What it does not do is suggest <em>when</em> or <em>how much</em> to order.</li>
    <li class="text-gray-300"><strong class="text-white">A paid planning tool.</strong> If you need automated, velocity-based reorder recommendations, multi-location POs with vendor constraints, or demand forecasting behind the suggestion, a dedicated platform does that properly. This is the one capability gap that reliably justifies a subscription.</li>
    <li class="text-gray-300"><strong class="text-white">A hybrid, which is what most stores land on.</strong> Track orders and stock with the free ledger route, raise the occasional PO by hand in Shopify Admin, and buy nothing. If purchasing is a monthly rather than a daily activity, automation of it is not worth a four-figure annual bill.</li>
  </ul>

  <!-- ── free route ─────────────────────────────────────────────── -->
  <h2 id="free-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3.5rem;">The Free Ledger Route</h2>
  <p class="text-gray-300 leading-relaxed mb-4">
    If what you want is a live, accurate stock count in something you own — a ledger outside Shopify that you can
    query, share and keep — you can build it for nothing. A Shopify order webhook fires into a free Make.com scenario,
    which writes each order into a Google Sheet in your own Google account: order ID, SKUs, quantities, fulfilment
    status. Stock decrements as orders arrive, and low-stock rows flag themselves.
  </p>
  <p class="text-gray-300 leading-relaxed mb-4">
    It takes roughly four minutes to deploy, needs no code, installs no app on your store, and runs on Make.com's free
    tier indefinitely. The full build is documented on the
    <a href="/stocky-swap/" style="color:var(--g);text-decoration:underline">Stocky Swap page</a>.
  </p>
  <p class="text-gray-300 leading-relaxed mb-4">
    <strong class="text-white">And here is what it does not do</strong>, because a free tool oversold is worse than no
    tool. It does not forecast demand. It does not calculate reorder points or safety stock. It does not track
    bills of materials, and it does not sync inventory across Amazon, eBay or Etsy. It is a ledger, not a planning
    system. For the stores that used Stocky to watch stock and log orders — which, on the evidence of what people
    actually say they used it for, is most of them — a ledger is precisely the thing that was lost. For everyone
    else it is a component, not an answer.
  </p>

  {parentExists && <CrossLinkCallout type="review" appSlug={appSlug} appName={appName} />}

  <!-- ── market ─────────────────────────────────────────────────── -->
  <h2 id="market-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3.5rem;">The Paid Market, Honestly</h2>
  <p class="text-gray-300 leading-relaxed mb-4">
    Most "Stocky alternatives" lists are published by one of the vendors on them, ranked with themselves at the top.
    Here is the whole field in one table, including the tools this site earns nothing from, so the free route can be
    judged against everything else rather than presented in a vacuum.
  </p>
  <div style="overflow-x:auto;margin:1.5rem 0;">
    <table style="width:100%;border-collapse:collapse;font-size:.92rem;">
      <thead>
        <tr style="border-bottom:1px solid var(--border);">
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Tool</th>
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;white-space:nowrap;">From</th>
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Strongest at</th>
        </tr>
      </thead>
