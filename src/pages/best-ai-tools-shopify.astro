---
import { pageUpdated } from '../data/pageUpdated';
import Base from '../layouts/Base.astro';
import Disclosure from '../components/Disclosure.astro';
import AuthorCard from '../components/AuthorCard.astro';
import TableOfContents from '../components/TableOfContents.astro';
// src/pages/best-ai-tools-shopify.astro
// Ranked by first-hand use, then by what the free plan covers. Commission
// rate is never a ranking reason: until Sep 2026 this page listed twelve
// tools and justified some positions by commission rate and cookie window.
// Those entries were cut, not rewritten.

const SITE_URL = "https://stackarchitect.xyz";
const PAGE_URL = `${SITE_URL}/best-ai-tools-shopify/`;
const DATE_PUBLISHED = "2026-03-15";
const DATE_MODIFIED = pageUpdated('/best-ai-tools-shopify/')!;
const DATE_MODIFIED_LABEL = new Date(DATE_MODIFIED).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });

// ── Affiliate links ───────────────────────────────────────────
const AFF = {
  make:       "/go/make/",
  systeme:    "/go/systeme/",
  tidio:      "/go/tidio/",
};

// ── FAQ: one source for the visible list and the FAQPage schema ──
const faqs = [
  {
    q: "What is the best free AI tool for Shopify store owners in 2026?",
    a: "Make.com and Systeme.io are the two we run ourselves, and both do real work on a free plan: Make.com gives 1,000 credits a month (formerly called operations) and Systeme.io gives 2,000 contacts with unlimited sends. Tidio, Beehiiv and Shopify Magic also have free plans. We have not used those three, so we can tell you what the free plan includes but not how well it performs.",
  },
  {
    q: "Is Systeme.io a good free alternative to Klaviyo for Shopify?",
    a: "Yes, for most small stores. The free plan includes 2,000 contacts with unlimited email sends, abandoned cart and post-purchase automation, sales funnels and a CRM. Klaviyo's free plan is limited to 250 contacts and 500 emails per month, so Systeme.io's free plan holds 8× more contacts with no send limit. What you give up is Klaviyo's email editor and predictive segmentation. See the <a href=\"/replace-klaviyo-free/\">free step-by-step migration guide</a>.",
  },
  {
    q: "What does Make.com do for Shopify stores?",
    a: "Make.com receives Shopify's order webhook and sends the order on to other services. Every blueprint on this site runs on it: purchase events to Meta's Conversions API (CAPI Shield) and TikTok's Events API, a Google Sheets log of every paid order (Stocky Swap), and gross profit per order (P&L Auto). The free plan gives 1,000 credits a month and two active scenarios, so the four run as router branches of one scenario, which covers roughly 160–250 orders a month.",
  },
  {
    q: "How much does Make.com cost compared to Zapier for Shopify?",
    a: "Make.com's free plan includes 1,000 credits/month (formerly called operations). Zapier's free plan includes 100 tasks per month, 10× fewer. On paid plans, Make.com's Core plan costs $9/month for 10,000 credits, while Zapier's Starter plan costs $19.99/month for 750 tasks. The trade-off is that Make.com takes longer to learn than Zapier.",
  },
  {
    q: "Is Tidio worth it for Shopify customer support?",
    a: "We have not used Tidio on a store, so we cannot answer that from our own results. What Tidio publishes: the free plan includes 50 one-time Lyro AI conversations, not a monthly allowance; paid plans start at $29/month; and Tidio says Lyro resolves 67% of conversations instantly (<a href='https://www.tidio.com/' target='_blank' rel='noopener'>tidio.com</a>). That last figure is Tidio's, not ours. Gorgias, the usual paid alternative, starts at $40+/month.",
  },
  {
    q: "Should I use Beehiiv or Systeme.io for Shopify email?",
    a: "They do different jobs. Systeme.io handles email triggered by what a customer does in your store: abandoned cart, welcome and post-purchase flows. Beehiiv is for a newsletter you write and send yourself. We run Systeme.io and have not used Beehiiv. Both have free plans, up to 2,000 contacts on Systeme.io and 2,500 subscribers on Beehiiv.",
  },
];
const stripTags = (s) => s.replace(/<[^>]+>/g, '');

// ── JSON-LD schemas ───────────────────────────────────────────
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Best AI Tools for Shopify 2026 — 5 Tools, Ranked by First-Hand Use",
  "description": "Five AI and automation tools for Shopify, ranked by first-hand use rather than commission. Which ones we run, which we have not used, and what each free plan covers.",
  "datePublished": DATE_PUBLISHED,
  "dateModified": DATE_MODIFIED,
  "author": { "@id": "https://stackarchitect.xyz/#luke" },
  "publisher": { "@id": "https://stackarchitect.xyz/#org" },
  "mainEntityOfPage": { "@type": "WebPage", "@id": PAGE_URL },
  "url": PAGE_URL,
  "inLanguage": "en-GB",
  "articleSection": "AI Tools",
  "keywords": ["best ai tools shopify 2026","free shopify ai tools","make.com shopify","systeme.io shopify","tidio shopify","beehiiv shopify","replace klaviyo free"],
  "about": [
    { "@type": "Thing", "name": "Make.com",   "sameAs": "https://www.make.com" },
    { "@type": "Thing", "name": "Systeme.io", "sameAs": "https://systeme.io" },
    { "@type": "Thing", "name": "Tidio",      "sameAs": "https://www.tidio.com" },
    { "@type": "Thing", "name": "Beehiiv",    "sameAs": "https://www.beehiiv.com" }
  ]
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Best AI Tools for Shopify 2026",
  "description": "Five tools for Shopify stores, ranked by first-hand use, then by what the free plan covers",
  "numberOfItems": 5,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Make.com",    "description": "Automation platform every Stack Architect blueprint runs on. Used by us. 1,000 credits/month free." },
    { "@type": "ListItem", "position": 2, "name": "Systeme.io",  "description": "Email automation and funnels. Used by us. Free for 2,000 contacts with unlimited sends." },
    { "@type": "ListItem", "position": 3, "name": "Tidio AI",    "description": "Live chat with Lyro AI replies. Not used by us. Free plan includes 50 one-time Lyro conversations." },
    { "@type": "ListItem", "position": 4, "name": "Beehiiv",     "description": "Newsletter platform. Not used by us. Free for up to 2,500 subscribers." },
    { "@type": "ListItem", "position": 5, "name": "GetResponse", "description": "Paid email platform for lists beyond Systeme.io's free plan. Not used by us." }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": stripTags(f.a) }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE_URL },
    { "@type": "ListItem", "position": 2, "name": "Best AI Tools for Shopify 2026", "item": PAGE_URL }
  ]
};

const tocHeadings = [
  { "id": "how-ranked",        "text": "How this ranking works" },
  { "id": "make-title",        "text": "Make.com" },
  { "id": "systeme-title",     "text": "Systeme.io" },
  { "id": "tidio-title",       "text": "Tidio AI" },
  { "id": "beehiiv-title",     "text": "Beehiiv" },
  { "id": "getresponse-title", "text": "GetResponse" },
  { "id": "comparison",        "text": "Comparison table" },
  { "id": "faq",               "text": "Frequently asked questions" },
  { "id": "related-app-alternatives", "text": "Related App Alternatives" }
];

---
<Base title="Best AI Tools for Shopify 2026 — 5 Tools, Ranked by Use" description="Five AI and automation tools for Shopify, ranked by first-hand use rather than commission: which we run, which we have not used, and what each free plan covers.">
<Fragment slot="head">
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "WebSite", "@id": "https://stackarchitect.xyz/#website", "url": "https://stackarchitect.xyz/", "name": "Stack Architect", "description": "Free Shopify automation tools replacing $700+/month of paid apps — server-side tracking, inventory, email, TikTok Events API, P&L.", "publisher": {"@id": "https://stackarchitect.xyz/#org"}, "inLanguage": "en-GB"})} />
  </Fragment>

<main class="page-wrap" id="main-content">

  <!-- Breadcrumbs -->
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="https://stackarchitect.xyz/">Home</a>
    <span class="bc-sep" aria-hidden="true">/</span>
    <span class="bc-current" aria-current="page">Best AI Tools for Shopify 2026</span>
  </nav>

  <!-- Author / date metadata (visible + schema-compatible) -->
  <div class="author-meta" aria-label="Article metadata">
    <span>
      <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
        <circle cx="5" cy="5" r="4.5" stroke="#93a09a"/>
        <circle cx="5" cy="3.5" r="1.5" fill="#93a09a"/>
        <path d="M2 8.5c0-1.66 1.34-3 3-3s3 1.34 3 3" stroke="#93a09a" stroke-linecap="round"/>
      </svg>
      Stack Architect
    </span>
    <span>
      <time datetime={DATE_PUBLISHED}>Published March 2026</time>
    </span>
    <span>
      <time datetime={DATE_MODIFIED}>Updated {DATE_MODIFIED_LABEL}</time>
    </span>
    <span>5 tools listed</span>
  </div>

  <!-- ── HERO ──────────────────────────────────────────────────── -->
  <section class="hero" aria-labelledby="page-h1">
    <div class="hero-eyebrow">
      <span class="eyebrow-dot" aria-hidden="true"></span>
      <span class="eyebrow-txt">Free tools first · Updated {DATE_MODIFIED_LABEL}</span>
    </div>
    <h1 id="page-h1">
      Best <span class="h1-g">AI Tools</span> for Shopify 2026<br>
      <span class="h1-sky">5 Tools, Ranked by First-Hand Use</span>
    </h1>

    <p id="answer">Five AI and automation tools for Shopify stores, ranked by first-hand use: we run Make.com and Systeme.io ourselves, and describe Tidio, Beehiiv and GetResponse from their own documentation. We have measured return on none of them. Commission played no part in the order.</p>

  <TableOfContents headings={tocHeadings} />

    <p class="hero-deck">
      Written for Shopify operators who want to know what a tool does on a free plan before paying for it. <strong>Each entry says whether we have used the tool.</strong> We earn a commission from all five through our links. That is disclosed below, and it is not why any tool is where it is.
    </p>

    <div class="stats" role="list" aria-label="What this page is based on">
      <div class="stat" role="listitem">
        <span class="stat-v sv-sky">5</span>
        <span class="stat-l">Tools listed</span>
      </div>
      <div class="stat" role="listitem">
        <span class="stat-v sv-g">2</span>
        <span class="stat-l">We run ourselves</span>
      </div>
      <div class="stat" role="listitem">
        <span class="stat-v sv-a">3</span>
        <span class="stat-l">Not used by us</span>
      </div>
      <div class="stat" role="listitem">
        <span class="stat-v sv-p">0</span>
        <span class="stat-l">ROI measured</span>
      </div>
    </div>

    <div class="hero-btns">
      <a href="#comparison" class="btn btn-g">Jump to comparison table →</a>
      <a href="#how-ranked" class="btn btn-o">How this is ranked</a>
      <a href="https://stackarchitect.xyz/tools/" class="btn btn-o">Run free audit</a>
    </div>
  </section>

  <!-- ── QUICK ANSWER (GEO / AI citation target) ──────────────── -->
  <div class="quick-answer" role="note" aria-label="Quick answer">
    <span class="qa-label">Quick answer</span>
    <p>
      <strong>Start with Make.com and Systeme.io. They are the two on this list we run ourselves, and both are free to start.</strong>
      Make.com gives 1,000 credits/month (formerly called operations), which is enough to run this site's four Shopify blueprints on roughly 160–250 orders a month.
      Systeme.io handles abandoned cart, welcome and post-purchase email free for up to 2,000 contacts with unlimited sends.
      Tidio (live chat and AI replies) and Beehiiv (newsletters) also have free plans. We have not used either one.
    </p>
  </div>

  <!-- ── HOW THIS IS RANKED ────────────────────────────────────── -->
  <div class="sec-mark" id="how-ranked">How this ranking works</div>
  <div class="prose">
    <p>This page used to rank twelve tools "by measured return", and nothing on it had been measured. Several positions were justified by the size of a commission or the length of a cookie window. Those seven entries are gone. They had about 80 words each, figures with no source, and no sign that anyone had tested the tool. We cut them rather than padding them out.</p>
    <p>What is left is ranked on the one thing we can honestly claim: <strong>whether we have used the tool ourselves.</strong> We have not measured return on investment for any tool here. We have no before-and-after revenue figures to report, and anyone who says they measured one is quoting a vendor.</p>
    <ol>
      <li><strong>Used by us, ranked first.</strong> Make.com runs every blueprint on this site. Systeme.io is where we rebuilt Klaviyo's flows on the free plan (see <a href="https://stackarchitect.xyz/about/">About</a>).</li>
      <li><strong>Not used by us, ranked by what the free plan does before you pay.</strong> Tidio's free plan puts a working chat widget on your store. Beehiiv's free plan runs a newsletter but does not replace any store-triggered email. GetResponse comes last because the job it does, store-triggered email, is one Systeme.io already does for free up to 2,000 contacts.</li>
    </ol>
    <p>Before adding any tool, run the <a href="https://stackarchitect.xyz/shopify-app-stack-kill-or-keep-auditor/">free app stack auditor</a> to see what you already pay for.</p>
    <p>For where each of these fits across a store, from product research to email and support, see the <a href="/blog/shopify-ai-playbook-2026/">Shopify AI playbook</a>. If you want your products to appear inside ChatGPT, Copilot or Google AI Mode, the <a href="/blog/shopify-agentic-storefronts-setup-guide-2026/">agentic storefronts guide</a> covers eligibility channel by channel.</p>
  </div>

  <div class="callout amber">
    <span class="callout-label">Affiliate disclosure</span>
    <p>Stack Architect earns a commission if you sign up for Make.com, Systeme.io, Tidio, Beehiiv or GetResponse through our links, at no extra cost to you. Commission rates are not shown on this page and played no part in the order. <strong>Correction, September 2026:</strong> earlier versions of this page ranked tools partly by commission rate and said GetResponse was not an affiliate. It is.</p>
  </div>

  <!-- ── #1 MAKE.COM ───────────────────────────────────────────── -->
  <article class="tool-card confirmed-sky" id="make" aria-labelledby="make-title">
    <div class="tc-header">
      <span class="tc-rank">#1</span>
      <div class="tc-name-wrap">
        <h2 class="tc-name" id="make-title">Make.com</h2>
        <p class="tc-tagline">The automation platform every blueprint on this site runs on</p>
      </div>
      <div class="tc-badges">
        <span class="tc-badge tcb-conf">Used by us</span>
        <span class="tc-badge tcb-free">Free tier</span>
      </div>
    </div>

    <div class="tc-meta">
      <div class="tc-meta-item"><span class="tc-meta-label">Used by us</span><span class="tc-meta-val">Yes, runs this site&rsquo;s public scenarios</span></div>
      <div class="tc-meta-item"><span class="tc-meta-label">Price</span><span class="tc-meta-val">Free – $29/mo</span></div>
      <div class="tc-meta-item"><span class="tc-meta-label">Free tier</span><span class="tc-meta-val">1,000 credits/month</span></div>
      <div class="tc-meta-item"><span class="tc-meta-label">vs Zapier free</span><span class="tc-meta-val">10× more operations</span></div>
    </div>

    <div class="tc-body">
      <p>Make.com is first because it is the one tool on this list we depend on every day. It receives Shopify's order webhook and passes the order on to other services. Where Zapier's free plan gives 100 tasks a month, Make's free plan gives 1,000 credits. <strong>Every blueprint on this site is built on it.</strong></p>
      <p>The four blueprints are Meta purchase events (CAPI Shield), TikTok purchase events (TikTok CAPI), a Google Sheets log of every paid order (Stocky Swap) and gross profit per order (P&L Auto). Make's free plan allows two active scenarios, so the Complete Kit's <code>FILE_00</code> runs all four as router branches of one scenario. That fits roughly 160–250 orders a month on the free plan. The <a href="https://stackarchitect.xyz/make-com-shopify/">Make.com guide</a> shows the arithmetic.</p>
      <p>What we have seen go wrong: with a module's error handler set to <code>Ignore</code>, a rejected API call finishes as a green run and nothing tells you. Check the error handling on every module that sends data out before you trust a scenario with your conversion data.</p>
    </div>

    <div class="tc-pros-cons">
      <div class="tc-pros">
        <div class="tc-pros-head">Pros</div>
        <ul class="tc-list">
          <li>1,000 credits/month free, 10× Zapier's free tier</li>
          <li>Visual workflow builder, no code required</li>
          <li>Powers CAPI Shield, Stocky Swap, TikTok CAPI and P&L Auto on this site</li>
        </ul>
      </div>
      <div class="tc-cons">
        <div class="tc-cons-head">Watch out for</div>
        <ul class="tc-list">
          <li>Steeper learning curve than Zapier</li>
          <li>Two active scenarios on the free plan</li>
          <li>Each extra branch uses more credits on every order</li>
        </ul>
      </div>
    </div>

    <div class="tc-verdict">
      <strong>Verdict:</strong> Start here. Build one scenario from the <a href="https://stackarchitect.xyz/shopify-profit-loss-automation/">free P&L automation guide</a> to learn how it works, then add branches.
    </div>

    <div class="tc-ctas">
      <a href="https://stackarchitect.xyz/capi-shield/" class="btn btn-g">See CAPI Shield setup</a>
    </div>
  </article>

  <!-- ── #2 SYSTEME.IO ─────────────────────────────────────────── -->
  <article class="tool-card confirmed-g" id="systeme" aria-labelledby="systeme-title">
    <div class="tc-header">
      <span class="tc-rank">#2</span>
      <div class="tc-name-wrap">
        <h2 class="tc-name" id="systeme-title">Systeme.io</h2>
        <p class="tc-tagline">Free Klaviyo replacement: 2,000 contacts, unlimited sends, automation at $0/month</p>
      </div>
      <div class="tc-badges">
        <span class="tc-badge tcb-conf">Used by us</span>
        <span class="tc-badge tcb-free">Free tier</span>
      </div>
    </div>

    <div class="tc-meta">
      <div class="tc-meta-item"><span class="tc-meta-label">Used by us</span><span class="tc-meta-val">Yes, Klaviyo flows rebuilt</span></div>
      <div class="tc-meta-item"><span class="tc-meta-label">Price</span><span class="tc-meta-val">$0 – $97/mo</span></div>
      <div class="tc-meta-item"><span class="tc-meta-label">Free tier</span><span class="tc-meta-val">Yes — 2,000 contacts</span></div>
      <div class="tc-meta-item"><span class="tc-meta-label">Best for</span><span class="tc-meta-val">Replacing Klaviyo at $0</span></div>
    </div>

    <div class="tc-body">
      <p>Systeme.io is the second tool we have used ourselves. We rebuilt the flows most stores pay Klaviyo for on its free plan: welcome sequence, abandoned cart, post-purchase and broadcasts. The free plan covers 2,000 contacts with unlimited sends. <strong>Klaviyo's free plan caps at 250 contacts and 500 emails a month, so Systeme.io holds 8× more contacts with no send limit.</strong></p>
      <p>It ranks below Make.com only because it needs Make.com to see your store. Shopify events reach it through a webhook, and that link is the part that takes setting up. See the <a href="https://stackarchitect.xyz/replace-klaviyo-free/">free Klaviyo migration guide</a> for the steps.</p>
    </div>

    <div class="tc-pros-cons">
      <div class="tc-pros">
        <div class="tc-pros-head">Pros</div>
        <ul class="tc-list">
          <li>Free for 2,000 contacts with unlimited email sends</li>
          <li>Abandoned cart, welcome and post-purchase automation</li>
          <li>Sales funnels, landing pages and digital products included</li>
        </ul>
      </div>
      <div class="tc-cons">
        <div class="tc-cons-head">Watch out for</div>
        <ul class="tc-list">
          <li>Email design editor less polished than Klaviyo's drag-and-drop</li>
          <li>No predictive segmentation on the free tier</li>
          <li>Shopify data arrives by webhook, set up through Make.com</li>
        </ul>
      </div>
    </div>

    <div class="tc-verdict">
      <strong>Verdict:</strong> If Klaviyo is costing you money and your list is under 2,000 contacts, move. The <a href="https://stackarchitect.xyz/replace-klaviyo-free/">migration guide</a> covers it.
    </div>

    <div class="tc-ctas">
      <a href="https://stackarchitect.xyz/replace-klaviyo-free/" class="btn btn-g">Migration guide (free)</a>
    </div>
  </article>

  <!-- ── #3 TIDIO ───────────────────────────────────────────────── -->
  <article class="tool-card confirmed-a" id="tidio" aria-labelledby="tidio-title">
    <div class="tc-header">
      <span class="tc-rank">#3</span>
      <div class="tc-name-wrap">
        <h2 class="tc-name" id="tidio-title">Tidio AI</h2>
        <p class="tc-tagline">Live chat with Lyro AI replies. Free plan available. Not used by us</p>
      </div>
      <div class="tc-badges">
        <span class="tc-badge tcb-free">Free tier</span>
      </div>
    </div>

    <div class="tc-meta">
      <div class="tc-meta-item"><span class="tc-meta-label">Used by us</span><span class="tc-meta-val">No</span></div>
      <div class="tc-meta-item"><span class="tc-meta-label">Price</span><span class="tc-meta-val">Free – $59/mo</span></div>
      <div class="tc-meta-item"><span class="tc-meta-label">Free tier</span><span class="tc-meta-val">Yes, 50 one-time</span></div>
      <div class="tc-meta-item"><span class="tc-meta-label">Paid alternative</span><span class="tc-meta-val">Gorgias, $40+/mo</span></div>
    </div>

    <div class="tc-body">
      <p>We have not run Tidio on a store. Everything in this entry comes from Tidio's own documentation. Lyro, its AI agent, answers order status, shipping and product questions, and the Shopify integration lets it look up a customer's order. <strong>Tidio says Lyro resolves 67% of conversations instantly (<a href="https://www.tidio.com/" target="_blank" rel="noopener">tidio.com</a>). That is Tidio's figure. We have not checked it.</strong></p>
      <p>The free plan includes 50 one-time Lyro AI conversations, not a monthly allowance. Paid plans start at $29/month. It ranks third because its free plan puts a working chat widget on your store before you pay anything. The <a href="https://stackarchitect.xyz/blog/tidio-for-shopify-complete-setup-guide/">Tidio setup guide</a> walks through the configuration.</p>
    </div>

    <div class="tc-pros-cons">
      <div class="tc-pros">
        <div class="tc-pros-head">What Tidio offers</div>
        <ul class="tc-list">
          <li>Live chat and AI replies in one inbox</li>
          <li>Shopify integration for order lookups</li>
          <li>A free plan, not a time-limited trial</li>
        </ul>
      </div>
      <div class="tc-cons">
        <div class="tc-cons-head">Watch out for</div>
        <ul class="tc-list">
          <li>Only 50 one-time Lyro AI conversations on free, so higher-volume stores pay for Lyro</li>
          <li>The automation rate is the vendor's average, not a result for your store</li>
        </ul>
      </div>
    </div>

    <div class="tc-verdict">
      <strong>Verdict:</strong> Worth trying on the free plan before you pay for a helpdesk. Measure the share of conversations it closes without you, rather than relying on Tidio's average.
    </div>

    <Disclosure />
    <div class="tc-ctas">
      <a href={`${AFF.tidio}?source=best-ai-tools-shopify-map-n1`} class="btn btn-g" target="_blank" rel="sponsored nofollow noopener">Try Tidio's free plan →</a>
      <a href="https://stackarchitect.xyz/blog/tidio-for-shopify-complete-setup-guide/" class="btn btn-o">Setup guide</a>
      <span class="tc-aff-note">Affiliate link</span>
    </div>
  </article>

  <!-- ── #4 BEEHIIV ─────────────────────────────────────────────── -->
  <article class="tool-card confirmed-p" id="beehiiv" aria-labelledby="beehiiv-title">
    <div class="tc-header">
      <span class="tc-rank">#4</span>
      <div class="tc-name-wrap">
