<script is:inline>
  (function() {
    var deadline = new Date('2026-08-31T23:59:59Z').getTime();
    function pad(n) { return n < 10 ? '0' + n : '' + n; }

    function tick() {
      var now = Date.now();
      var diff = deadline - now;
      // Past the deadline: state it plainly and relabel the strip, rather than
      // leaving "Stocky shuts down in" above a row of zeros.
      if (diff <= 0) {
        var banner = document.getElementById('stocky-countdown');
        if (banner) banner.textContent = 'service ended';
        var strip = document.getElementById('cd-strip');
        var stripPost = document.getElementById('cd-strip-post');
        if (strip) strip.hidden = true;
        if (stripPost) stripPost.hidden = false;
        var stickyDays = document.getElementById('sticky-days');
        if (stickyDays) stickyDays.textContent = '0';
        return;
      }
      var d = Math.floor(diff / (1000 * 60 * 60 * 24));
      var h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      var m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      var s = Math.floor((diff % (1000 * 60)) / 1000);

      var setEl = function(id, val) { var el = document.getElementById(id); if (el) el.textContent = pad(val); };
      setEl('cd-days', d); setEl('cd-hours', h); setEl('cd-mins', m); setEl('cd-secs', s);

      var stickyDays = document.getElementById('sticky-days');
      if (stickyDays) stickyDays.textContent = d;

      var banner = document.getElementById('stocky-countdown');
      if (banner) banner.textContent = d + 'd ' + pad(h) + 'h ' + pad(m) + 'm';
    }
    tick();
    setInterval(tick, 1000);

    // Sticky CTA — show after 50% scroll OR 30 seconds, whichever first
    var stickyCta = document.getElementById('stickyCta');
    var stickyClose = document.getElementById('stickyCtaClose');
    var stickyShown = false;
    var stickyDismissed = false;

    function showSticky() {
      if (stickyShown || stickyDismissed || !stickyCta) return;
      stickyShown = true;
      stickyCta.classList.add('show');
      document.body.classList.add('has-sticky-cta');
      if (typeof gtag === 'function') gtag('event', 'sticky_cta_shown', { event_category: 'engagement' });
    }
    function hideSticky() {
      stickyDismissed = true;
      if (!stickyCta) return;
      stickyCta.classList.remove('show');
      document.body.classList.remove('has-sticky-cta');
      if (typeof gtag === 'function') gtag('event', 'sticky_cta_dismissed', { event_category: 'engagement' });
    }

    if (stickyClose) stickyClose.addEventListener('click', hideSticky);

    setTimeout(showSticky, 30000);
    window.addEventListener('scroll', function() {
      var pct = window.scrollY / Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      if (pct >= 0.5) showSticky();
    }, { passive: true });

    // CTA tracking
    document.addEventListener('click', function(e) {
      var el = e.target.closest('[data-cta]');
      if (!el || typeof gtag !== 'function') return;
      gtag('event', 'cta_click', {
        event_category: 'stocky_swap',
        event_label: el.getAttribute('data-cta'),
        link_url: el.getAttribute('href')
      });
    });

    // Affiliate click tracking for DIRECT (non-cloaked) partner links only.
    //
    // This block previously fired affiliate_click for /go/make, /go/getresponse
    // and /go/systeme. src/layouts/Base.astro already fires affiliate_click for
    // every /go/* click sitewide, so those three were counted TWICE — and the
    // first condition matched both make.com and /go/make, so a cloaked Make click
    // could be counted more than that. The built page carried four
    // affiliate_click call sites against one on a normal page, which is why
    // /stocky-swap/ looked like the site's strongest affiliate performer: it was
    // largely an artefact of its own instrumentation.
    //
    // The /go/* cases are removed. The direct-link case stays and is guarded,
    // because the global listener classifies a bare make.com URL as a generic
    // outbound_click rather than an affiliate_click.
    document.addEventListener('click', function(e) {
      var el = e.target.closest('a[href]');
      if (!el || typeof gtag !== 'function') return;
      var href = el.getAttribute('href') || '';
      if (href.indexOf('/go/') === 0) return; // counted globally in Base.astro
      if (href.indexOf('make.com') !== -1) {
        gtag('event', 'affiliate_click', { event_category: 'affiliate', event_label: 'make_com_stocky_swap_direct', link_url: href, post_url: window.location.pathname });
      }
    });

    // Scroll depth tracking
    var fired = {};
    window.addEventListener('scroll', function() {
      var pct = Math.round((window.scrollY / Math.max(1, document.documentElement.scrollHeight - window.innerHeight)) * 100);
      [25, 50, 75, 100].forEach(function(t) {
        if (pct >= t && !fired[t]) {
          fired[t] = true;
          if (typeof gtag === 'function') {
            gtag('event', 'scroll_depth', { event_category: 'engagement', event_label: t + '%', post_url: window.location.pathname });
          }
        }
      });
    }, { passive: true });
  })();
</script>

<StickyAffiliateCTA
  href="/go/make/"
  label="Start free on Make.com →"
  context="Stocky Swap runs on Make.com’s free tier — 1,000 ops/month, no card."
/>
</Base>

