      hasCourseInstance: {
        "@type": "CourseInstance",
        courseMode: "online",
        courseWorkload: "PT5M",
        instructor: { "@id": `${SITE_URL}/#luke` }
      },
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" }
    },
    {
      "@type": "FAQPage",
      "@id": `${PAGE_URL}#faq`,
      mainEntity: [
        {
          "@type": "Question",
          name: "What is the best free Stocky alternative in 2026?",
          acceptedAnswer: { "@type": "Answer", text: "Stocky Swap is the leading free Stocky alternative for Shopify in 2026. It logs every Shopify order to Google Sheets in real-time via a public Make.com scenario, deploys in under 5 minutes, runs on Make.com's free tier with no monthly fees, and stores all data in a Google Sheet you own. Paid alternatives like Qoblex, SKUSavvy, Sumtracker, Inventory Planner, and Prediko offer deeper forecasting features but cost between $59 and $999 per month." }
        },
        {
          "@type": "Question",
          name: "When does Shopify Stocky shut down?",
          acceptedAnswer: { "@type": "Answer", text: "Shopify Stocky shuts down permanently on August 31, 2026. Shopify removed Stocky from the App Store on February 2, 2026. After the shutdown date, the app stops functioning and Stocky's purchase order history, supplier records, stocktake data, and demand forecasts are permanently deleted. Your Shopify Admin inventory levels are not affected — only data stored inside the Stocky app." }
        },
        {
          "@type": "Question",
          name: "Is Stocky Swap actually free?",
          acceptedAnswer: { "@type": "Answer", text: "Yes. Stocky Swap is a free Make.com scenario that runs on Make.com's free tier — 1,000 credits/month (formerly called operations) at zero cost. There are no Stack Architect fees, no setup charges, and no hidden costs. Stack Architect earns a small affiliate commission if you create a new Make.com account through this page, which keeps the guides free to access." }
        },
        {
          "@type": "Question",
          name: "Do I need to know how to code to use Stocky Swap?",
          acceptedAnswer: { "@type": "Answer", text: "No coding is required. The Make.com scenario is pre-built and publicly shared — you click Clone, connect your Shopify store and a Google Sheet via OAuth, and switch the scenario on. Setup typically takes under 5 minutes. The full PDF setup guide walks through every step with screenshots." }
        },
        {
          "@type": "Question",
          name: "What does Stocky Swap log to Google Sheets?",
          acceptedAnswer: { "@type": "Answer", text: "Each new Shopify order produces a Google Sheet row containing: order ID, order timestamp, customer name, line item SKU, product name, quantity sold, line revenue, and fulfilment status. The webhook fires from Shopify the moment an order is created, so the Sheet updates within seconds." }
        },
        {
          "@type": "Question",
          name: "Will Stocky Swap interfere with my Shopify store or apps?",
          acceptedAnswer: { "@type": "Answer", text: "No. Stocky Swap is a one-way listener — it reads new order data via Shopify's webhook API and writes to your own Google Sheet. It does not modify products, inventory levels, customer records, or other Shopify data. It runs independently of Stocky and any other inventory app, so you can run it alongside Stocky as a parallel verification system before the August 31 2026 shutdown." }
        },
        {
          "@type": "Question",
          name: "What are the paid Stocky alternatives in 2026?",
          acceptedAnswer: { "@type": "Answer", text: "The paid Stocky alternatives most-cited by independent reviewers in 2026: Qoblex (multi-channel inventory and procurement, ~$99-$249/mo), SKUSavvy (mobile-first warehouse management, ~$99-$499/mo), Sumtracker (bundles and kits, ~$59-$199/mo), Inventory Planner by Sage (advanced forecasting, ~$249-$999/mo), Cin7 Core (multi-warehouse, ~$349+/mo), and Prediko (AI demand forecasting, ~$119-$499/mo). Stocky Swap is positioned for stores wanting order logging at $0 rather than full inventory accounting." }
        },
        {
          "@type": "Question",
          name: "Can Stocky Swap import my historical Stocky data?",
          acceptedAnswer: { "@type": "Answer", text: "Stocky Swap is a forward-only logger — it begins recording orders from the moment you switch it on. To preserve historical Stocky data, export your purchase orders, stocktakes, and supplier records from inside Stocky before the August 31 2026 shutdown. The Stocky data export guide on Stack Architect walks through what to save and how." }
        },
        {
          "@type": "Question",
          name: "Does Stocky Swap handle refunds, returns, or multi-location stock?",
          acceptedAnswer: { "@type": "Answer", text: "Stocky Swap is built as a forward-only order ledger — it logs every new paid Shopify order. For full inventory accounting that handles refunds, returns, and multi-location stock movements, pair Stocky Swap with native Shopify Admin inventory tracking (which manages stock-on-hand correctly across these scenarios), or use the Stack Architect Pro bundle which includes additional Make.com scenarios for refund and return handling." }
        },
        {
          "@type": "Question",
          name: "What if my store outgrows the Make.com free tier?",
          acceptedAnswer: { "@type": "Answer", text: "Make.com's free tier covers 1,000 credits/month (formerly called operations). When your order volume requires more, Make.com's Core plan starts at $9 per month for 10,000 credits — still significantly cheaper than any paid Shopify inventory app. The same Stocky Swap scenario continues to run on the higher tier without modification." }
        },
        {
          "@type": "Question",
          name: "Is Stocky Swap better than the native Shopify inventory tools?",
          acceptedAnswer: { "@type": "Answer", text: "They serve different purposes. Native Shopify Admin inventory handles stock-on-hand, transfers between locations, and basic receiving — and that's already free. Stocky Swap adds an independent, externally-owned audit log of every order in a Google Sheet you control — useful for finance reconciliation, accountant handoff, custom reporting, and as insurance against future Shopify changes. Most Shopify stores benefit from running both: native inventory for stock control, Stocky Swap for the order ledger." }
        },
        {
          "@type": "Question",
          name: "How do I migrate from Stocky to Stocky Swap?",
          acceptedAnswer: { "@type": "Answer", text: "Migration takes three phases. First, export Stocky's historical data (purchase orders, stocktakes, supplier records) before any export functions are restricted. Second, deploy Stocky Swap and run it in parallel with Stocky for at least two weeks to verify orders are logging correctly. Third, after verification, you can switch off Stocky's daily use and rely on Stocky Swap as your forward order ledger. The full migration playbook is on the Stack Architect Stocky shutdown page." }
        },
        {
          "@type": "Question",
          name: "What is the cheapest Stocky alternative for Shopify?",
          acceptedAnswer: { "@type": "Answer", text: "Stocky Swap at $0 per month is the cheapest Stocky alternative for Shopify in 2026. It runs on Make.com's free tier with no Stack Architect fees. The next cheapest paid options start at approximately $9 per month for Make.com Core (if you outgrow free) or around $59 per month for entry-tier paid Shopify inventory apps like Sumtracker." }
        },
        {
          "@type": "Question",
          name: "Can I use Stocky Swap with multiple Shopify stores?",
          acceptedAnswer: { "@type": "Answer", text: "Yes. Each Shopify store needs its own Make.com webhook connection, but the Stocky Swap scenario can be cloned and configured separately per store. Multi-store operators typically point each store's webhook to a separate tab or sheet within one master Google Sheets workbook for unified reporting. Note that Make.com free tier operations are counted across all your scenarios — high multi-store volume may require upgrading to Make.com Core." }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
        { "@type": "ListItem", position: 2, name: "Stocky Swap", item: PAGE_URL }
      ]
    }
