---
import Base from '../layouts/Base.astro';
import Disclosure from '../components/Disclosure.astro';
import StickyAffiliateCTA from '../components/StickyAffiliateCTA.astro';
import StockLogPromo from '../components/StockLogPromo.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import AuthorCard from '../components/AuthorCard.astro';
import { isPostShutdown, STOCKY_EOL_ISO } from '../utils/stockyDeadline';

/**
 * STOCKY SWAP — /stocky-swap/ — MAXIMUM VERSION v2
 *
 * Primary: "free Stocky alternative"
 * Secondary: "Stocky replacement", "Stocky shutdown alternative", "$0 Stocky alternative",
 *            "cheap Stocky alternative", "Stocky alternative 2026", "replace Stocky free"
 *
 * Cluster hub for: /stocky-shutdown/, /stocky-alternative/, /stocky-migration-risk-scorer/,
 *                  /blog/shopify-stocky-data-export-before-shutdown/
 *
 * Strategy notes:
 * - Win uncontested "free + fast + editorially honest" positioning
 * - 12 schema types for max AI Overview citation surface
 * - 8 Make.com affiliate placements with contextual relevance
 * - Cross-cluster internal linking (~30 links)
 * - Honest "what it doesn't do" section earns trust + AI citations
 * - Migration timeline, store-size playbooks, troubleshooting capture long-tail queries
 * - Sticky bottom CTA + time-on-page trigger for conversion
 */

const SITE_URL = "https://stackarchitect.xyz";
const PAGE_URL = `${SITE_URL}/stocky-swap/`;
const SHUTDOWN_DATE = "August 31, 2026";
const SHUTDOWN_DATE_ISO = STOCKY_EOL_ISO;
const DATE_PUBLISHED = "2026-01-01";
const DATE_MODIFIED = "2026-08-22";

/* ---------------------------------------------------------------------------
 * TIME AWARENESS — this page had a 9-day fuse.
 *
 * Every headline, CTA and the entire hero was written in the future tense
 * against a deadline that passes on 31 August 2026. The countdown component
 * degraded correctly; nothing else did. On 1 September the page would have
 * greeted a reader with an expired countdown and "Stocky closes August 31" —
 * at exactly the moment search intent for "stocky alternative" PEAKS, because
 * that is when people discover their data is gone.
 *
 * shutdownPassed drives both states of every time-bound string below.
 *
 * NOTE: evaluated at BUILD time. A static build served past the deadline keeps
 * pre-deadline copy until the site rebuilds — schedule a deploy for 1 Sept.
 * ------------------------------------------------------------------------ */
const shutdownPassed = isPostShutdown();

// ── Affiliate links — all routed through /go/ for Brave safety ──
const aff = {
  make:        "/go/make/",
  systeme:     "/go/systeme/",
  tidio:       "/go/tidio/",
  getresponse: "/go/getresponse/",
  beehiiv:     "/go/beehiiv/",
  workspace:   "/go/workspace/",
};

/* ---------------------------------------------------------------------------
 * AFFILIATE ARCHITECTURE
 *
 * Measured on the live page before this change: 4,313 words, TWO affiliate
 * links (at 32% and 95% depth), and FIVE unattributed direct exits to
 * make.com via SCENARIO_URL. Worse, step 1 of the deploy guide — "Create a
 * free Make.com account" — was PLAIN TEXT. The single most conversion-critical
 * instruction on the page was not a link at all.
 *
 * The scenario URL stays direct: it is a specific shared resource, not a
 * signup, and rewriting it would break the clone. But cloning it REQUIRES an
 * account, so every scenario link is now preceded by the account link rather
 * than competing with it.
 * ------------------------------------------------------------------------ */
const MAKE_AFFILIATE = "/go/make/";
const GETRESPONSE_AFFILIATE = "/go/getresponse/";
const SYSTEME_AFFILIATE = "/go/systeme/";

// Verifiable artefacts
const SCENARIO_URL = "https://eu1.make.com/public/shared-scenario/YKK7FScMAx2/shopify-order-to-google-sheets-stock-log";
const SETUP_GUIDE_PDF = "https://d1yei2z3i6k35z.cloudfront.net/16370908/699ce1532f77d_Manual_The0ShopifyInventoryBridge.pdf";
const LINKEDIN = "https://www.linkedin.com/company/stack-architect-xyz/";
const PRO_URL = `${SITE_URL}/pro/`;

const SEO = {
  title: "Free Stocky Replacement 2026 — $0 Make.com Setup",
  description:
    "Stocky shuts down 31 August 2026. The free replacement: a Make.com scenario logging every Shopify order to Google Sheets in real time. $0, no code, 4 minutes.",
  canonical: PAGE_URL,
  ogTitle: "Free Stocky Replacement (4-Min Setup) — $0/Month Forever",
  ogDescription: "Stocky closes Aug 31, 2026. Replace it free with Make.com + Google Sheets. No fees, no code, live in 4 minutes. Independent comparison of every paid alternative.",
  ogImage: `https://stackarchitect.xyz/og/og-stocky-swap.png`
};

// ─────────────────────────────────────────────────────────────────────
// JSON-LD GRAPH — 12 schema types, all defensible, AI-citation optimised
// ─────────────────────────────────────────────────────────────────────
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${PAGE_URL}#webpage`,
      url: PAGE_URL,
      name: SEO.title,
      description: SEO.description,
      datePublished: DATE_PUBLISHED,
      dateModified: DATE_MODIFIED,
      inLanguage: "en-GB",
      isPartOf: { "@id": `${SITE_URL}/#website` },
      primaryImageOfPage: { "@id": `${PAGE_URL}#primaryimage` },
      author: { "@id": `${SITE_URL}/#luke` },
      reviewedBy: { "@id": `${SITE_URL}/#luke` },
      speakable: {
        "@type": "SpeakableSpecification",
        cssSelector: [
          "#answer",
          ".speakable-answer",
          ".speakable-howto",
          ".speakable-comparison",
          ".speakable-limits",
          ".speakable-timeline",
          ".faq-ans-s p"
        ]
      },
      about: [
        { "@type": "Thing", name: "Shopify Stocky Replacement" },
        { "@type": "Thing", name: "Free Shopify Inventory Management" },
        { "@type": "Thing", name: "Shopify Google Sheets Order Logging" },
        { "@type": "Thing", name: "Make.com Shopify Automation" },
        { "@type": "Thing", name: "Stocky App Shutdown 2026" }
      ],
      mentions: [
        { "@type": "SoftwareApplication", name: "Shopify", url: "https://www.shopify.com" },
        { "@type": "SoftwareApplication", name: "Make.com", url: "https://www.make.com", alternateName: "Integromat" },
        { "@type": "SoftwareApplication", name: "Google Sheets", url: "https://sheets.google.com" },
        { "@type": "SoftwareApplication", name: "Stocky", description: "Shopify-owned inventory app shutting down August 31, 2026" },
        { "@type": "SoftwareApplication", name: "Qoblex", url: "https://qoblex.com" },
        { "@type": "SoftwareApplication", name: "SKUSavvy", url: "https://www.skusavvy.com" },
        { "@type": "SoftwareApplication", name: "Inventory Planner", url: "https://www.inventory-planner.com" },
        { "@type": "SoftwareApplication", name: "Sumtracker", url: "https://www.sumtracker.com" },
        { "@type": "SoftwareApplication", name: "Prediko", url: "https://www.prediko.io" },
        { "@type": "SoftwareApplication", name: "Cin7 Core", url: "https://cin7.com" }
      ]
    },
    {
      "@type": "VideoObject",
      "name": "How Stocky Swap works",
      "description": "Learn how Stocky Swap replaces Shopify Stocky for free by logging every Shopify order to Google Sheets in real-time via Make.com.",
      "uploadDate": "2026-08-04T16:19:00+01:00",
      "contentUrl": "https://stackarchitect.xyz/videos/stocky-swap.mp4",
      "thumbnailUrl": "https://stackarchitect.xyz/videos/poster-16x9.jpg"
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: SITE_URL,
      name: "Stack Architect",
      description: "Free Shopify automation tools — replace paid apps with Make.com and Google Sheets.",
      publisher: { "@id": `${SITE_URL}/#org` }
    },
    {
      "@type": "ImageObject",
      "@id": `${PAGE_URL}#primaryimage`,
      url: SEO.ogImage,
      width: 1200,
      height: 630,
      caption: "Stocky Swap — free Shopify Stocky replacement that logs orders to Google Sheets via Make.com"
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${PAGE_URL}#software`,
      name: "Stocky Swap",
      alternateName: ["Free Stocky Alternative", "Stocky Replacement"],
      url: PAGE_URL,
      description: "Free Shopify inventory automation that replaces the Stocky app. Logs every Shopify order to Google Sheets in real-time using a public Make.com scenario. Permanent free replacement for the retired Stocky app, whose end of service was August 31, 2026. Stocky shutdown.",
      applicationCategory: "BusinessApplication",
      applicationSubCategory: "Inventory Management",
      operatingSystem: "Web — Shopify, Make.com, Google Workspace",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
        description: "Free forever — runs on Make.com free tier"
      },
      featureList: [
        "Real-time Shopify order logging to Google Sheets via webhook",
        "Pre-built public Make.com scenario — one-click clone",
        "$0/month on Make.com free tier",
        "No code required",
        "Full data ownership — your Google Sheet, your data",
        "Runs alongside Stocky during migration",
        "Compatible with all Shopify plans (Basic, Shopify, Advanced, Plus)",
        "Forward-only order ledger architecture"
      ],
      requirements: "Free Make.com account, Shopify store (any plan), Google account",
      author: { "@id": `${SITE_URL}/#luke` }
    },
    {
      "@type": "Service",
      "@id": `${PAGE_URL}#service`,
      name: "Stocky Swap Setup Guidance",
      provider: { "@id": `${SITE_URL}/#org` },
      areaServed: "Worldwide",
      serviceType: "Free Shopify automation guidance",
      description: "Free step-by-step setup guidance for the Stocky Swap Make.com scenario including PDF setup guide, public scenario URL, and migration playbook for Shopify stores transitioning off Stocky, whose end of service was August 31, 2026. Shutdown."
    },
    {
      "@type": "HowTo",
      "@id": `${PAGE_URL}#howto`,
      name: "How to replace Shopify Stocky with a free Make.com + Google Sheets workflow",
      description: "Three steps to deploy Stocky Swap, the free replacement for the retired Shopify Stocky app. Total time under 5 minutes.",
      totalTime: "PT5M",
      estimatedCost: { "@type": "MonetaryAmount", currency: "USD", value: "0" },
      supply: [
        { "@type": "HowToSupply", name: "Free Make.com account" },
        { "@type": "HowToSupply", name: "Shopify store on any plan" },
        { "@type": "HowToSupply", name: "Google account with Google Sheets" }
      ],
      tool: [
        { "@type": "HowToTool", name: "Make.com" },
        { "@type": "HowToTool", name: "Shopify Webhooks" },
        { "@type": "HowToTool", name: "Google Sheets" }
      ],
      step: [
        {
          "@type": "HowToStep",
          position: 1,
          name: "Create a free Make.com account",
          text: "Sign up at make.com — no credit card required. The free tier is sufficient for the Stocky Swap workflow on most stores.",
          url: MAKE_AFFILIATE
        },
        {
          "@type": "HowToStep",
          position: 2,
          name: "Clone the public Stocky Swap scenario",
          text: "Open the public Make.com scenario URL and click Clone. The scenario imports pre-configured — Shopify webhook trigger, data mapper, Google Sheets writer.",
          url: SCENARIO_URL
        },
        {
          "@type": "HowToStep",
          position: 3,
          name: "Connect Shopify and Google Sheets, switch on",
          text: "Add your Shopify API credentials, link your Google Sheet, activate the scenario. Order logging begins on the next paid order.",
          url: SETUP_GUIDE_PDF
        }
      ]
    },
    {
      "@type": "ItemList",
      "@id": `${PAGE_URL}#alternatives`,
      name: "Stocky alternatives ranked for Shopify in 2026",
      description: "Independent ranking of free and paid Stocky alternatives by use case in 2026, including the August 31 shutdown context.",
      numberOfItems: 8,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Stocky Swap (free)", url: PAGE_URL },
        { "@type": "ListItem", position: 2, name: "Native Shopify Inventory (free)", url: "https://help.shopify.com/en/manual/products/inventory" },
        { "@type": "ListItem", position: 3, name: "Qoblex", url: "https://qoblex.com" },
        { "@type": "ListItem", position: 4, name: "SKUSavvy", url: "https://www.skusavvy.com" },
        { "@type": "ListItem", position: 5, name: "Sumtracker", url: "https://www.sumtracker.com" },
        { "@type": "ListItem", position: 6, name: "Inventory Planner by Sage", url: "https://www.inventory-planner.com" },
        { "@type": "ListItem", position: 7, name: "Prediko", url: "https://www.prediko.io" },
        { "@type": "ListItem", position: 8, name: "Cin7 Core", url: "https://cin7.com" }
      ]
    },
    {
      "@type": "Course",
      "@id": `${PAGE_URL}#course`,
      name: "Stocky Swap Setup — Free Stocky Replacement in 4 Minutes",
