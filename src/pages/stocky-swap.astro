---
<Base title={SEO.title} description={SEO.description}>
<Fragment slot="head">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --g: #34d377; --g-dim: #15803d; --g-bg: rgba(52,211,119,.08); --g-border: rgba(52,211,119,.2);
      --bg: #0c0f0d; --bg-2: #0f1311; --bg-3: #121614; --bg-4: #171c19;
      --border: #222825; --border-2: #2f3733;
      /* --text-4 was #6b7671 — 4.09:1 on --bg, a WCAG AA fail, and it carries
         the mono micro-labels at 11-12px. #7f8b85 measures 5.45:1 and stays
         visibly dimmer than --text-3, so the hierarchy survives. Matches the
         homepage fix. */
      --text: #f2f5f3; --text-2: #b6c0ba; --text-3: #93a09a; --text-4: #7f8b85; --text-inv: #0c0f0d;
      --red: #f08a8a; --red-bg: rgba(240,138,138,.07); --red-border: rgba(240,138,138,.18);
      --sky: #8ccfe8; --sky-bg: rgba(140,207,232,.07); --sky-border: rgba(140,207,232,.18);
      --amber: #f5b64d; --amber-bg: rgba(245,182,77,.06); --amber-border: rgba(245,182,77,.2);
      --vio: #c3b8ef; --vio-bg: rgba(195,184,239,.07); --vio-border: rgba(195,184,239,.2);
      --mono: 'JetBrains Mono', monospace; --sans: 'Inter', -apple-system, sans-serif;
      --radius: 6px; --shadow-g: 0 8px 28px rgba(52,211,119,.3);

      /* Type scale. This file carried 75 font-size declarations and zero
         tokens, competing with the --text-body:17px scale global.css declares
         and asks not to be overridden per-element. Six steps; running prose
         sits at --fs-body, which equals the system's 17px. */
      --fs-micro: 11px; --fs-sm: 13px; --fs-md: 15px;
      --fs-body: 17px;  --fs-lg: 22px; --fs-xl: 34px;

      /* ── BRAND KIT ────────────────────────────────────────────────────
         Lifted from the Stack Architect logo and OG card: a graduated green
         ramp (the four stacked bars run light -> saturated), a cooler
         near-black ground, and the dot-grid texture the OG card sits on.
         The single --g the page used flattens a brand that is explicitly
         built on tonal steps. */
      --g-100: #86efac;   /* top bar — lightest */
      --g-200: #4ade80;
      --g-400: #34d377;   /* == --g, the primary */
      --g-600: #16a34a;   /* base bar — deepest */
      --ink-900: #080b0a; /* cooler than --bg, for wells and insets */

      --grid-dot: rgba(52,211,119,.055);
      --grid-line: rgba(255,255,255,.022);
      --glow-g: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(52,211,119,.10) 0%, transparent 70%);
      --edge: inset 0 1px 0 rgba(255,255,255,.04);
    }
    html { scroll-behavior: smooth; }
    body { font-family: var(--sans); background: var(--bg); color: var(--text-3); line-height: 1.75; -webkit-font-smoothing: antialiased; overflow-x: hidden; padding-bottom: 0; }
    ::selection { background: rgba(52,211,119,.2); color: var(--text); }
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: rgba(52,211,119,.3); border-radius: 2px; }
    a { text-decoration: none; color: inherit; }

    .skip-link { position: absolute; left: -9999px; top: auto; width: 1px; height: 1px; overflow: hidden; background: var(--g); color: var(--text-inv); padding: 12px 20px; border-radius: 4px; font-weight: 700; z-index: 99999; }
    .skip-link:focus { position: fixed; top: 16px; left: 16px; width: auto; height: auto; }

    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; font-family: var(--sans); font-size: var(--fs-md); font-weight: 700; text-decoration: none; letter-spacing: -.01em; padding: 16px 32px; border-radius: var(--radius); border: none; cursor: pointer; white-space: nowrap; background: var(--g); color: var(--text-inv); transition: background .2s, transform .15s, box-shadow .2s; min-height: 52px; }
    .btn:hover { background: #45e28a; transform: translateY(-2px); box-shadow: var(--shadow-g); }
    .btn.pulse { animation: btnGlow 2.8s ease-in-out infinite; }
    @keyframes btnGlow { 0%,100% { box-shadow: 0 0 16px rgba(52,211,119,.1); } 50% { box-shadow: 0 0 28px rgba(52,211,119,.28); } }
    .btn-sm { font-size: var(--fs-md); padding: 12px 22px; min-height: 44px; }
    .btn-outline { display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-family: var(--sans); font-size: var(--fs-md); font-weight: 600; text-decoration: none; padding: 15px 28px; border-radius: var(--radius); border: 1.5px solid var(--border-2); background: transparent; color: var(--text-2); transition: border-color .2s, color .2s, background .2s; min-height: 52px; }
    .btn-outline:hover { border-color: var(--g); color: var(--g); background: var(--g-bg); }

    .section { padding: 80px 24px; }
    .section-alt { padding: 80px 24px; background: var(--bg-2); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .inner { max-width: 1000px; margin: 0 auto; }
    .inner-md { max-width: 860px; margin: 0 auto; }
    .inner-sm { max-width: 720px; margin: 0 auto; }
    .sec-head { text-align: center; margin-bottom: 48px; }
    .sec-head h2 { font-family: var(--sans); font-weight: 700; font-size: clamp(26px, 4vw, 40px); letter-spacing: -.03em; color: var(--text); line-height: 1.1; margin-bottom: 12px; }
    .sec-head p { font-size: var(--fs-md); color: var(--text-3); max-width: 580px; margin: 0 auto; line-height: 1.7; }

    .urgency-banner { width: 100%; background: linear-gradient(90deg, #7f1d1d, #991b1b, #7f1d1d); padding: 12px 24px; text-align: center; font-family: var(--mono); font-size: var(--fs-micro); font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; color: #fca5a5; border-bottom: 1px solid rgba(255,100,100,.3); display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap; }
    .urgency-banner strong { color: #fff; }
    .dot-red { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--red); animation: dotRed 1.5s ease-in-out infinite; }
    @keyframes dotRed { 0%,100% { opacity: 1; } 50% { opacity: .3; } }

    .crumb { background: var(--bg-2); border-bottom: 1px solid var(--border); padding: 10px 24px; }
    .crumb-inner { max-width: 1100px; margin: 0 auto; }
    .crumb ol { display: flex; align-items: center; gap: 8px; list-style: none; font-family: var(--mono); font-size: var(--fs-micro); color: var(--text-4); text-transform: uppercase; letter-spacing: .08em; }
    .crumb a { color: var(--text-4); transition: color .15s; }
    .crumb a:hover { color: var(--g); }
    .crumb .current { color: var(--sky); }
    .crumb .sep { opacity: .4; }

    /* ══════════════════════════════════════════════════════════════════════
     * HERO v4 — asymmetric two-column
     *
     * v3 stacked eight centred blocks down a 920px column: meta, H1, answer,
     * table of contents, sub, countdown, two CTAs, a note, a disclosure, an
     * author pill, then the video. Measured at 1440x1200 the fold carried the
     * H1 and roughly two paragraphs, the CTAs sat at ~880px, and the video —
     * the only thing on the page that demonstrates the product — was entirely
     * below it. Centred text also gives every line a different left edge, so
     * nothing anchors the eye.
     *
     * v4 splits the hero: the argument runs down a left rail with one shared
     * left edge, and the urgency module (countdown + what-you-lose) and the
     * video sit in a right panel. Both CTAs and the video now share the fold.
     * The table of contents moves out of the hero to the section below it.
     * ═════════════════════════════════════════════════════════════════════ */
    .hero { padding: 52px 24px 64px; text-align: left; position: relative; overflow: hidden; }
    .hero-inner { max-width: 1180px; margin: 0 auto; position: relative; }
    /* Three areas, not two columns. The argument spans both rows on the left;
       the urgency module and the media block stack on the right. Splitting
       them lets mobile reorder — where the lede is ~975px tall and nothing in
       the panel makes the fold either way, the video is worth more than a
       second countdown, because a live countdown is already pinned to the top
       of every viewport in `.urgency-banner`. */
    .hero-grid {
      display: grid; align-items: start; gap: 22px 56px;
      grid-template-columns: minmax(0, 1.04fr) minmax(0, .96fr);
      grid-template-areas: "lede urgency" "lede media";
      grid-template-rows: auto 1fr;
    }
    .hero-lede { grid-area: lede; }
    .hero-urgency { grid-area: urgency; }
    .hero-media { grid-area: media; }

    /* A green bloom behind the right panel, off-centre so the composition has
       a light source rather than a symmetrical halo. */
    .hero::after {
      content: ''; position: absolute; inset: -20% 0 auto 0; height: 90%;
      background: radial-gradient(ellipse 46% 60% at 74% 22%, rgba(52,211,119,.11) 0%, transparent 68%);
      pointer-events: none; z-index: 0;
    }
    .hero > * { position: relative; z-index: 1; }

    .hero-eyebrow {
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
      font-family: var(--mono); font-size: var(--fs-micro); color: var(--text-4);
      letter-spacing: .12em; text-transform: uppercase; margin-bottom: 22px;
    }
    .hero-eyebrow .stack-mark { margin-right: 2px; }
    .hero-eyebrow .sep { opacity: .35; }
    .hero-eyebrow .lead { color: var(--g); }

    .hero h1 { font-size: clamp(38px, 4.9vw, 64px); font-weight: 700; color: var(--text); line-height: 1.0; letter-spacing: -.045em; margin: 0 0 22px; max-width: 16ch; }
    .hero h1 .green { color: var(--g); }
    .hero h1 .dim { color: var(--text-4); }

    /* The speakable/AI-citation answer. Given the green rail so it reads as a
       deliberate definition rather than the second of several paragraphs. */
    #answer {
      font-size: var(--fs-body); color: var(--text-2); line-height: 1.72;
      max-width: 58ch; margin: 0 0 28px; padding-left: 18px;
      border-left: 2px solid var(--g-600); text-align: left;
    }

    .hero-sub { font-size: var(--fs-md); color: var(--text-3); margin: 0 0 22px; line-height: 1.65; }
    .hero-sub strong { color: var(--text-2); font-weight: 600; }
    .hero-ctas { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-start; gap: 12px; margin-bottom: 14px; }

    .bg-grid { background-color: var(--bg); background-image: radial-gradient(ellipse 80% 40% at 50% 0%, rgba(52,211,119,.06) 0%, transparent 60%), radial-gradient(circle, var(--border) 1px, transparent 1px); background-size: 100% 100%, 44px 44px; }

    /* ── Urgency module ──────────────────────────────────────────────────
       Digits moved into individual wells on the cooler --ink-900 ground.
       The old build was one amber box with four inline numbers at 22px and
       colons between them; at panel width the digits now carry real weight,
       which is the point of putting a clock on the page at all. */
    .countdown-strip {
      position: relative; overflow: hidden;
      background: linear-gradient(180deg, rgba(245,182,77,.075) 0%, rgba(245,182,77,.015) 100%);
      border: 1px solid var(--amber-border); border-radius: 14px;
      padding: 18px 20px 20px; margin: 0 0 22px; max-width: none; text-align: left;
      box-shadow: var(--edge);
    }
    .countdown-strip::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, var(--amber) 0%, rgba(245,182,77,.15) 60%, transparent 100%);
    }
    .countdown-label { display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: var(--fs-micro); font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--amber); margin-bottom: 14px; }
    .countdown-nums { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .cd-unit { text-align: center; background: var(--ink-900); border: 1px solid rgba(245,182,77,.14); border-radius: 10px; padding: 13px 4px 11px; box-shadow: var(--edge); }
    .cd-val { font-family: var(--mono); font-size: clamp(24px, 2.6vw, 34px); font-weight: 700; color: var(--text); line-height: 1; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
    .cd-l { font-size: var(--fs-micro); color: var(--text-4); margin-top: 7px; font-family: var(--mono); letter-spacing: .1em; text-transform: uppercase; }
    .cd-sep { display: none; }

    /* ── Hero video ──────────────────────────────────────────────────────
       These rules did not exist in this file. `.hero-video-glow` was an empty
       unstyled div and `.hero-video-box` had no aspect ratio, so the only
       thing holding the video together was global.css's `video { max-width:
       100% }`. It rendered as a bare black rectangle with no frame, no glow
       and no reserved space — a layout shift on every load. Ported from the
       homepage and retuned for the narrower panel. */
    .hero-video-wrap { position: relative; margin: 0; }
    /* Sized to the box's 16:9 box, not to the wrapper — the wrapper also
       contains the caption, so `inset: -1px` painted a green haze straight
       across the caption text. */
    .hero-video-glow {
      position: absolute; top: -1px; left: -1px; right: -1px; bottom: auto;
      height: 0; padding-bottom: calc(56.25% + 2px);
      border-radius: 17px; z-index: 0; filter: blur(2px);
      background: linear-gradient(140deg, rgba(52,211,119,.5) 0%, rgba(52,211,119,.16) 45%, rgba(52,211,119,.04) 100%);
    }
    .hero-video-box {
      position: relative; z-index: 1; padding-bottom: 56.25%; height: 0; overflow: hidden;
      border-radius: 16px; border: 1px solid rgba(52,211,119,.22); background: var(--ink-900);
      box-shadow: 0 28px 64px -22px rgba(0,0,0,.75), var(--edge);
    }
    .hero-video-box video { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; border-radius: 16px; object-fit: contain; background: #000; }
    .hero-video-caption { font-family: var(--mono); font-size: var(--fs-micro); letter-spacing: .1em; text-transform: uppercase; color: var(--text-4); margin-top: 12px; text-align: center; }

    /* Left rail: everything shares one left edge. The disclosure and author
       pill were both centred with auto margins, which is what made the column
       read as a stack of unrelated centred blocks. */
    .hero .aff-note { margin: 12px 0 0; max-width: 62ch; text-align: left; }
    .hero .hero-ctas-note { margin: 14px 0 0; }
    .hero .author-line { margin: 26px 0 0; max-width: max-content; }

    /* Proof cells docked under the video. They used to open the section below
       the hero; here they close the media block and put the four numbers a
       visitor is actually shopping on inside the first screen. */
    .hero-media .trust-strip { margin-top: 20px; max-width: none; }
    .hero-media .trust-cell { padding: 15px 8px; }

    @media (max-width: 980px) {
      .hero-grid {
        grid-template-columns: 1fr; gap: 40px;
        grid-template-areas: "lede" "media" "urgency";
        grid-template-rows: auto;
      }
      .hero h1 { max-width: 18ch; }
      .hero-urgency, .hero-media { max-width: 640px; }
    }
    @media (max-width: 640px) {
      .hero h1 { max-width: none; letter-spacing: -.035em; }
      /* Slashes strand at the end of a wrapped line; column gap separates. */
      .hero-eyebrow { gap: 6px 14px; }
      .hero-eyebrow .sep { display: none; }
      #answer { padding-left: 14px; }
      .countdown-nums { gap: 6px; }
      .cd-unit { padding: 11px 2px 9px; }
      .cd-val { font-size: 24px; }
      .cd-l { font-size: 10px; letter-spacing: .05em; }
      .hero .author-line { max-width: 100%; }
    }

    .speakable-answer { background: var(--bg-3); border: 1px solid var(--border-2); border-left: 3px solid var(--g); border-radius: 8px; padding: 22px 26px; margin: 32px auto; max-width: 760px; text-align: left; }
    .speakable-answer .label { font-family: var(--mono); font-size: var(--fs-micro); font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--g); margin-bottom: 10px; }
    .speakable-answer p { font-size: var(--fs-md); color: var(--text-2); line-height: 1.7; margin: 0; }
    .speakable-answer p strong { color: var(--text); }

    .trust-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; max-width: 760px; margin: 0 auto; }
    .trust-cell { background: var(--bg); padding: 18px 12px; text-align: center; }
    .trust-v { font-family: var(--mono); font-size: var(--fs-body); font-weight: 700; color: var(--g); line-height: 1; }
    .trust-l { font-size: var(--fs-micro); color: var(--text-4); text-transform: uppercase; letter-spacing: .1em; margin-top: 6px; font-family: var(--mono); }
    @media (max-width: 640px) { .trust-strip { grid-template-columns: repeat(2,1fr); } }

    .body-text { max-width: 760px; margin: 0 auto; }
    .body-text p { font-size: var(--fs-body); color: var(--text-3); line-height: 1.8; margin-bottom: 18px; text-align: left; }
    .body-text p strong { color: var(--text-2); font-weight: 600; }
    .body-text p a { color: var(--g); text-decoration: underline; }
    .body-text h3 { font-weight: 800; font-size: clamp(20px, 2.8vw, 24px); color: var(--text); letter-spacing: -.02em; line-height: 1.2; margin: 36px 0 14px; text-align: left; }
    .body-text h4 { font-weight: 700; font-size: var(--fs-body); color: var(--text-2); letter-spacing: -.01em; margin: 24px 0 10px; }
    .body-text ul { list-style: none; padding: 0; margin: 0 0 22px; }
    .body-text ul li { position: relative; padding: 10px 0 10px 26px; font-size: var(--fs-md); color: var(--text-3); line-height: 1.65; border-bottom: 1px solid var(--border); }
    .body-text ul li::before { content: "→"; position: absolute; left: 0; top: 10px; color: var(--g); font-weight: 700; }
    .body-text ul li:last-child { border-bottom: none; }
    .body-text ul li strong { color: var(--text-2); }

    /* ── Scope ledger ────────────────────────────────────────────────────
       In-scope / out-of-scope as two panels. Selectors are prefixed with
       .body-text so they outrank `.body-text ul li`, which would otherwise
       stamp a green "→" on the out-of-scope column too. */
    .scope { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 4px 0 8px; align-items: start; }
    .scope-col { position: relative; overflow: hidden; background: var(--bg-2); border: 1px solid var(--border); border-radius: 14px; padding: 24px 24px 18px; box-shadow: var(--edge); }
    .scope-col::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; }
    .scope-yes::before { background: linear-gradient(90deg, var(--g-100) 0%, var(--g-400) 45%, var(--g-600) 100%); }
    .scope-no::before { background: linear-gradient(90deg, #56615c 0%, #2c3330 100%); }
    .body-text .scope-col h3 { margin: 0 0 6px; font-size: var(--fs-lg); }
    .scope-tag { display: block; font-family: var(--mono); font-size: var(--fs-micro); font-weight: 600; letter-spacing: .13em; text-transform: uppercase; margin-bottom: 14px; }
    .scope-yes .scope-tag { color: var(--g); }
    .scope-no .scope-tag { color: var(--text-4); }
    .body-text .scope-col ul { margin: 0; }
    .body-text .scope-col li { padding: 11px 0 11px 26px; border-bottom: none; border-top: 1px solid var(--border); }
    .body-text .scope-col li:first-child { border-top: none; padding-top: 2px; }
    .body-text .scope-col li strong { color: var(--text); font-weight: 600; }
    .body-text .scope-col li::before { font-family: var(--mono); font-weight: 700; top: 11px; }
    .body-text .scope-col li:first-child::before { top: 2px; }
    .body-text .scope-yes li::before { content: "+"; color: var(--g); }
    .body-text .scope-no li::before { content: "–"; color: var(--text-4); }
    @media (max-width: 860px) { .scope { grid-template-columns: 1fr; gap: 14px; } }

    /* min-width:0 is load-bearing. A grid/flex child defaults to min-width:auto,
       which refuses to shrink below its content — so this scroll container never
       actually constrained the 720px table and the whole document scrolled
       sideways on mobile instead. */
    .comp-wrap { overflow-x: auto; min-width: 0; max-width: 100%; margin: 24px 0; border-radius: 12px; border: 1px solid var(--border); }
    .comp-table { width: 100%; border-collapse: collapse; min-width: 720px; }
    .comp-table th, .comp-table td { padding: 14px 16px; text-align: left; border-bottom: 1px solid var(--border); font-size: var(--fs-md); }
    .comp-table th { font-family: var(--mono); font-size: var(--fs-micro); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--text-4); background: rgba(255,255,255,.025); }
    .comp-table td { color: var(--text-3); }
    .comp-table tr:last-child td { border-bottom: none; }
    .comp-table .row-tool { font-weight: 700; color: var(--text); }
    .comp-table .row-tool .sub { font-weight: 400; font-size: var(--fs-micro); color: var(--text-4); display: block; margin-top: 2px; }
    .comp-table .win { color: var(--g); font-weight: 600; }
    .comp-table .neutral { color: var(--text-3); }
    .comp-table .miss { color: var(--text-4); }
    .comp-table tr.highlight td { background: rgba(52,211,119,.04); }
    .comp-table tr.highlight .row-tool { color: var(--g); }

    .step-cards { display: flex; flex-direction: column; gap: 14px; margin: 24px 0; }
    .step-card { background: var(--bg-3); border: 1px solid var(--border); border-radius: 10px; padding: 22px 24px; display: flex; gap: 18px; align-items: flex-start; }
    .step-num { width: 32px; height: 32px; min-width: 32px; border-radius: 50%; background: rgba(52,211,119,.1); border: 1px solid rgba(52,211,119,.25); display: flex; align-items: center; justify-content: center; font-family: var(--mono); font-size: var(--fs-sm); font-weight: 700; color: var(--g); flex-shrink: 0; }
    .step-title { font-size: var(--fs-md); font-weight: 700; color: var(--text); margin-bottom: 4px; }
    .step-desc { font-size: var(--fs-md); color: var(--text-3); line-height: 1.65; }
    .step-desc a { color: var(--g); text-decoration: underline; }
    .step-tool { font-family: var(--mono); font-size: var(--fs-micro); color: var(--text-4); background: rgba(255,255,255,.03); border: 1px solid var(--border); padding: 3px 8px; border-radius: 3px; display: inline-block; margin-top: 8px; }

    .callout { background: var(--bg-3); border: 1px solid var(--border-2); border-radius: 10px; padding: 22px 24px; margin: 24px 0; border-left: 3px solid var(--g); text-align: left; }
    .callout.warn { border-left-color: var(--amber); background: var(--amber-bg); }
    .callout.info { border-left-color: var(--sky); background: var(--sky-bg); }
    .callout.purple { border-left-color: var(--vio); background: var(--vio-bg); }
    .callout-label { font-family: var(--mono); font-size: var(--fs-micro); font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--g); margin-bottom: 8px; }
    .callout.warn .callout-label { color: var(--amber); }
    .callout.info .callout-label { color: var(--sky); }
    .callout.purple .callout-label { color: var(--vio); }
    .callout p { font-size: var(--fs-md); color: var(--text-2); line-height: 1.7; margin: 0; }
    .callout p + p { margin-top: 10px; }
    .callout p strong { color: var(--text); }
    .callout p a { color: var(--g); text-decoration: underline; }

    .section-cta { background: rgba(52,211,119,.06); border: 1.5px solid rgba(52,211,119,.2); border-radius: 12px; padding: 28px 32px; margin: 36px 0; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    .section-cta-text h4 { font-weight: 800; font-size: var(--fs-body); color: var(--text); margin-bottom: 4px; line-height: 1.3; }
    .section-cta-text p { font-size: var(--fs-sm); color: var(--text-3); margin: 0; }
    @media (max-width: 600px) { .section-cta { flex-direction: column; align-items: flex-start; } .section-cta .btn { width: 100%; justify-content: center; } }

    .aff-note { font-size: var(--fs-sm); color: var(--text-4); font-style: italic; margin: 10px auto 0; max-width: 540px; text-align: center; line-height: 1.6; }
    .aff-note a { color: var(--text-3); text-decoration: underline; }

    .author-line { display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 32px; padding: 14px 22px; background: rgba(255,255,255,.02); border: 1px solid var(--border); border-radius: 100px; max-width: 460px; margin-left: auto; margin-right: auto; }
    .author-avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--g-bg); border: 1px solid var(--g-border); display: flex; align-items: center; justify-content: center; font-family: var(--mono); font-weight: 800; color: var(--g); font-size: var(--fs-sm); }
    .author-text { font-size: var(--fs-sm); color: var(--text-3); line-height: 1.4; text-align: left; }
    .author-text strong { color: var(--text-2); font-weight: 600; }
    .author-text a { color: var(--text-3); text-decoration: underline; }

    .timeline { position: relative; margin: 32px 0; padding-left: 24px; border-left: 2px solid var(--border); }
    .timeline-item { position: relative; padding: 0 0 28px 28px; }
    .timeline-item:last-child { padding-bottom: 0; }
    .timeline-item::before { content: ""; position: absolute; left: -33px; top: 4px; width: 16px; height: 16px; border-radius: 50%; background: var(--bg); border: 2px solid var(--g); }
    .timeline-date { font-family: var(--mono); font-size: var(--fs-micro); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--g); margin-bottom: 6px; }
    .timeline-title { font-size: var(--fs-body); font-weight: 700; color: var(--text); margin-bottom: 6px; line-height: 1.3; }
    .timeline-desc { font-size: var(--fs-md); color: var(--text-3); line-height: 1.65; }
    .timeline-desc a { color: var(--g); text-decoration: underline; }

    .playbook-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 32px 0; }
    .playbook-card { background: var(--bg-3); border: 1.5px solid var(--border); border-radius: 12px; padding: 24px; transition: border-color .2s, transform .2s; }
    .playbook-card:hover { border-color: var(--g-border); transform: translateY(-3px); }
    .playbook-tag { font-family: var(--mono); font-size: var(--fs-micro); font-weight: 700; color: var(--g); letter-spacing: .15em; text-transform: uppercase; margin-bottom: 10px; }
    .playbook-name { font-weight: 800; font-size: var(--fs-body); color: var(--text); letter-spacing: -.01em; margin-bottom: 8px; }
    .playbook-desc { font-size: var(--fs-sm); color: var(--text-3); line-height: 1.65; margin-bottom: 14px; }
    .playbook-desc strong { color: var(--text-2); }
    .playbook-list { list-style: none; padding: 0; margin: 0; font-size: var(--fs-sm); }
    .playbook-list li { position: relative; padding: 6px 0 6px 16px; color: var(--text-3); line-height: 1.5; border-bottom: 1px solid var(--border); }
    .playbook-list li::before { content: "·"; position: absolute; left: 0; top: 6px; color: var(--g); font-weight: 700; font-size: var(--fs-body); line-height: 1; }
    .playbook-list li:last-child { border-bottom: none; }
    @media (max-width: 760px) { .playbook-grid { grid-template-columns: 1fr; } }

    .vs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 24px 0; }
    .vs-card { background: var(--bg-3); border: 1px solid var(--border); border-radius: 10px; padding: 22px 24px; }
    .vs-card-title { font-family: var(--mono); font-size: var(--fs-micro); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 14px; }
    .vs-card-title.win { color: var(--g); }
    .vs-card-title.lose { color: var(--text-4); }
    .vs-list { list-style: none; padding: 0; margin: 0; }
    .vs-list li { position: relative; padding: 8px 0 8px 22px; font-size: var(--fs-md); color: var(--text-3); line-height: 1.6; }
    .vs-list li::before { position: absolute; left: 0; top: 7px; font-weight: 700; }
    .vs-list.pros li::before { content: "✓"; color: var(--g); }
    .vs-list.cons li::before { content: "✕"; color: var(--text-4); }
    @media (max-width: 600px) { .vs-grid { grid-template-columns: 1fr; } }

    .crosslink-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 40px; }
    .crosslink-card { background: var(--bg-3); border: 1.5px solid var(--border); border-radius: 12px; padding: 24px; display: flex; flex-direction: column; transition: border-color .2s, transform .2s; }
    .crosslink-card:hover { border-color: var(--g-border); transform: translateY(-3px); }
    .crosslink-tag { font-family: var(--mono); font-size: var(--fs-micro); font-weight: 700; color: var(--g); letter-spacing: .15em; text-transform: uppercase; margin-bottom: 10px; }
    .crosslink-name { font-weight: 800; font-size: var(--fs-body); color: var(--text); letter-spacing: -.01em; margin-bottom: 6px; }
    .crosslink-desc { font-size: var(--fs-sm); color: var(--text-3); line-height: 1.6; flex: 1; }
    .crosslink-arrow { font-family: var(--mono); font-size: var(--fs-micro); font-weight: 700; color: var(--g); margin-top: 12px; }
    @media (max-width: 600px) { .crosslink-grid { grid-template-columns: 1fr; } }

    .glossary-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin: 28px 0; }
    .glossary-item { background: var(--bg-3); border: 1px solid var(--border); border-radius: 8px; padding: 18px 20px; }
    .glossary-term { font-weight: 800; font-size: var(--fs-md); color: var(--text); margin-bottom: 6px; }
    .glossary-def { font-size: var(--fs-sm); color: var(--text-3); line-height: 1.65; margin: 0; }
    .glossary-def a { color: var(--g); text-decoration: underline; }
    @media (max-width: 600px) { .glossary-grid { grid-template-columns: 1fr; } }

    .trouble-list { display: flex; flex-direction: column; gap: 12px; margin: 24px 0; }
    .trouble-item { background: var(--bg-3); border: 1px solid var(--border); border-radius: 10px; padding: 20px 24px; }
    .trouble-q { font-weight: 700; font-size: var(--fs-md); color: var(--text); margin-bottom: 8px; line-height: 1.4; }
    .trouble-a { font-size: var(--fs-md); color: var(--text-3); line-height: 1.7; margin: 0; }
    .trouble-a a { color: var(--g); text-decoration: underline; }
    .trouble-a strong { color: var(--text-2); }

    .faq-list-s { display: flex; flex-direction: column; gap: 8px; margin-top: 32px; }
    details.faq-item-s { border-radius: 10px; border: 1.5px solid var(--border); background: rgba(255,255,255,.02); transition: border-color .2s; }
    details.faq-item-s[open] { border-color: rgba(140,207,232,.25); background: rgba(140,207,232,.025); }
    details.faq-item-s summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 22px; cursor: pointer; list-style: none; min-height: 58px; font-size: var(--fs-md); font-weight: 600; color: var(--text-3); }
    details.faq-item-s summary::-webkit-details-marker { display: none; }
    details.faq-item-s[open] summary { color: var(--text); }
    .faq-ico { width: 14px; height: 14px; min-width: 14px; position: relative; opacity: .4; }
    .faq-ico::before { content: ''; position: absolute; top: 2px; left: 1px; width: 9px; height: 9px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); transition: transform .25s; }
    details.faq-item-s[open] .faq-ico { opacity: 1; color: var(--sky); }
    details.faq-item-s[open] .faq-ico::before { transform: rotate(225deg); top: 5px; }
    .faq-ans-s { padding: 0 22px 20px; font-size: var(--fs-md); color: var(--text-3); line-height: 1.75; border-top: 1px solid var(--border); padding-top: 14px; }
    .faq-ans-s a { color: var(--g); text-decoration: underline; }
    .faq-ans-s strong { color: var(--text-2); }

    .pro-block { background: linear-gradient(180deg, var(--bg-3) 0%, var(--bg-2) 100%); border: 1.5px solid var(--vio); border-radius: 16px; padding: 36px 32px; margin: 48px auto 0; max-width: 760px; text-align: center; box-shadow: 0 8px 28px rgba(195,184,239,.08); }
    .pro-tag { display: inline-block; font-family: var(--mono); font-size: var(--fs-micro); font-weight: 800; letter-spacing: .15em; text-transform: uppercase; color: var(--vio); background: rgba(195,184,239,.08); border: 1px solid rgba(195,184,239,.2); padding: 5px 12px; border-radius: 100px; margin-bottom: 16px; }
    .pro-block h3 { font-size: var(--fs-lg); font-weight: 700; color: var(--text); letter-spacing: -.02em; margin-bottom: 10px; }
    .pro-block p { font-size: var(--fs-md); color: var(--text-3); line-height: 1.7; margin-bottom: 18px; max-width: 580px; margin-left: auto; margin-right: auto; }
    .pro-block .pro-price { font-family: var(--mono); font-size: var(--fs-xl); font-weight: 800; color: var(--text); margin: 18px 0 8px; }
    .pro-block .pro-price-sub { font-size: var(--fs-sm); color: var(--text-4); margin-bottom: 22px; }
    .pro-block .btn-pro { background: var(--vio); color: var(--text-inv); }
    .pro-block .btn-pro:hover { background: #d8c8ff; }
    .pro-features { list-style: none; padding: 0; margin: 0 auto 24px; max-width: 480px; text-align: left; }
    .pro-features li { position: relative; padding: 7px 0 7px 24px; font-size: var(--fs-md); color: var(--text-3); }
    .pro-features li::before { content: "✓"; position: absolute; left: 0; top: 7px; color: var(--vio); font-weight: 700; }
    @media (max-width: 640px) {
      .hero { padding: 48px 20px 40px; }
      .hero-ctas { flex-direction: column; align-items: stretch; max-width: 320px; margin-left: auto; margin-right: auto; }
      .btn, .btn-outline { width: 100%; justify-content: center; }
      .section, .section-alt { padding: 56px 20px; }
      .author-line { flex-direction: column; padding: 14px; max-width: 100%; }
      .author-text { text-align: center; }
    }

    /* ═══════════════════════════════════════════════════════════════════
     * MECHANISM FLOW + DELETED/SURVIVES SPLIT
     *
     * Both are built from real text rather than images. An <img> of this
     * pipeline would be invisible to the crawlers this page is written for,
     * and would need alt text duplicating every label anyway.
     * ══════════════════════════════════════════════════════════════════ */
    .flow { margin: 40px auto 0; max-width: 1000px; }
    .flow-track {
      list-style: none; margin: 0; padding: 0;
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px;
      counter-reset: flow;
    }
    .flow-node {
      position: relative; display: flex; flex-direction: column; gap: 7px;
      background: var(--bg-3); border: 1px solid var(--border);
      border-radius: 12px; padding: 20px 18px 18px;
      transition: border-color .2s, transform .2s;
    }
    .flow-node:hover { border-color: var(--g-border); transform: translateY(-2px); }
    /* Connector: a chevron sitting in the gap, hidden on the last node and
       rotated to point down once the track stacks. */
    .flow-node::after {
      content: ""; position: absolute; top: 50%; right: -10px;
      width: 10px; height: 10px; margin-top: -5px; z-index: 1;
      border-top: 1.5px solid var(--text-4); border-right: 1.5px solid var(--text-4);
      transform: rotate(45deg);
    }
    .flow-node-end::after { display: none; }
    .flow-idx {
      font-family: var(--mono); font-size: var(--fs-micro); font-weight: 700;
      letter-spacing: .16em; color: var(--g);
    }
    .flow-ico { display: block; width: 22px; height: 22px; color: var(--text-2); }
    .flow-ico svg { width: 100%; height: 100%; display: block; }
    .flow-name { font-size: var(--fs-md); font-weight: 700; color: var(--text); line-height: 1.3; }
    .flow-sub  { font-size: var(--fs-sm); color: var(--text-3); line-height: 1.55; }
    .flow-cap {
      margin: 18px auto 0; max-width: 68ch; text-align: center;
      font-size: var(--fs-sm); color: var(--text-3); line-height: 1.7;
    }
    @media (max-width: 860px) {
      .flow-track { grid-template-columns: 1fr 1fr; }
      .flow-node:nth-child(2)::after { display: none; }
    }
    @media (max-width: 520px) {
      .flow-track { grid-template-columns: 1fr; }
      .flow-node::after {
        top: auto; bottom: -10px; right: 50%; margin: 0 -5px 0 0;
        transform: rotate(135deg);
      }
      .flow-node:nth-child(2)::after { display: block; }
      .flow-node-end::after { display: none; }
    }

    .ledger-split {
      margin: 36px 0 28px; padding: 0;
      display: grid; grid-template-columns: 1fr 1fr; gap: 14px;
    }
    .split-col { border: 1px solid var(--border); border-radius: 12px; padding: 22px; background: var(--bg-3); }
    .split-gone { border-color: var(--red-border); background: var(--red-bg); }
    .split-safe { border-color: var(--g-border); background: var(--g-bg); }
    .split-head { display: flex; gap: 12px; align-items: flex-start; margin-bottom: 14px; }
    .split-ico { flex: 0 0 auto; width: 22px; height: 22px; }
    .split-ico svg { width: 100%; height: 100%; display: block; }
    .split-gone .split-ico { color: var(--red); }
    .split-safe .split-ico { color: var(--g); }
    .split-title { font-size: var(--fs-md); font-weight: 700; color: var(--text); line-height: 1.25; }
    .split-note  { font-size: var(--fs-sm); color: var(--text-3); line-height: 1.55; margin-top: 3px; }
    .split-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0; }
    .split-list li {
      font-size: var(--fs-md); color: var(--text-2); line-height: 1.5;
      padding: 9px 0 9px 22px; position: relative;
      border-top: 1px solid var(--border);
    }
    .split-list li:first-child { border-top: none; }
    .split-list li::before {
      position: absolute; left: 0; top: 9px;
      font-family: var(--mono); font-size: var(--fs-sm); font-weight: 700;
    }
    .split-gone .split-list li::before { content: "\2715"; color: var(--red); }
    .split-safe .split-list li::before { content: "\2713"; color: var(--g); }
    .split-cap {
      grid-column: 1 / -1; margin: 4px auto 0; max-width: 72ch; text-align: center;
      font-size: var(--fs-sm); color: var(--text-3); line-height: 1.7;
    }
    @media (max-width: 720px) { .ledger-split { grid-template-columns: 1fr; } }

    /* ── Affiliate marker + inline CTA blocks ───────────────────────────── */
    /* Google needs rel="sponsored" — that is the machine-readable signal and it
       is on every one of these links. The VISIBLE marker is an FTC/ASA
       disclosure, not an SEO requirement, and "clear and conspicuous" does not
       mean loud: each of these sits inside or beside copy that already says
       Make.com is an affiliate partner. Reduced from a bordered 11px chip to a
       7.5px superscript. */
    .aff-tag {
      font-family: var(--mono); font-size: 7.5px; font-weight: 600;
      letter-spacing: .1em; text-transform: uppercase;
      margin-left: 5px; opacity: .45; vertical-align: 5px;
      white-space: nowrap; border: 0; padding: 0;
    }
    .btn .aff-tag, .btn-g .aff-tag, .step-cta .aff-tag { opacity: .5; }
    .hero-ctas-note {
      font-size: var(--fs-sm); color: var(--text-3); line-height: 1.65;
      margin: 14px auto 0; max-width: 56ch;
    }
    .section-cta-inline {
      margin: 30px 0; padding: 22px 24px;
      background: var(--g-bg); border: 1px solid var(--g-border); border-radius: 12px;
      display: flex; align-items: center; justify-content: space-between;
      gap: 20px; flex-wrap: wrap; text-align: left;
    }
    .section-cta-inline .section-cta-text h4 {
      font-size: var(--fs-md); font-weight: 700; color: var(--text); margin: 0 0 5px;
    }
    .section-cta-inline .section-cta-text p {
      font-size: var(--fs-sm); color: var(--text-3); line-height: 1.6; margin: 0; max-width: 56ch;
    }
    .step-cta {
      display: inline-flex; align-items: center;
      font-family: var(--sans); font-size: var(--fs-sm); font-weight: 700;
      background: var(--g); color: var(--text-inv);
      text-decoration: none; border-radius: var(--radius);
      padding: 9px 16px; margin: 12px 12px 0 0; transition: background .2s, transform .15s;
    }
    .step-cta:hover { background: #3bdc84; transform: translateY(-1px); }
    @media (max-width: 640px) {
      .section-cta-inline { flex-direction: column; align-items: stretch; }
      .section-cta-inline .btn { width: 100%; justify-content: center; }
    }

    /* ── Mobile: let long CTA labels wrap ──────────────────────────────────
       .btn is white-space:nowrap. The final CTA label ("Replace Stocky with
       Make.com free — 4-minute setup, no card →") needs 393px and sat in a
       320px column, overflowing the viewport by 73px and making the WHOLE
       DOCUMENT scroll sideways on a 390px screen. That is the page's primary
       affiliate CTA, on the platform where this site's clickthrough actually
       happens. Measured: documentElement.scrollWidth 428 vs clientWidth 390.
       ─────────────────────────────────────────────────────────────────── */
    @media (max-width: 640px) {
      .btn, .btn-outline, .btn-pro, .step-cta {
        white-space: normal;
        text-align: center;
        max-width: 100%;
      }
      .hero-ctas { width: 100%; }
      .hero-ctas .btn, .hero-ctas .btn-outline { width: 100%; }
    }

    /* ══════════════════════════════════════════════════════════════════════
     * VISUAL SYSTEM — derived from the Stack Architect logo + OG card
     *
     * Devices lifted from the kit and made repeatable:
     *   1. "// MONO EYEBROW" over every section, with a short green rule
     *   2. the four-bar stack motif as a section marker
     *   3. dot-grid ground with a radial green bloom
     *   4. 1px-bordered rounded wells with an inner top highlight
     *   5. the graduated green ramp, so green means depth not just "brand"
     * ═════════════════════════════════════════════════════════════════════ */

    /* ── 1. Section head ─────────────────────────────────────────────────── */
    .sec-eyebrow {
      display: inline-flex; align-items: center; gap: 9px;
      font-family: var(--mono); font-size: var(--fs-micro); font-weight: 600;
      letter-spacing: .18em; text-transform: uppercase;
      color: var(--text-4); margin-bottom: 14px;
    }
    .sec-eyebrow::before {
      content: "//"; color: var(--g-400); opacity: .8; letter-spacing: 0;
    }
    .sec-head { position: relative; }
    .sec-head h2 {
      font-size: clamp(28px, 4.4vw, 46px);
      letter-spacing: -.035em; line-height: 1.04; font-weight: 700;
      text-wrap: balance;
    }
    .sec-head h2 + p { margin-top: 14px; }
    /* The short rule under the eyebrow on the OG card, as a section divider. */
    .sec-head::after {
      content: ""; display: block; width: 44px; height: 3px; border-radius: 2px;
      margin: 20px auto 0;
      background: linear-gradient(90deg, var(--g-100), var(--g-400) 55%, transparent);
    }
    .sec-head.head-left { text-align: left; }
    .sec-head.head-left::after { margin-left: 0; margin-right: auto; }
    .sec-head.head-left p { margin-left: 0; }

    /* ── 2. The stack motif ──────────────────────────────────────────────── */
    .stack-mark { display: flex; flex-direction: column; align-items: center; gap: 3px; }
    .stack-mark i { display: block; height: 5px; border-radius: 2px; }
    .stack-mark i:nth-child(1) { width: 15px; background: var(--g-100); }
    .stack-mark i:nth-child(2) { width: 22px; background: var(--g-200); }
    .stack-mark i:nth-child(3) { width: 29px; background: var(--g-400); }
    .stack-mark i:nth-child(4) { width: 36px; background: var(--g-600); }
    .stack-mark-sm i { height: 3px; }
    .stack-mark-sm i:nth-child(1) { width: 9px; }
    .stack-mark-sm i:nth-child(2) { width: 13px; }
    .stack-mark-sm i:nth-child(3) { width: 17px; }
    .stack-mark-sm i:nth-child(4) { width: 21px; }

    /* ── 3. Ground textures ──────────────────────────────────────────────── */
    .section, .section-alt { position: relative; }
    .tex-dots::before {
      content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 0;
      background-image: radial-gradient(circle, var(--grid-dot) 1px, transparent 1px);
      background-size: 26px 26px;
      -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 0%, #000 10%, transparent 75%);
      mask-image: radial-gradient(ellipse 80% 70% at 50% 0%, #000 10%, transparent 75%);
    }
    .tex-dots > * { position: relative; z-index: 1; }
    .bloom::after {
      content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 0;
      background: var(--glow-g);
    }

    /* ── 4. Wells: 1px border + inner top highlight, as on the OG card ───── */
    .step-card, .playbook-card, .glossary-item, .trouble-item,
    .vs-card, .crosslink-card, .flow-node, .split-col, .comp-wrap {
      box-shadow: var(--edge);
    }
    .playbook-card, .crosslink-card, .flow-node {
      background: linear-gradient(180deg, var(--bg-3) 0%, var(--ink-900) 100%);
    }
    .playbook-card:hover, .crosslink-card:hover, .flow-node:hover {
      box-shadow: var(--edge), 0 12px 32px -18px rgba(52,211,119,.45);
    }

    /* ── 5. Graduated green in the flow, so 01->04 reads as descent ──────── */
    .flow-node:nth-child(1) .flow-idx { color: var(--g-100); }
    .flow-node:nth-child(2) .flow-idx { color: var(--g-200); }
    .flow-node:nth-child(3) .flow-idx { color: var(--g-400); }
    .flow-node:nth-child(4) .flow-idx { color: var(--g-600); }
    .flow-node:nth-child(1) .flow-ico { color: var(--g-100); }
    .flow-node:nth-child(2) .flow-ico { color: var(--g-200); }
    .flow-node:nth-child(3) .flow-ico { color: var(--g-400); }
    .flow-node:nth-child(4) .flow-ico { color: var(--g-600); }
    .flow-node { border-top: 2px solid transparent; }
    .flow-node:nth-child(1) { border-top-color: var(--g-100); }
    .flow-node:nth-child(2) { border-top-color: var(--g-200); }
    .flow-node:nth-child(3) { border-top-color: var(--g-400); }
    .flow-node:nth-child(4) { border-top-color: var(--g-600); }

    /* ── 6. Step numbers get the ramp too ────────────────────────────────── */
    .step-card:nth-child(1) .step-num { background: rgba(134,239,172,.12); border-color: rgba(134,239,172,.3); color: var(--g-100); }
    .step-card:nth-child(2) .step-num { background: rgba(74,222,128,.12);  border-color: rgba(74,222,128,.3);  color: var(--g-200); }
    .step-card:nth-child(3) .step-num { background: rgba(22,163,74,.16);   border-color: rgba(22,163,74,.4);   color: var(--g-400); }
    .step-card { position: relative; overflow: hidden; }
    .step-card::before {
      content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 2px;
    }
