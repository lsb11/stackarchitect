import AuthorCard from "../components/AuthorCard.astro";
import TableOfContents from '../components/TableOfContents.astro';

const tocHeadings = [
  {
    "id": "where-our-numbers-come-from",
    "text": "Where Our Numbers Come From"
  },
  {
    "id": "the-20-40-figure",
    "text": "The 20–40% Figure — Retracted, and Why"
  },
  {
    "id": "how-often-figures-are-re-verified",
    "text": "How Often Figures Are Re-Verified"
  },
  {
    "id": "what-our-tested-badges-mean",
    "text": "What Our \"Tested\" Badges Mean"
  },
  {
    "id": "how-this-site-makes-money-and-what-that-buys",
    "text": "How This Site Makes Money \u2014 And What That Buys"
  },
  {
    "id": "corrections-amp-feedback",
    "text": "Corrections &amp; Feedback"
  },
  {
    "id": "related-app-alternatives",
    "text": "Related App Alternatives"
  }
];

// Runbook §3.4: this page substantiates every pricing claim on the site, so it
// needs its own WebPage node with `about` pointing at the Organization.
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://stackarchitect.xyz/how-we-test/#webpage",
    "url": "https://stackarchitect.xyz/how-we-test/",
    "name": "How We Test and Verify Every Claim",
    "description": "Every price and limit on Stack Architect is sourced from vendor pricing pages, dated, re-verified quarterly, and corrected publicly when wrong.",
    "inLanguage": "en-GB",
    "isPartOf": { "@id": "https://stackarchitect.xyz/#website" },
    "about": { "@id": "https://stackarchitect.xyz/#org" },
    "publisher": { "@id": "https://stackarchitect.xyz/#org" },
    "author": { "@id": "https://stackarchitect.xyz/#luke" },
    "mainEntity": { "@id": "https://stackarchitect.xyz/#org" }
