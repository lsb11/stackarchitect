---
// /how-we-test/ — methodology & trust page. Site-level E-E-A-T asset:
// sourcing standards, badge policy, funding disclosure, corrections policy.
import Base from "../layouts/Base.astro";
import AuthorCard from "../components/AuthorCard.astro";
import TableOfContents from '../components/TableOfContents.astro';

const tocHeadings = [
  {
    "id": "where-our-numbers-come-from",
    "text": "Where Our Numbers Come From"
  },
  {
    "id": "the-20-40-figure",
    "text": "The 20–40% Figure — What It Is and Is Not"
  },
  {
    "id": "how-often-figures-are-re-verified",
    "text": "How Often Figures Are Re-Verified"
  },
  {
    "id": "what-our-tested-badges-mean",
    "text": "What Our \"Tested\" Badges Mean"
  },
  {
    "id": "how-this-site-makes-money-and-what-that-buys",
    "text": "How This Site Makes Money \u2014 And What That Buys"
  },
  {
    "id": "corrections-amp-feedback",
    "text": "Corrections &amp; Feedback"
  },
  {
    "id": "related-app-alternatives",
    "text": "Related App Alternatives"
  }
];

// Runbook §3.4: this page substantiates every pricing claim on the site, so it
// needs its own WebPage node with `about` pointing at the Organization.
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://stackarchitect.xyz/how-we-test/#webpage",
    "url": "https://stackarchitect.xyz/how-we-test/",
    "name": "How We Test and Verify Every Claim",
    "description": "Every price and limit on Stack Architect is sourced from vendor pricing pages, dated, re-verified quarterly, and corrected publicly when wrong.",
    "inLanguage": "en-GB",
    "isPartOf": { "@id": "https://stackarchitect.xyz/#website" },
    "about": { "@id": "https://stackarchitect.xyz/#org" },
    "publisher": { "@id": "https://stackarchitect.xyz/#org" },
    "author": { "@id": "https://stackarchitect.xyz/#luke" },
    "mainEntity": { "@id": "https://stackarchitect.xyz/#org" }
  }
];

---
<Base
  schema={schemas}
  title="How We Test and Verify Every Claim"
  description="Every price and limit on Stack Architect is sourced from vendor pricing pages, dated, re-verified quarterly, and corrected publicly when wrong."
  ogImage="https://stackarchitect.xyz/og/og-how-we-test.png"
  canonical="https://stackarchitect.xyz/how-we-test/">


  <main class="flex-1">
    <article style="max-width:760px;margin:0 auto;padding:48px 20px;line-height:1.75;">

      <div style="font-family:'JetBrains Mono',monospace;font-size:11px;color:#34d377;text-transform:uppercase;letter-spacing:.1em;margin-bottom:12px;">
        Site Methodology &amp; Sourcing Standards
      </div>

      <h1 style="font-size:clamp(32px,4.5vw,48px);font-weight:800;color:#f2f5f3;line-height:1.1;letter-spacing:-.03em;margin-bottom:12px;">
        How We Test and Verify Every Claim
      </h1>

    <p id="answer">Every price, limit and performance figure on Stack Architect is taken from the vendor's own pricing page or platform documentation, recorded with the date it was checked, re-verified quarterly, and corrected publicly when it turns out to be wrong. Figures that cannot be verified are labelled as unverified rather than quietly estimated.</p>

  <TableOfContents headings={tocHeadings} />

      <p style="font-size:0.9rem;color:#93a09a;margin-bottom:2rem;font-family:'JetBrains Mono',monospace;">
        Last updated: 24 July 2026 · Maintained by <a href="/about/" style="color:#34d377;text-decoration:underline;">Luke Sandelands</a>
      </p>

      <p style="font-size:1.05rem;color:#c9cec9;margin-bottom:1.75rem;line-height:1.75;">
        Stack Architect exists because most Shopify automation advice is either vendor marketing or untested rehash. So every factual claim on this site follows one rule: <strong>if we can't source it or reproduce it, we don't publish it.</strong> This page documents exactly what that means.
      </p>

      <h2 id="where-our-numbers-come-from" style="font-size:1.6rem;color:#fff;font-weight:700;margin-top:2.5rem;margin-bottom:1rem;">Where Our Numbers Come From</h2>
      <p style="color:#c9cec9;margin-bottom:1rem;">In order of preference:</p>
      <ol style="color:#c9cec9;line-height:1.8;margin-bottom:2rem;padding-left:1.25rem;">
        <li style="margin-bottom:10px;">
          <strong>Vendor pricing pages and official documentation.</strong> Make.com's plan limits come from <a href="https://www.make.com/en/pricing" target="_blank" rel="noopener sponsored" style="color:#34d377;text-decoration:underline;">Make.com official pricing</a>. Meta CAPI behaviour comes from <a href="https://developers.facebook.com/docs/marketing-api/conversions-api/" target="_blank" rel="noopener" style="color:#34d377;text-decoration:underline;">Meta Conversions API documentation</a> and Events Manager. Competitor prices (Elevar, Triple Whale, Klaviyo, Stape, Littledata) are read from each vendor's own published pricing page. Each record carries the date it was checked and a link to the page it came from where that verification has been done; the rest are shown as unverified. The current state of every record is in our <a href="/apps/" style="color:#34d377;text-decoration:underline;">Shopify App Pricing Index</a>.
        </li>
        <li style="margin-bottom:10px;">
          <strong>Working configurations, built as published.</strong> Core solutions like <a href="/capi-shield/" style="color:#34d377;text-decoration:underline;">CAPI Shield</a>, <a href="/stocky-swap/" style="color:#34d377;text-decoration:underline;">Stocky Swap</a>, and <a href="/shopify-profit-loss-automation/" style="color:#34d377;text-decoration:underline;">Live P&amp;L Automation</a> are written by building the setup step by step and publishing the exact steps that worked — not by summarising vendor docs.
        </li>
        <li style="margin-bottom:10px;">
          <strong>Platform announcements with dates.</strong> Deadline claims (such as Shopify Stocky's shutdown, Meta's one-click CAPI updates, and Klaviyo billing changes) cite official announcements directly. Learn how to replace Klaviyo for free in our <a href="/replace-klaviyo-free/" style="color:#34d377;text-decoration:underline;">Free Klaviyo Replacement Guide</a>.
        </li>
      </ol>

      <p style="color:#c9cec9;margin-bottom:2rem;">We do not use: other blogs' figures, AI-generated statistics, or vendor claims we can't check against a pricing page or changelog.</p>

      <h2 id="the-20-40-figure" style="font-size:1.6rem;color:#fff;font-weight:700;margin-top:2.5rem;margin-bottom:1rem;">The 20–40% Figure — What It Is and Is Not</h2>
      <p style="color:#c9cec9;margin-bottom:1rem;">
        The 20–40% figure that appears across this site is an estimate of purchase-conversion signal
        <strong>lost</strong> to browser-only tracking — iOS ATT, Safari ITP and ad blockers. It is drawn from the
        six sources listed in our <a href="/shopify-ios-attribution-gap-benchmark/" style="color:#34d377;text-decoration:underline;">iOS Attribution Gap Benchmark</a>,
        where every row names its source, URL and date.
      </p>
      <p style="color:#c9cec9;margin-bottom:1rem;">
        Being straight about its quality: of those six sources, <strong>three are primary</strong> — Apple's WebKit
        documentation on Intelligent Tracking Prevention, Meta CFO David Wehner's statement on the ~$10B 2022 ATT
        headwind, and Meta's own Conversions API documentation. <strong>Three are secondary</strong> — a newsletter
        describing a single case, an industry answer library, and a statistics blog. The mechanism is well
        established. The precise magnitude rests partly on secondary reporting, which is why we call it an estimate
        rather than a measurement.
      </p>
      <p style="color:#c9cec9;margin-bottom:1rem;">
        One caveat we would rather state than bury: AppsFlyer data <em>within our own dataset</em> shows iOS ATT
        opt-in has risen from the low-20s% at launch to roughly 50% by 2024–25. If that trend holds, current
        browser-side loss may be lower than 20–40%, and our estimate may overstate it. We have left the figure in
        place and flagged it here rather than quietly adjusting a number we cannot re-measure.
      </p>
      <p style="color:#c9cec9;margin-bottom:2rem;">
        <strong>Annual savings figures are arithmetic, not findings.</strong> Where this site
        shows a yearly saving against a paid app, that number is the vendor's monthly list price
        multiplied by twelve. It is not a measured outcome, it does not account for annual-billing
        discounts, negotiated or grandfathered rates, or the tier you would actually land on, and it
        assumes you replace the tool outright rather than partially. Treat it as the size of the
        question, not the answer. The per-app monthly prices behind those figures are the sourced
        part; the multiplication is ours.
      </p>

      <p style="margin-bottom:1.25rem;">
        <strong>We publish no recovery percentage.</strong> You will not find a claim on this site that CAPI Shield
        or any other tool recovers a specific share of lost conversions, because we have no first-party recovery
        measurement — no store sample, no before/after study. A loss estimate is not a recovery rate, and treating
        the two as interchangeable is the error this policy exists to prevent. Meta measures the real figure on your
        own data and calls it <strong>Additional Conversions Reported</strong>, available in Events Manager and via
        the <a href="https://developers.facebook.com/docs/marketing-api/conversions-api/dataset-quality-api/" target="_blank" rel="noopener" style="color:#34d377;text-decoration:underline;">Dataset Quality API</a>.
        That is the number to trust, and it is not ours to give you.
      </p>

      <h2 id="how-often-figures-are-re-verified" style="font-size:1.6rem;color:#fff;font-weight:700;margin-top:2.5rem;margin-bottom:1rem;">How Often Figures Are Re-Verified</h2>
      <p style="color:#c9cec9;margin-bottom:2rem;line-height:1.75;">
        Every pricing and plan-limit figure is re-checked <strong>quarterly</strong>, and immediately whenever a vendor announces a pricing change. When Make.com updated its pricing structure, we updated every affected page across our <a href="/best-free-shopify-apps-2026/" style="color:#34d377;text-decoration:underline;">Best Free Shopify Apps 2026 Directory</a>. Comparison tables carry a "verified" date; if that date is more than a quarter old, tell us.
      </p>

      <h2 id="what-our-tested-badges-mean" style="font-size:1.6rem;color:#fff;font-weight:700;margin-top:2.5rem;margin-bottom:1rem;">What Our "Tested" Badges Mean</h2>
      <p style="color:#c9cec9;margin-bottom:2rem;line-height:1.75;">
        A badge like "iOS tested" means the documented setup was confirmed working under that environment on the date shown — not tested once and assumed fine since. Check our benchmark methodology in the <a href="/shopify-ios-attribution-gap-benchmark/" style="color:#34d377;text-decoration:underline;">Shopify iOS Attribution Gap Benchmark</a>.
      </p>

      <h2 id="how-this-site-makes-money-and-what-that-buys" style="font-size:1.6rem;color:#fff;font-weight:700;margin-top:2.5rem;margin-bottom:1rem;">How This Site Makes Money — And What That Buys</h2>
      <p style="color:#c9cec9;margin-bottom:1rem;">Stack Architect is funded two ways, both disclosed:</p>
      <ul style="color:#c9cec9;line-height:1.8;margin-bottom:2rem;padding-left:1.25rem;">
        <li style="margin-bottom:10px;">
          <strong>Affiliate links.</strong> Some links to tools we recommend (marked <code>rel="sponsored"</code> in the page code) pay us a commission at no cost to you. This never changes a recommendation: our core recommendation on most pages is the <em>free</em> tier of a tool, which typically pays little or nothing.
        </li>
        <li style="margin-bottom:10px;">
          <strong><a href="/pro/" style="color:#34d377;text-decoration:underline;">The Complete Kit ($29 one-time)</a>.</strong> Pre-built versions of the same automations the free guides teach. The free guides are complete on their own — the kit buys time, not access.
        </li>
      </ul>

      <h2 id="corrections-amp-feedback" style="font-size:1.6rem;color:#fff;font-weight:700;margin-top:2.5rem;margin-bottom:1rem;">Corrections &amp; Feedback</h2>
      <p style="color:#c9cec9;margin-bottom:2rem;line-height:1.75;">
        When we get something wrong, we fix the page, update its "last updated" date, and note material corrections in the text. If you spot an error — a stale price, a changed limit, a claim that didn't hold up in your setup — email <a href="mailto:support@stackarchitect.xyz" style="color:#34d377;text-decoration:underline;"><strong>support@stackarchitect.xyz</strong></a> or read more <a href="/about/" style="color:#34d377;text-decoration:underline;">about our team and mission</a>.
      </p>

      
<div style="max-width:860px;margin:2rem auto;padding:0 24px;">
  <h2 id="related-app-alternatives" style="font-size:1.5rem;font-weight:bold;margin-bottom:1rem;color:white;">Related App Alternatives</h2>
  <ul style="list-style:disc;padding-left:1.5rem;color:#9ca3af;">
    <li><a href="/apps/elevar/" style="color:#34d377;text-decoration:none;hover:underline;">Elevar Pricing & Alternatives</a></li>
    <li><a href="/apps/triple-whale/" style="color:#34d377;text-decoration:none;hover:underline;">Triple Whale Pricing & Alternatives</a></li>
    <li><a href="/apps/klaviyo/" style="color:#34d377;text-decoration:none;hover:underline;">Klaviyo Pricing & Alternatives</a></li>
    <li><a href="/apps/stocky/" style="color:#34d377;text-decoration:none;hover:underline;">Stocky Pricing & Alternatives</a></li>
    <li><a href="/apps/littledata/" style="color:#34d377;text-decoration:none;hover:underline;">Littledata Pricing & Alternatives</a></li>
  </ul>
</div>
<AuthorCard />
    </article>
  </main>

  </Base>
