};

const howToInventorySchema = {
  "@context":"https://schema.org","@type":"HowTo",
  "name":"How to replace Shopify Stocky with a free Google Sheets inventory system",
  "description":"Free replacement for the retired Shopify Stocky app. Uses Make.com webhook to log every Shopify order to Google Sheets in real time. 4 minutes, no code.",
  "totalTime":"PT4M","estimatedCost":{"@type":"MonetaryAmount","currency":"USD","value":"0"},
  "step":[
    {"@type":"HowToStep","position":1,"name":"Export Stocky data","text":"If Stocky still opens in your admin, export all inventory data via Stocky → Settings → Export. Stocky's end of service was 31 August 2026; if it no longer opens, see the Stocky recovery path instead."},
    {"@type":"HowToStep","position":2,"name":"Create inventory Google Sheet","text":"Create a Google Sheet with columns: Order ID, Date, SKU, Product Name, Variant, Quantity, Location ID, Fulfilment Status, Order Value."},
    {"@type":"HowToStep","position":3,"name":"Create Make.com webhook scenario","text":"New scenario → Webhooks trigger → Google Sheets Add a Row action. Map Shopify order payload fields to sheet columns."},
    {"@type":"HowToStep","position":4,"name":"Add Shopify webhooks","text":"Add webhooks for Order paid, Order fulfilled, and Refund created events: all pointing to the Make.com webhook URL."},
    {"@type":"HowToStep","position":5,"name":"Add stock calculation formulas","text":"In a second sheet tab, use SUMIF formulas to calculate live stock levels per SKU."}
  ]
};

const faqSchema = faqPage(faqs);

const softwareAppSchema = {
  "@context":"https://schema.org","@type":"SoftwareApplication",
  "name":"Stack Architect $0 Automation Stack","applicationCategory":"BusinessApplication","operatingSystem":"Web",
  "offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},
  "description":"Free Shopify automation stack replacing paid apps. Includes CAPI Shield server-side tracking, Stocky Swap inventory, Systeme.io email, and Make.com workflows.",
  "url":PAGE_URL
};

const allSchemas = [articleSchema, breadcrumbSchema, howToTrackingSchema, howToInventorySchema, faqSchema, softwareAppSchema];
import TableOfContents from '../components/TableOfContents.astro';

const tocHeadings = [
  {
    "id": "tracking-h",
    "text": "Shopify Conversion Tracking in 2026: The Q1 ROAS Crisis and How to Fix It Free"
  },
  {
    "id": "inventory-h",
    "text": "Shopify Inventory Automation: Stocky Closed on 31 August 2026. Here Is Your Free Replacement."
  },
  {
    "id": "automation-h",
    "text": "Shopify Workflow Automation: Make.com vs Zapier, and Why the Free Tier Is Enough"
  },
  {
    "id": "ai-h",
    "text": "AI-Driven Shopify Traffic: How to Capture the Growth from ChatGPT, Google AI Mode, and Copilot"
  },
  {
    "id": "stability-h",
    "text": "Google Apps Script Quota Errors: Why Your Automation Breaks Mid-Month and How to Fix It"
  },
  {
    "id": "marketing-h",
    "text": "Free Shopify Email Marketing and Funnel Automation: Replace Klaviyo and ClickFunnels for $0"
  },
  {
    "id": "freeapps-h",
    "text": "8 Paid Shopify Apps You Can Replace Free Today"
  },
  {
    "id": "action-h",
    "text": "Your 35-Minute Shopify Automation Action Plan: Deploy the Full Stack Today"
  },
  {
    "id": "faq-h",
    "text": "Shopify Automation: Frequently Asked Questions"
  },
  {
    "id": "sources-amp-primary-documentation",
