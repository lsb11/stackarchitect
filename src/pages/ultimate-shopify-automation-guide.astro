    {"@type":"ListItem","position":3,"name":"Shopify Automation Guide 2026","item":PAGE_URL}
  ]
};

const howToTrackingSchema = {
  "@context":"https://schema.org","@type":"HowTo",
  "name":"How to deploy CAPI Shield server-side tracking for Shopify",
  "description":"Fix Q1 2026 ROAS loss by deploying server-side Conversions API tracking via Make.com. Bypasses iOS 26 and Shopify pixel throttle. Free, no code, 6 minutes.",
  "totalTime":"PT6M","estimatedCost":{"@type":"MonetaryAmount","currency":"USD","value":"0"},
  "supply":[{"@type":"HowToSupply","name":"Make.com free account"},{"@type":"HowToSupply","name":"Shopify admin access"},{"@type":"HowToSupply","name":"Meta Business Suite access"}],
  "step":[
    {"@type":"HowToStep","position":1,"name":"Activate Make.com","text":"Sign up for the Make.com free tier: 1,000 credits/month (formerly called operations), no credit card required."},
    {"@type":"HowToStep","position":2,"name":"Create a Shopify webhook","text":"In Shopify Admin → Settings → Notifications → Webhooks, create a webhook for the Order payment event."},
    {"@type":"HowToStep","position":3,"name":"Build the Make.com scenario","text":"Create a scenario with a Webhooks trigger, connect to the Meta Conversions API module, map Shopify order fields to Purchase event parameters."},
    {"@type":"HowToStep","position":4,"name":"Test with Meta Events Manager","text":"Place a test order and verify the server-side Purchase event appears in Meta Events Manager → Test Events."},
    {"@type":"HowToStep","position":5,"name":"Monitor Event Match Quality","text":"Track Event Match Quality in Meta Events Manager for 30 days: expect improvement from Fair to Good within 2 weeks."}
