---
import { pageUpdated, formatUpdatedMonth } from '../data/pageUpdated';
import Base from '../layouts/Base.astro';
import { READ_DATE } from '../data/priceSources';
import PriceSources from '../components/PriceSources.astro';
import { faqPage, type Faq } from '../utils/faq';

// One array renders the visible FAQ and the FAQPage node.
const faqs: Faq[] = [
              { q:"What is the best Shopify automation guide in 2026?", a:"This guide covers the complete $0 Automation Stack: the fastest way to automate your Shopify store in 2026 across tracking, inventory, workflow, email, and AI discoverability. For individual deep-dives on each topic, the Shopify automation guides library covers 40+ step-by-step guides across every operational area." },
              { q:"How do I automate my Shopify store in 2026?", a:"Use the $0 Automation Stack: Make.com free tier as the central webhook hub, CAPI Shield for server-side ad tracking, Stocky Swap for inventory management, Systeme.io for email automation, and Google Apps Script Quota Fix for document workflow stability. The complete setup takes 35 minutes and costs $0/month for stores processing under 200 orders per month." },
              { q:"Why did my Shopify ROAS drop in January 2026?", a:'Two events hit simultaneously: iOS 26 stripped fbclid parameters from Private Browsing links and links shared via Mail and Messages, breaking click-level attribution. On January 13 2026, Shopify changed App Pixels to "Optimised" mode: silently throttling third-party tracking pixel data. Together they open a conversion data gap whose size tracks how much of your traffic arrives through the affected routes. Server-side tracking via CAPI Shield fixes both issues simultaneously.' },
              { q:"What happened to Shopify's pixel on January 13 2026?", a:'Shopify changed App Pixels to "Optimised" mode on January 13 2026. This change throttles the data that third-party pixel apps receive from Shopify\'s checkout events, without throwing an error or notifying merchants. Server-side tracking via CAPI Shield bypasses the App Pixel system entirely.' },
              { q:"When did Shopify Stocky close?", a:"Shopify closed Stocky on 31 August 2026: the app can no longer be used and its APIs stopped that day. Read-only export stays open for at least 90 days after that, and Shopify has published no end date. Export your data now via Stocky → Settings → Export, then deploy Stocky Swap as your replacement. The migration takes 4 minutes and your data lives in a Google Sheet you own permanently." },
              { q:"How do I automate my Shopify store for free?", a:"Use the $0 Automation Stack: Make.com (free tier) as the central hub, Google Sheets for inventory, the Conversions API for tracking, and Systeme.io for email marketing. This replaces paid tracking, inventory, automation, and email apps at zero cost. Deploy in under 35 minutes with no code." },
              { q:"Make.com vs Zapier for Shopify?", a:"Make.com. It offers 1,000 free credits per month versus Zapier's 100, supports multi-step workflows on the free tier, and handles Shopify webhooks in real time (Zapier's free tier polls every 15 minutes). For Shopify automation specifically, Make.com is the stronger choice at every price point." },
              { q:"How do I replace Shopify Stocky for free?", a:"Use Stocky Swap: a free Make.com workflow that logs every paid Shopify order to a Google Sheet in real time, with order ID, SKU, quantity, revenue and fulfilment status. It does not calculate stock on hand, manage purchase orders or send alerts: Shopify Admin covers stock and purchase orders, with Shopify Flow for low-stock alerts." },
              { q:"Can I automate Shopify without coding?", a:"Yes. The entire $0 Automation Stack requires zero coding. Make.com uses a visual drag-and-drop builder, Google Sheets requires no scripting for basic inventory tracking, and the Conversions API integration is configured via point-and-click webhook setup in Shopify Admin." },
              { q:"What is Klaviyo's billing change and how does it affect my costs?", a:"In February 2025, Klaviyo changed to billing on all active profiles, including unengaged contacts. Stores with large historical email lists saw their bill increase significantly. Systeme.io's free plan provides unlimited contacts and email sends with no profile billing surprises." },
              { q:"How do I get my Shopify store found by ChatGPT and Google AI Mode?", a:"Optimise for Generative Engine Optimisation (GEO): add structured product schema markup, create FAQ content that matches conversational queries, and ensure your product data is programmatically accessible. AI-driven traffic to Shopify grew 8x year-on-year in 2025." },
              
              { q:"What is Shopify automation?", a:"Shopify automation connects Shopify to external tools via webhooks and APIs so that repetitive tasks (order logging, ad tracking, inventory updates, email sequences) happen automatically without manual work or paid app subscriptions." },
              { q:"How much can I save by automating my Shopify store?", a:"It depends on which paid apps you run now. On list prices read on 25 September 2026: server-side tracking apps cost $145–$650/month, paid inventory apps start at $49/month, Zapier at $19.99+/month and Klaviyo's email plan at $20/month. The free stack replaces those jobs at $0." },
              { q:"Is the $0 Automation Stack safe?", a:"Completely safe. The stack runs in your own Google account and Make.com workspace. Nothing is installed on your Shopify store: data flows via secure webhooks. Remove it entirely by deleting the Make.com scenario and Google Sheet." },
              { q:"How long does full setup take?", a:"Each individual workflow deploys in 4–6 minutes. Full stack deployment (CAPI Shield, Stocky Swap, Quota Fix, Systeme.io, and basic AI discoverability setup) takes 35 minutes total. Zero ongoing maintenance required after deployment." },
              { q:"Do I need Google Workspace?", a:"Not initially. Free Gmail works for most stores. Google Workspace raises the Apps Script quotas, such as daily trigger runtime from 90 minutes to 6 hours, which matters only if you run Apps Script at high volume. It does not remove limits." },
            ];
import Disclosure from '../components/Disclosure.astro';
import AuthorCard from '../components/AuthorCard.astro';

