<script is:inline>
(function() {
  // Header scroll effect
  var header = document.querySelector('.product-terminal-bar') || document.querySelector('nav');
  window.addEventListener('scroll', function() {
    var s = window.scrollY;
    if (header) header.classList.toggle('scrolled', s > 50);
  }, { passive: true });

  // Footer copyright
  var el = document.getElementById('footer-copyright');
  if (el) el.textContent = '© ' + new Date().getFullYear() + ' STACK_ARCHITECT // CORE_DEPLOYMENT';

  // Stocky countdown. Past the deadline it must not render "0 Days : 00 Hrs"
  // under a "shuts down in" label — it swaps to a plain statement of the date
  // so the page reads correctly on 1 September with no edit.
  function updateCountdown() {
    var target = new Date('2026-08-31T23:59:59Z');
    var now = new Date();
    var diff = target - now;
    if (diff <= 0) {
      var box = document.getElementById('cd-box');
      var post = document.getElementById('cd-box-post');
      if (box) box.hidden = true;
      if (post) post.hidden = false;
      return;
    }
    var days = Math.floor(diff / 86400000);
    var hours = Math.floor((diff % 86400000) / 3600000);
    var mins = Math.floor((diff % 3600000) / 60000);
    var d=document.getElementById('cd-d'); if(d) d.textContent=days;
    var h=document.getElementById('cd-h'); if(h) h.textContent=String(hours).padStart(2,'0');
    var m=document.getElementById('cd-m'); if(m) m.textContent=String(mins).padStart(2,'0');
  }
  updateCountdown();
  setInterval(updateCountdown, 30000);

  // Scroll bar reveal
  var shown = false, gone = false;
  window.addEventListener('scroll', function() {
    if (gone) return;
    var pct = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
    var bar = document.getElementById('scroll-bar');
    if (!bar) return;
    if (pct > 55 && !shown) { bar.style.display = 'block'; shown = true; }
    else if (pct < 35 && shown) { bar.style.display = 'none'; shown = false; }
  }, { passive: true });
  var dismiss = document.getElementById('scroll-dismiss');
  if (dismiss) dismiss.addEventListener('click', function() {
    var bar = document.getElementById('scroll-bar');
    if (bar) bar.style.display = 'none';
    gone = true;
  });
})();

// Scanner logic
(function() {
  // PAINS is rendered server-side (see this file's frontmatter). The buttons
  // already exist in the HTML; this script only reads them and binds toggles.
  // It no longer builds the list, so the six labels survive a JS-less fetch.
  var list = document.getElementById('sc-list');
  if (!list) return;
  var P = Array.prototype.map.call(list.querySelectorAll('.pain-btn'), function(b) {
    return {
      id:    b.getAttribute('data-pain'),
      cost:  parseInt(b.getAttribute('data-cost'), 10) || 0,
      sol:   b.getAttribute('data-sol')   || '',
      url:   b.getAttribute('data-url')   || '',
      label: b.getAttribute('data-label') || '',
      _b:    b
    };
  });
  if (!P.length) return;
  var sel = [], cur = 0, tgt = 0, raf;
  P.forEach(function(p) {
    p._b.addEventListener('click', function() { scToggle(p, p._b); });
  });
  function scToggle(p, b) {
    var on = sel.indexOf(p.id) === -1;
    if (on) sel.push(p.id); else sel.splice(sel.indexOf(p.id), 1);
    b.classList.toggle('on', on); b.setAttribute('aria-checked', '' + on);
    var v = document.getElementById('chkv' + p.id); if (v) v.style.display = on ? 'block' : 'none';
    scUpdate();
  }
  function scUpdate() {
    var tot = 0, recs = [];
    P.forEach(function(p) { if (sel.indexOf(p.id) !== -1) { tot += p.cost; if (recs.indexOf(p.sol) === -1) recs.push(p.sol); } });
    tgt = tot; cancelAnimationFrame(raf);
    (function go() {
      if (cur < tgt) cur += Math.max(1, Math.ceil((tgt - cur) / 5));
      else if (cur > tgt) cur -= Math.max(1, Math.ceil((cur - tgt) / 5));
      var n = document.getElementById('sc-n'); if(n) n.textContent = cur.toLocaleString('en-US');
      if (cur !== tgt) raf = requestAnimationFrame(go);
    })();
    var res = document.getElementById('sc-result');
    if (res) res.className = 'scan-result' + (tot > 0 ? ' leak' : '');
    var yr = document.getElementById('sc-yr'); if(yr) yr.style.display = tot > 0 ? 'block' : 'none';
    var yn = document.getElementById('sc-yn'); if(yn) yn.textContent = (tot * 12).toLocaleString('en-US');
    var rc = document.getElementById('sc-recs'); if(rc){ rc.style.display = recs.length ? 'flex' : 'none'; rc.style.flexDirection='column'; }
    var rl = document.getElementById('sc-recs-list'); if(rl) rl.innerHTML = recs.map(function(r) { return '<div class="sr-recs-item">' + r + '</div>'; }).join('');
    var btn = document.getElementById('sc-btn');
    if (btn) {
      if (sel.length) { btn.disabled = false; btn.className = 'scan-cta ready'; btn.textContent = 'Build My Free Plan — Save $' + tot + '/mo →'; }
      else { btn.disabled = true; btn.className = 'scan-cta'; btn.textContent = 'Select at least one issue above'; }
    }
  }
  window.scNext = function() {
    if (!sel.length) return;
    var tot = 0, items = [];
    P.forEach(function(p) { if (sel.indexOf(p.id) !== -1) { tot += p.cost; items.push(p); } });
    var ph = document.getElementById('sc-plan-h'); if(ph) ph.textContent = 'You are losing ~$' + tot + '/mo';
    var pi = document.getElementById('sc-plan-items');
    if(pi) pi.innerHTML = items.map(function(p, i) {
      return '<div class="plan-item"><div class="plan-num">' + (i + 1) + '</div><div><div class="plan-sol">' + p.sol + '</div><div class="plan-fix">Fixes: ' + p.label + '</div><div class="plan-rec">Recovers ~$' + p.cost + '/mo → <a href="' + p.url + '" style="color:var(--g)">Deploy now →</a></div></div></div>';
    }).join('');
    var ss = document.getElementById('sc-scan'); if(ss) ss.style.display = 'none';
    var sp = document.getElementById('sc-plan'); if(sp) sp.style.display = 'block';
  };
  window.scSubmit = function() {
    var emailEl = document.getElementById('sc-email');
    var e = (emailEl ? emailEl.value : '').trim();
    if (!e || !e.includes('@')) { if (emailEl) { emailEl.style.borderColor = 'var(--red)'; emailEl.focus(); } return; }
    if (emailEl) emailEl.style.borderColor = '';
    fetch('/api/capture-email', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: e, tag: 'scanner-plan' })
    }).catch(function () {});
    var plan = document.getElementById('sc-plan'); if(plan) plan.style.display = 'none';
    var done = document.getElementById('sc-done'); if(done) done.style.display = 'block';
  };
})();

// Guide email capture
window.gfGet = function() {
  var emailEl = document.getElementById('gf-email');
  var e = (emailEl ? emailEl.value : '').trim();
  if (!e || !e.includes('@')) { if (emailEl) { emailEl.style.borderColor = 'var(--red)'; emailEl.focus(); } return; }
  if (emailEl) emailEl.style.borderColor = '';
  fetch('/api/capture-email', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ email: e, tag: 'homepage-capture' })
  }).catch(function () {});
  // Single popup only — the PDF is the thing the visitor actually asked for, and
  // one window.open per gesture survives mobile popup blocking. Signup is now
  // handled by the fetch above rather than a second window.
  window.open('https://d1yei2z3i6k35z.cloudfront.net/16370908/69a2ac505857c_The_Master_Library.pdf', '_blank');
  var form = document.getElementById('gf-form'); if(form) form.style.display = 'none';
  var done = document.getElementById('gf-done'); if(done) done.style.display = 'block';
  var confirm = document.getElementById('gf-confirm'); if(confirm) confirm.textContent = 'Guides on their way — check your inbox!';
};

// FAQ is rendered server-side from the FAQ array in this file's frontmatter.
// The old client-side injection loop lived here and is deliberately gone:
// native <details> needs no JavaScript, and AI crawlers do not run any.
</script>
</Base>

