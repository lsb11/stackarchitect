    <!-- FAQPage is generated from the FAQ array in this file's frontmatter, the
         same array that renders the visible <details> list below. Emitting it as
         a separate block (rather than inside the @graph literal) is what makes
         "schema count === rendered count" true by construction instead of by
         hand. Multiple ld+json blocks on one page are valid and are merged. -->
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>
