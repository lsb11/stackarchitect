<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--green:#00C896;--dark:#0d0d1a;--dark2:#1a1a2e;--border:#2a2a42;--text:#e8e8f0;--muted:#8888aa;--dim:#555570;--radius:8px;--font:'Inter',system-ui,sans-serif;--mono:'JetBrains Mono','Fira Code',monospace}
html{font-size:16px;scroll-behavior:smooth}
body{font-family:var(--font);color:var(--text);background:#0f0f1e;line-height:1.65;min-height:100vh}
a{color:var(--green);text-decoration:none}
a:hover{text-decoration:underline}
.site-header{background:var(--dark);border-bottom:1px solid var(--border);padding:14px 24px;display:flex;align-items:center;justify-content:space-between}
.brand{color:#fff;font-weight:700;font-size:1.05rem;font-family:var(--mono)}
.brand:hover{color:var(--green);text-decoration:none}
.header-nav{display:flex;gap:20px}
.header-nav a{font-size:.85rem;color:var(--muted)}
.header-nav a:hover{color:var(--green);text-decoration:none}
.wrap{max-width:900px;margin:0 auto;padding:48px 24px 80px}
.sitemap-header{display:flex;align-items:center;gap:20px;margin-bottom:40px;padding-bottom:28px;border-bottom:1px solid var(--border);flex-wrap:wrap}
.logo-block{display:flex;align-items:center;gap:14px}
.logo-block img{height:52px;width:auto;border-radius:6px}
.logo-text .name{font-size:1.4rem;font-weight:700;color:#fff;font-family:var(--mono);display:block}
.logo-text .tag{font-size:.72rem;color:var(--green);font-family:var(--mono);letter-spacing:.08em}
.sitemap-meta{margin-left:auto;font-size:.75rem;color:var(--dim);font-family:var(--mono);text-align:right;line-height:1.7}
h1{font-size:1.6rem;font-weight:700;color:#fff;margin-bottom:8px}
.lead{font-size:.9rem;color:var(--muted);margin-bottom:44px;line-height:1.75;max-width:620px}
.section{margin-bottom:36px}
.section-label{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:var(--green);font-family:var(--mono);margin-bottom:12px;display:flex;align-items:center;gap:10px}
.section-label::after{content:'';flex:1;height:1px;background:var(--border)}
.section-count{color:var(--dim);font-size:.68rem}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:6px}
.item{display:flex;align-items:flex-start;gap:8px;padding:10px 14px;border:1px solid var(--border);border-radius:6px;background:var(--dark2);transition:border-color .15s}
.item:hover{border-color:var(--green)}
.item-main{flex:1;min-width:0}
.item-main a{color:var(--text);font-size:.85rem;line-height:1.4;display:block}
.item-main a:hover{color:var(--green);text-decoration:none}
.item-path{display:block;font-size:.7rem;color:var(--dim);font-family:var(--mono);margin-top:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.badge{font-size:.62rem;font-weight:700;padding:2px 7px;border-radius:10px;white-space:nowrap;flex-shrink:0;margin-top:2px;font-family:var(--mono);letter-spacing:.03em}
.bn{background:rgba(0,200,150,.1);color:var(--green);border:1px solid rgba(0,200,150,.25)}
.bu{background:rgba(239,68,68,.1);color:#ef4444;border:1px solid rgba(239,68,68,.25)}
.bt{background:rgba(59,130,246,.1);color:#3b82f6;border:1px solid rgba(59,130,246,.25)}
.sitemap-foot{margin-top:44px;padding-top:20px;border-top:1px solid var(--border);font-size:.75rem;color:var(--dim);font-family:var(--mono);display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}
footer{background:var(--dark);border-top:1px solid var(--border);padding:20px 24px;text-align:center;font-size:.78rem;color:var(--dim);font-family:var(--mono)}
footer a{color:var(--dim)}
.back{color:var(--muted);font-size:.85rem;display:inline-flex;align-items:center;gap:6px;margin-bottom:28px}
.back:hover{color:var(--green);text-decoration:none}
@media(max-width:600px){.grid{grid-template-columns:1fr}.sitemap-meta{margin-left:0}.header-nav{display:none}}
</style>
  <!-- GA4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TE6Z6CW514"></script>
