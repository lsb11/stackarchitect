---
// The HTML sitemap. Until 9 Oct 2026 this was a hand-kept list, linked from
// nowhere, that omitted the agentic storefronts guide and the Gorgias review
// and claimed "140+ pages indexed". It now renders the same list as the
// homepage's "Every guide and tool" section (src/data/siteIndex.ts), which
// tests/site-index.test.js holds equal to the built sitemap.
import Base from '../layouts/Base.astro';
import SiteIndex from '../components/SiteIndex.astro';
import { SITE_INDEX_HREFS } from '../data/siteIndex';
const COUNT = SITE_INDEX_HREFS.length;
---
<Base
  title="All Pages: Stack Architect Sitemap"
  description={`Every page on Stack Architect, grouped by topic: ${COUNT} guides, free tools, calculators and product pages for Shopify tracking, inventory, email and automation.`}
>
<main class="sm-wrap" id="main-content">
  <h1>Every page on Stack Architect</h1>
  <p class="sm-lead">This is the complete list of {COUNT} pages on stackarchitect.xyz, grouped by the job each one does: ad tracking, AI commerce, inventory and P&amp;L, email and support, automation, and free calculators. Every guide opens with a short answer, then gives the full method with its sources and the date each figure was checked.</p>
  <SiteIndex headingLevel="h2" />
  <p class="sm-legal"><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/refund-policy/">Refund policy</a></p>
</main>
</Base>

<style>
  .sm-wrap { max-width: 1040px; margin: 0 auto; padding: 48px 24px 80px; }
  .sm-wrap h1 { font-size: 2rem; color: #f2f5f3; margin: 0 0 14px; }
  .sm-lead { color: #b6c0ba; max-width: 68ch; margin: 0 0 36px; line-height: 1.7; }
  .sm-legal { margin-top: 40px; color: #93a09a; font-size: 0.9rem; }
  .sm-legal a { color: #b6c0ba; }
</style>
