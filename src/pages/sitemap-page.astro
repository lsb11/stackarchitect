---
import Footer from '../components/Footer.astro';
import appsData from '../data/apps.json';
import { getCollection } from 'astro:content';

const allBlogs = await getCollection('blog');

const categories = {
  'ai': 'Blog — AI & Agentic Commerce',
  'support': 'Blog — AI Customer Support',
  'tracking': 'Blog — Ad tracking & ROAS',
  'inventory': 'Blog — Inventory & Analytics',
  'email': 'Blog — Email & P&L',
  'automation': 'Blog — Make.com & Automation',
  'workflow': 'Blog — Workflow & stability'
};

const groupedBlogs = {};
Object.keys(categories).forEach(key => groupedBlogs[key] = []);

allBlogs.forEach(post => {
  const cat = post.data.category || 'automation';
  if (groupedBlogs[cat]) {
    groupedBlogs[cat].push(post);
  } else {
    if (!groupedBlogs['other']) groupedBlogs['other'] = [];
    groupedBlogs['other'].push(post);
  }
});
// sitemap.astro — self-contained, no layout dependency
