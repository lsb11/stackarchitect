<script is:inline>
(function() {
  var header = document.querySelector('.product-terminal-bar');
  var cta    = document.getElementById('blog-nav-cta');

  if (cta) {
    var clone = cta.cloneNode(true);
    clone.id = 'blog-nav-cta-floating';
    clone.style.cssText = 'display:none;position:fixed;top:12px;left:50%;transform:translateX(-50%);z-index:999999;background:#15803d;color:#fff;border-color:#34d377;box-shadow:0 4px 15px rgba(0,168,84,.4);font-family:"JetBrains Mono",monospace;font-size:10px;font-weight:700;text-decoration:none;text-transform:uppercase;padding:8px 18px;border-radius:4px;border:1px solid #34d377;white-space:nowrap;';
    clone.textContent = 'REPLACE MY APPS \u2192';
    clone.href = '/go/make/?source=shopify-server-side-tracking-complete-setup-guide-floating';
    clone.target = '_blank';
    clone.rel = 'noopener sponsored';
    document.body.appendChild(clone);

    window.addEventListener('scroll', function() {
      var s = window.scrollY;
      if (header) header.classList.toggle('scrolled', s > 50);
      clone.style.display = s > 50 ? 'block' : 'none';
      cta.style.visibility = s > 50 ? 'hidden' : 'visible';
    }, { passive: true });
  }

  var path = window.location.pathname;
  document.querySelectorAll('.product-link').forEach(function(link) {
    var href = link.getAttribute('href');
    if (!href) return;
    if (href === path || (path === '/' && link.classList.contains('home-node'))) {
      link.classList.add('is-active');
    }
  });

  var mobileStyle = document.createElement('style');
  mobileStyle.textContent = '.dropdown.active .dropdown-menu{display:flex;}';
  document.head.appendChild(mobileStyle);

  document.querySelectorAll('.dropdown > .product-link').forEach(function(link) {
    link.addEventListener('click', function(e) {
      if (window.innerWidth <= 850) {
        e.preventDefault();
        var exp = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', String(!exp));
        this.parentElement.classList.toggle('active');
      }
    });
  });

  document.addEventListener('click', function(e) {
    if (!e.target.closest('.dropdown')) {
      document.querySelectorAll('.dropdown').forEach(function(d) { d.classList.remove('active'); });
    }
  });

  document.querySelectorAll('a[href*="make.com"], a[href*="systeme.io"]').forEach(function(link) {
    link.addEventListener('click', function() {
      var dest = this.href.indexOf('make.com') !== -1 ? 'make_com' : 'systeme_io';
      if (typeof gtag !== 'undefined') {
        gtag('event', 'affiliate_click', { event_category: 'affiliate', event_label: dest, link_url: this.href, page_location: window.location.href });
      }
    });
  });

  var scrollMilestones = { 25: false, 50: false, 75: false, 90: false };
  window.addEventListener('scroll', function() {
    var scrollPct = Math.round((window.scrollY / Math.max(1, document.body.scrollHeight - window.innerHeight)) * 100);
    Object.keys(scrollMilestones).forEach(function(m) {
      if (!scrollMilestones[m] && scrollPct >= parseInt(m)) {
        scrollMilestones[m] = true;
        if (typeof gtag !== 'undefined') {
          gtag('event', 'scroll_depth', { event_category: 'engagement', event_label: m + '%', page_location: window.location.href });
        }
      }
    });
  }, { passive: true });

  [30, 60, 120, 300].forEach(function(seconds) {
    setTimeout(function() {
      if (typeof gtag !== 'undefined') {
        gtag('event', 'time_on_page', { event_category: 'engagement', event_label: seconds + 's', page_location: window.location.href });
      }
    }, seconds * 1000);
  });
})();
</script>


