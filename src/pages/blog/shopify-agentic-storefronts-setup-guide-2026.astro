---
import Base from '../../layouts/Base.astro';
import Disclosure from '../../components/Disclosure.astro';
import CHANNELS from '../../data/agentic-storefronts-channels.json';

/* ---------------------------------------------------------------------------
 * The channel matrix, the timeline, the limits list and the Dataset JSON-LD all
 * read from src/data/agentic-storefronts-channels.json. That file carries a
 * verifiedDate and a source URL per channel.
 *
 * Why a data file rather than hand-written HTML: this page previously stated
 * six things that were wrong by August 2026 — a monthly fee for an app that is
 * free, Perplexity as a Shopify channel when it is not one, discount codes as
 * unsupported when they are supported, in-conversation ChatGPT checkout eight
 * months after OpenAI retired it, a January launch date for a December
 * announcement, and an "11x" statistic that had been superseded twice. Those
 * were spread across the prose, the FAQ copy and the JSON-LD independently, so
 * a correction in one place left the other two wrong. Now there is one record.
 *
 * The checkout model inverted on 24 March 2026 and most competing guides have
 * not caught up: ChatGPT redirects to the merchant's own checkout, while
 * Google, Copilot and Meta carry checkout inside the AI surface. Almost every
 * limitation merchants worry about applies ONLY to that direct-checkout path.
 * That distinction is the substance of this page.
 * ------------------------------------------------------------------------ */

const UPDATED = CHANNELS.verifiedDate;              // 2026-08-24
const PUBLISHED = '2026-03-21';
const CANONICAL = 'https://stackarchitect.xyz/blog/shopify-agentic-storefronts-setup-guide-2026/';

const shopifyChannels = CHANNELS.channels.filter((c) => c.inShopifyAdmin);
const directChannels = shopifyChannels.filter((c) => c.checkoutModel === 'direct');
const limits = CHANNELS.directCheckoutLimits;
const kb = CHANNELS.knowledgeBaseApp;

const prettyDate = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', {
    day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
  });

/* FAQ — one array. The visible <details> list and the FAQPage graph are both
   generated from it, so the count and the wording cannot drift apart. */
const FAQ = [
  {
    q: 'What are Shopify Agentic Storefronts?',
    a: "Shopify Agentic Storefronts connect your product catalog to AI assistants — ChatGPT, Google AI Mode and Gemini, Microsoft Copilot and Meta AI — through one setting in your Shopify admin, with no separate integration per platform. What each channel then does with a shopper differs: Google, Copilot and Meta complete the purchase inside their own interface, while ChatGPT sends the shopper to your own Shopify checkout. Announced in Shopify's Winter '26 Edition on 10 December 2025 and generally available to eligible merchants from 24 March 2026.",
  },
  {
    q: 'Does ChatGPT still let customers buy without leaving the chat?',
    a: 'No. OpenAI retired Instant Checkout on 24 March 2026, and Shopify’s documentation now describes ChatGPT as a discovery-focused referrer: shoppers complete the purchase on your own Shopify checkout, opened in the ChatGPT in-app browser or a new tab. This matters more than it sounds. Because the transaction happens on your checkout, the product-type restrictions, fulfilment restrictions and pixel restrictions that apply to direct checkout do not apply to ChatGPT traffic at all — your normal checkout rules and your client-side pixels work as they always have. Guides published before 24 March 2026 describe the opposite arrangement.',
  },
  {
    q: 'Am I eligible for Shopify Agentic Storefronts?',
    a: 'Eligibility is per channel, not one blanket rule, and it stacks two separate conditions: where your store is based, and where you sell. ChatGPT, Microsoft Copilot and Meta AI accept a store based in any country provided it sells to customers in the United States. Google AI Mode and Gemini require the store itself to be based in the United States, United Kingdom, Australia or Canada and to sell into one of those four countries — and even then, direct checkout renders only for US-based customers, with everyone else redirected. Google also remains in early access and requires the Google & YouTube sales channel with product and shipping sync enabled. Agentic storefronts are active by default for eligible stores; the setting lives under Sales channels, then Agentic.',
  },
  {
    q: 'How much does the Shopify Knowledge Base app cost?',
    a: 'It is free. The Shopify Knowledge Base app is published by Shopify, launched on 16 May 2025, and its App Store listing shows no paid tier and no Plus-only pricing. Guides quoting a monthly fee for standard plans appear to be describing third-party knowledge-base apps instead. The app is not visible on your storefront — your FAQs serve as a data source that AI platforms read when answering questions about your products.',
  },
  {
    q: 'Which products cannot be sold through Agentic Storefronts?',
    a: 'Subscriptions, product bundles, digital products, customizable products and B2B-only products are not supported in agentic storefront direct checkouts. Local delivery, pickup in store and pickup points are not available as delivery methods, and custom checkout fields, checkout upsells, checkout validations and required customer sign-in do not work either. Every one of those restrictions applies to the direct-checkout channels only — Google, Copilot and Meta. ChatGPT sends shoppers to your own checkout, where none of them apply.',
  },
  {
    q: 'Do discount codes work in agentic checkout?',
    a: 'Yes. Shopify’s documentation states that automatic discounts and discount codes you set up are both supported in agentic storefront direct checkouts. Several widely-shared guides claim the opposite; that claim does not match Shopify’s current documentation.',
  },
  {
    q: 'Will Google Analytics and my Meta pixel track agentic orders?',
    a: 'Not in direct checkout. Shopify states that Google Analytics and custom pixels will not fire there — only server-to-server pixels for the started and completed events. So an order placed inside Google AI Mode, Copilot or Meta AI reaches your Shopify admin but arrives in GA4 and Meta Ads Manager with no client-side event behind it. If you buy ads and measure return on ad spend from browser pixels, those orders look like they came from nowhere. Server-side tracking is the fix, and it is worth having in place before you enable the channels rather than after. ChatGPT is unaffected — that checkout is yours, so your pixels fire normally.',
  },
  {
    q: 'Does Shopify charge a fee for selling through AI channels?',
    a: 'No. Shopify’s documentation states there are no fees associated with selling in ChatGPT, in Google AI Mode and Gemini’s direct checkout, or in agentic storefront direct checkouts generally. You pay your standard payment processing fees and nothing further. Shopify also offers a separate free Agentic plan aimed at merchants who do not use Shopify as their primary storefront; it excludes the Online Store, gift cards, manual orders and Shop post-purchase offers.',
  },
  {
    q: 'Is Perplexity a Shopify agentic channel?',
    a: 'No, despite appearing in Shopify’s December 2025 launch announcement. In-chat buying on Perplexity runs on PayPal Instant Buy, those orders are managed through PayPal rather than your Shopify admin, and merchants apply to the Perplexity Merchant Program separately. Perplexity is no longer listed as an Agentic Storefronts channel in Shopify’s help documentation. Guides presenting it as a Shopify channel with redirect checkout are describing an arrangement that does not exist.',
  },
  {
    q: 'My store is not eligible yet. Is any of this worth doing now?',
    a: 'Yes, because discovery already happens without it. AI assistants crawl the web and read Shopify Catalog regardless of your agentic settings — what the feature adds is the checkout, not the visibility. Four things pay off immediately: install and populate the free Knowledge Base app, complete your product data so AI assistants can match products to conversational queries, add FAQPage structured data to your content, and get server-side tracking working so you have no attribution gap on the day the channels switch on.',
  },
];

const stripTags = (html: string) =>
  html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();

/* Dataset — the matrix is the citable artefact on this page. Naming each field
   as a variableMeasured is what lets a model quote a single cell (\"Google
   requires a store based in the US, UK, AU or CA\") and attribute it. */
const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': CANONICAL + '#matrix',
  name: 'Shopify Agentic Storefronts — per-channel eligibility and capability matrix (August 2026)',
  description: CHANNELS.description,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  creator: { '@id': 'https://stackarchitect.xyz/#org' },
  isPartOf: { '@id': CANONICAL },
  dateModified: UPDATED,
  temporalCoverage: '2025-12-10/' + UPDATED,
  variableMeasured: [
    ...CHANNELS.channels.flatMap((c) => [
      { '@type': 'PropertyValue', name: `${c.name} — checkout model`, value: c.checkoutModel },
      { '@type': 'PropertyValue', name: `${c.name} — store must be based in`, value: c.storeLocationRule },
      { '@type': 'PropertyValue', name: `${c.name} — must sell to customers in`, value: c.customerLocationRule },
      { '@type': 'PropertyValue', name: `${c.name} — channel fee`, value: c.fee },
    ]),
    { '@type': 'PropertyValue', name: 'Direct checkout — unsupported product types', value: limits.unsupportedProductTypes.join('; ') },
    { '@type': 'PropertyValue', name: 'Direct checkout — unsupported delivery methods', value: limits.unsupportedFulfilment.join('; ') },
    { '@type': 'PropertyValue', name: 'Direct checkout — discount codes supported', value: 'Yes' },
    { '@type': 'PropertyValue', name: 'Direct checkout — client-side pixels fire', value: 'No; server-to-server started and completed events only' },
    { '@type': 'PropertyValue', name: 'Shopify Knowledge Base app price', value: kb.price },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': CANONICAL + '#faq',
  inLanguage: 'en-GB',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) },
  })),
};

/* Base.astro emits the Article node (from pageType="article") and the
   BreadcrumbList (from the `breadcrumb` prop), so neither is repeated here.
   This graph carries only what the layout cannot infer: the HowTo. */
const graphSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'HowTo',
      '@id': CANONICAL + '#howto',
      name: 'How to set up Shopify Agentic Storefronts',
      description:
        'Six steps to check eligibility, prepare product and knowledge-base data, close the attribution gap and enable AI sales channels in the Shopify admin.',
      totalTime: 'PT45M',
      estimatedCost: { '@type': 'MonetaryAmount', currency: 'USD', value: '0' },
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Check eligibility, per channel', text: 'Open Shopify admin, then Sales channels, then Agentic. Eligibility is per channel: ChatGPT, Copilot and Meta accept any store location selling to US customers; Google AI Mode and Gemini require a store based in the US, UK, Australia or Canada.' },
        { '@type': 'HowToStep', position: 2, name: 'Install the free Knowledge Base app', text: 'Install the Shopify Knowledge Base app, which is free, and populate it with FAQs, return and shipping detail and brand voice guidance. It is invisible on your storefront and serves as the data source AI platforms read.' },
        { '@type': 'HowToStep', position: 3, name: 'Close the attribution gap before enabling', text: 'Direct checkout fires only server-to-server started and completed pixels. Get server-side tracking working first so agentic orders are attributed rather than appearing to come from nowhere.' },
        { '@type': 'HowToStep', position: 4, name: 'Audit the catalog against the unsupported list', text: 'Subscriptions, bundles, digital products, customizable products and B2B-only products are unsupported in agentic direct checkout. Confirm which of your products are affected and on which channels.' },
        { '@type': 'HowToStep', position: 5, name: 'Write product data for conversational queries', text: 'AI assistants match intent, not keywords. Give every product a descriptive title, a description of 200 words or more covering materials and use cases, every variant defined with accurate stock, and metafields for the specifics a description omits.' },
        { '@type': 'HowToStep', position: 6, name: 'Enable channels and verify', text: 'Agree to the Agentic Storefronts Supplemental Terms and toggle each channel individually. Use the Test Agent to confirm products surface correctly, then filter the Orders list by channel to monitor AI-attributed revenue.' },
      ],
    },
  ],
};
---
<Base
  title="Shopify Agentic Storefronts — Eligibility & Limits 2026"
  description="Which AI channels Shopify Agentic Storefronts covers, who qualifies, where checkout happens after the March 2026 change, and which limits apply where."
  canonical={CANONICAL}
  pageType="article"
  publishDate={PUBLISHED}
  updatedDate={UPDATED}
  breadcrumb={[
    { label: 'Home', href: '/' },
    { label: 'Guides', href: '/shopify-automation-guides/' },
    { label: 'Shopify Agentic Storefronts' },
  ]}
>
<Fragment slot="head">
  <script type="application/ld+json" set:html={JSON.stringify(graphSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(datasetSchema)} />
</Fragment>


<!-- ══════════════════════════════════════════
  NAV
══════════════════════════════════════════ -->

<!-- ══════════════════════════════════════════
  BREADCRUMB
══════════════════════════════════════════ -->
<main id="main-content">
{/* Breadcrumb comes from Base.astro via the `breadcrumb` prop — it also
    emits the BreadcrumbList JSON-LD, so a second hand-rolled trail here would
    render twice and describe itself twice. */}
<div class="blog-title-band">
  <h1>Shopify Agentic Storefronts 2026 &mdash; Eligibility, Checkout and Limits, Per Channel</h1>
  <div class="band-meta">Updated {prettyDate(UPDATED)} &middot; Verified against Shopify&rsquo;s documentation &middot; 12 min read</div>
</div>

<div class="article-outer">
<div class="sa-agentic">

  <p id="answer" class="sa-answer">Shopify Agentic Storefronts connect your catalog to ChatGPT, Google AI Mode, Microsoft Copilot and Meta AI from one admin setting. Since 24 March 2026 the channels split: Google, Copilot and Meta complete checkout inside the AI surface, while ChatGPT redirects shoppers to your own Shopify checkout &mdash; which is why most limits apply to only some channels.</p>

  <div class="callout amber" id="stale-warning">
    <span class="callout-label">&#9888; If you have read other guides on this, check their date</span>
    <p>This feature reversed itself on <strong>24 March 2026</strong>. ChatGPT launched with in-conversation Instant Checkout; OpenAI retired it that day, and Shopify&rsquo;s documentation now describes ChatGPT as a discovery-focused referrer that sends shoppers to your own checkout. Meanwhile Google, Copilot and Meta gained direct checkout. Most guides still in circulation describe the launch arrangement, which is the opposite of the current one &mdash; and they inherit a set of restrictions from it that no longer apply the way they say.</p>
  </div>

  <!-- ═══════ THE MATRIX — the citable artefact ═══════ -->
  <div class="sec-mark" id="matrix">01 &mdash; The matrix: who is eligible for what</div>
  <div class="prose">
    <h2>Eligibility and capability, per channel</h2>
    <p>Eligibility is not one rule. It stacks two independent conditions &mdash; where your store is based, and where you sell &mdash; and they differ by channel. A merchant in Manchester is eligible for three of the four channels and, for the fourth, eligible to appear but not to take checkout from most of their customers. That is genuinely hard to work out from Shopify&rsquo;s documentation, because it is spread across four pages.</p>
    <p>Every cell below is sourced. The linked page is Shopify&rsquo;s, not ours.</p>
  </div>

  <div class="table-wrap">
    <table class="matrix-table">
      <caption class="tbl-caption">Shopify Agentic Storefronts, verified {prettyDate(CHANNELS.verifiedDate)} against {CHANNELS.verifiedAgainst}</caption>
      <thead>
        <tr>
          <th scope="col">Channel</th>
          <th scope="col">Where checkout happens</th>
          <th scope="col">Your store must be based in</th>
          <th scope="col">You must sell to</th>
          <th scope="col">Fee</th>
        </tr>
      </thead>
      <tbody>
        {CHANNELS.channels.map((c) => (
          <tr class={c.inShopifyAdmin ? '' : 'row-out'}>
            <th scope="row" class="col-ch">
              {c.name}
              <a class="cell-src" href={c.source} target="_blank" rel="noopener" aria-label={`Shopify documentation for ${c.name}`}>source&nbsp;&#8599;</a>
            </th>
            <td>
              <span class={`ck ck-${c.checkoutModel}`}>{
                c.checkoutModel === 'direct' ? 'In the AI surface'
                : c.checkoutModel === 'redirect' ? 'Your own checkout'
                : 'Outside Shopify'
              }</span>
            </td>
            <td>{c.storeLocationRule}</td>
            <td>{c.customerLocationRule}</td>
            <td>{c.fee}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="table-note">Perplexity is listed because it is widely described as a Shopify agentic channel and is not one. It appeared in Shopify&rsquo;s December 2025 announcement and has since been dropped from the help documentation.</p>

  <div class="callout green">
    <span class="callout-label">The distinction that decides everything else</span>
    <p><strong>Direct checkout</strong> &mdash; {directChannels.map((c) => c.name).join(', ')} &mdash; happens inside the AI product. Shopify&rsquo;s restrictions on product types, delivery methods, checkout extensions and tracking pixels all apply there.<br><br>
    <strong>ChatGPT is a redirect.</strong> The shopper lands on your Shopify checkout. Your checkout rules, your extensions, your subscriptions, your bundles and your client-side pixels all behave exactly as they do for any other visitor. <strong>None of the direct-checkout restrictions apply to ChatGPT traffic.</strong> Almost every guide on this subject blurs those two paths into one list of limitations, which makes the feature sound far more constrained than it is.</p>
  </div>

  <!-- ═══════ LIMITS ═══════ -->
  <div class="sec-mark" id="limits">02 &mdash; What breaks, and only where</div>
  <div class="prose">
    <h2>Direct-checkout restrictions</h2>
    <p>These apply to {directChannels.map((c) => c.name).join(', ')}. They do not apply to ChatGPT.</p>
  </div>

  <div class="lim-grid">
    <div class="lim-card">
      <div class="lim-h">Product types that cannot be sold</div>
      <ul class="lim-ul">{limits.unsupportedProductTypes.map((x) => <li>{x}</li>)}</ul>
    </div>
    <div class="lim-card">
      <div class="lim-h">Delivery methods unavailable</div>
      <ul class="lim-ul">{limits.unsupportedFulfilment.map((x) => <li>{x}</li>)}</ul>
    </div>
    <div class="lim-card">
      <div class="lim-h">Checkout features that do not run</div>
      <ul class="lim-ul">{limits.unsupportedCheckoutFeatures.map((x) => <li>{x}</li>)}</ul>
    </div>
    <div class="lim-card lim-ok">
      <div class="lim-h">Works, despite what you may have read</div>
      <ul class="lim-ul">
        <li>Automatic discounts</li>
        <li>Discount codes</li>
      </ul>
      <p class="lim-quote">&ldquo;{limits.discounts.quote}&rdquo;</p>
    </div>
  </div>

  <div class="callout sky">
    <span class="callout-label">A correction worth making explicitly</span>
    <p>Several widely-shared guides state that discount codes may not work in agentic checkout. Shopify&rsquo;s documentation says the opposite, in those words. If you have been holding a promotion back from these channels on that basis, you did not need to.</p>
  </div>

  <!-- ═══════ ATTRIBUTION ═══════ -->
  <div class="sec-mark" id="attribution">03 &mdash; The attribution gap, and what to do about it</div>
  <div class="prose">
    <h2>Your agentic orders will look like they came from nowhere</h2>
    <p>This is the limitation with real money attached, and it is the one every competing guide quotes without operationalising. Shopify states it plainly:</p>
  </div>

  <blockquote class="pull-quote">
    &ldquo;{limits.pixels.quote}&rdquo;
    <cite><a href={limits.source} target="_blank" rel="noopener">Shopify Help Center &mdash; AI channels with built-in checkout</a></cite>
  </blockquote>

  <div class="prose">
    <p>Read carefully, that means an order placed inside Google AI Mode, Copilot or Meta AI reaches your Shopify admin correctly &mdash; revenue is not lost &mdash; but arrives in GA4 and in Meta Ads Manager with no client-side event behind it. Only two server-to-server events fire: <code>started</code> and <code>completed</code>.</p>
    <p>If you buy ads and measure return on ad spend from browser pixels, the consequence is specific: the AI channels will appear to convert at zero while quietly taking revenue, and the campaigns that fed them will be under-credited. Optimisation algorithms fed under-reported conversions bid down. You are not just missing a number in a dashboard; you are training your ad accounts on a false signal.</p>
    <h3>What actually closes it</h3>
    <ul>
      <li><strong>Shopify&rsquo;s native Customer events pixels</strong> fire server-side and will capture agentic orders once configured under <strong>Settings &rarr; Customer events</strong>. This is the baseline and it costs nothing.</li>
      <li><strong>Meta Conversions API</strong> needs to be sending Purchase events server-side rather than relying on the browser pixel. Our free <a href="/capi-shield/">CAPI Shield</a> build does this through a Make.com webhook.</li>
      <li><strong>Google Enhanced Conversions</strong> likewise, via a server-side container or Shopify&rsquo;s Google channel &mdash; see <a href="/shopify-google-ads-conversion-tracking/">the free Enhanced Conversions setup</a>.</li>
    </ul>
    <p>The sequencing matters more than the tooling. Turn the channels on before server-side tracking is live and you get a period of unattributed revenue you cannot reconstruct afterwards, because the events were never recorded. Turn tracking on first and there is no gap to explain.</p>
  </div>

  <div class="inline-cta green">
    <div class="ict-text">
      <h4>Close the gap before you enable the channels</h4>
      <p>CAPI Shield is free server-side tracking for Meta and Google, built on Make.com&rsquo;s free tier. Roughly an hour to deploy, and it is the difference between attributed and invisible agentic revenue.</p>
    </div>
    <a href="/capi-shield/" class="btn btn-g">Deploy CAPI Shield &mdash; free &rarr;</a>
  </div>

  <!-- ═══════ SETUP ═══════ -->
  <div class="sec-mark" id="setup">04 &mdash; Setup, in the order that avoids rework</div>
  <div class="prose">
    <h2>How to set up Shopify Agentic Storefronts</h2>
    <p>Around 45 minutes if your catalog is already clean, longer if product descriptions need work. Agentic storefronts are active by default for eligible stores, so step one is often confirmation rather than activation.</p>
  </div>

  <div class="step-list">
    <div class="step-item">
      <div class="step-num-col"><span class="step-n">1</span></div>
      <div class="step-body">
        <div class="step-title">Check eligibility, per channel <span class="step-req-tag sr-req">start here</span></div>
        <div class="step-desc">Shopify admin &rarr; <strong>Sales channels &rarr; Agentic</strong>. Read your row in the matrix above before assuming a single yes or no &mdash; you may be eligible for three channels and not the fourth, and Google remains in early access even where you qualify on paper.</div>
        <span class="step-time">&#9203; 2 minutes</span>
      </div>
    </div>
    <div class="step-item">
      <div class="step-num-col"><span class="step-n">2</span></div>
      <div class="step-body">
        <div class="step-title">Install the Knowledge Base app <span class="step-req-tag sr-rec">free</span></div>
        <div class="step-desc">Published by Shopify, <strong>free</strong>, and invisible on your storefront. It is the data source AI assistants read when a shopper asks about returns, sizing or shipping. See section 5 for what to put in it &mdash; most merchants install it and write nothing, which wastes the only lever they have over what AI says about them.</div>
        <span class="step-time">&#9203; 20&ndash;30 minutes</span>
      </div>
    </div>
    <div class="step-item">
      <div class="step-num-col"><span class="step-n">3</span></div>
      <div class="step-body">
        <div class="step-title">Get server-side tracking live <span class="step-req-tag sr-req">before enabling</span></div>
        <div class="step-desc">Out of order, this one costs money. Direct checkout fires only server-to-server events, so any agentic revenue earned before your server-side setup exists is permanently unattributed. See section 3.</div>
        <span class="step-time">&#9203; ~1 hour</span>
      </div>
    </div>
    <div class="step-item">
      <div class="step-num-col"><span class="step-n">4</span></div>
      <div class="step-body">
        <div class="step-title">Audit your catalog against the unsupported list <span class="step-req-tag sr-rec">recommended</span></div>
        <div class="step-desc">Subscriptions, bundles, digital products, customizable products and B2B-only products cannot go through direct checkout. Work out which of your products that covers, and remember it does not constrain ChatGPT traffic at all &mdash; a subscription brand is not locked out of agentic commerce, it is locked out of three of the four channels&rsquo; checkout.</div>
        <span class="step-time">&#9203; Depends on catalog size</span>
      </div>
    </div>
    <div class="step-item">
      <div class="step-num-col"><span class="step-n">5</span></div>
      <div class="step-body">
        <div class="step-title">Write product data for conversation, not keywords <span class="step-req-tag sr-rec">recommended</span></div>
        <div class="step-desc">A product called &ldquo;Blue Sneaker&rdquo; loses to &ldquo;Men&rsquo;s Wide-Fit Running Sneaker &mdash; Breathable Mesh, Cushioned Sole, UK 7&ndash;13&rdquo; when someone asks for a comfortable wide-fit running shoe. See section 6.</div>
        <span class="step-time">&#9203; Variable</span>
      </div>
    </div>
    <div class="step-item">
      <div class="step-num-col"><span class="step-n">6</span></div>
      <div class="step-body">
        <div class="step-title">Enable, verify, monitor <span class="step-req-tag sr-new">activation</span></div>
        <div class="step-desc">Agree to the Supplemental Terms and toggle each channel individually. Use <strong>Test Agent</strong> to confirm products surface correctly, then filter your Orders list by channel. The dashboard also exposes the queries shoppers typed before finding you &mdash; unfiltered intent language, and the most useful by-product of the whole feature.</div>
        <span class="step-time">&#9203; 5 minutes, then ongoing</span>
      </div>
    </div>
  </div>

  <!-- ═══════ KNOWLEDGE BASE ═══════ -->
  <div class="sec-mark" id="knowledge-base">05 &mdash; The Knowledge Base app</div>
  <div class="prose">
    <h2>What to actually write in the Knowledge Base</h2>
    <div class="vbox green">
      <strong>It is free.</strong> {kb.priceNote} Published by Shopify on {prettyDate(kb.launched)}: <a href={kb.source} target="_blank" rel="noopener">App Store listing &#8599;</a>
    </div>
    <p>Shopify describes it precisely: &ldquo;{kb.quote}&rdquo; Nothing you write appears on your storefront. It exists solely to be read by machines &mdash; which makes it the only place you get to speak directly to the model that will paraphrase you to a customer.</p>
    <h3>FAQs &mdash; 15 to 20, written for the purchase decision</h3>
    <p>Cover shipping times and costs, the return process in specifics rather than generalities, sizing and fit, materials and care, warranty, and what actually differentiates you. Write plainly. AI assistants paraphrase, and marketing tone survives paraphrasing badly &mdash; clarity survives it well.</p>
    <h3>The customer-friendly version of your returns policy</h3>
    <p>Your policies page is a legal document. This entry should be what the process actually involves: how long a refund takes, what &ldquo;free returns&rdquo; means in practice, the exceptions. This is what gets cited when a shopper asks whether you are safe to buy from.</p>
    <h3>Brand voice, and compliance language</h3>
    <p>Specify tone, phrases to use or avoid, and how to describe your core benefits. For supplements, medical devices or anything regulated this stops being a branding exercise: paraphrasing by an AI assistant can produce claims you are not allowed to make, and this is where you constrain that.</p>
    <h3>Shipping and fulfilment specifics</h3>
    <p>Processing times, carriers, tracked versus untracked, delivery estimates by region, international availability, and what happens when an order is late. &ldquo;3&ndash;5 business days&rdquo; is usable. &ldquo;Fast shipping&rdquo; is not.</p>
  </div>

  <!-- ═══════ PRODUCT DATA ═══════ -->
  <div class="sec-mark" id="product-data">06 &mdash; Product data for AI discovery</div>
  <div class="prose">
    <h2>Writing product data an assistant can match</h2>
    <p>AI assistants interpret intent rather than matching keywords, and they answer with whichever product they can most confidently describe. Thin data does not rank badly &mdash; it fails to be selected at all, because the model has nothing to say about it.</p>
    <h3>Titles</h3>
    <p><strong>Brand + product type + key differentiator + size or variant.</strong> Sixty to eighty characters. Use the words customers say out loud, not internal SKU language.</p>
    <h3>Descriptions</h3>
    <p>Two hundred words minimum. What it is in a plain first sentence, materials and specifications, who it is for and in what situation, how it compares to the obvious alternatives, care, and any certification. Short paragraphs and lists parse more reliably than dense prose.</p>
    <h3>Variants and stock</h3>
    <p>Assistants will not recommend what shows as out of stock. Five colours and eight sizes means forty defined combinations with real counts &mdash; &ldquo;multiple options available&rdquo; is invisible to a model trying to answer &ldquo;do they have it in a 10?&rdquo;.</p>
    <h3>Metafields</h3>
    <p>Material composition, care instructions, suitability, country of manufacture, certifications, compatible products. Metafields answer the specific question your description did not anticipate.</p>
  </div>

