---
import Base from '../layouts/Base.astro';
import AuthorCard from '../components/AuthorCard.astro';
import TableOfContents from '../components/TableOfContents.astro';
import FeaturedIn from '../components/FeaturedIn.astro';
import PressCitation from '../components/PressCitation.astro';

// Hero layout under evaluation: 'a' = 150px portrait stacked above the H1,
// 'b' = two-column split with the type bottom-aligned to the portrait.
const HERO_VARIANT: 'a' | 'b' = 'a';

const tocHeadings = [
  {
    "id": "where-this-knowledge-comes-from",
    "text": "Where this knowledge comes from"
  },
  {
    "id": "what-i-work-with-directly",
    "text": "What I work with directly"
  },
  {
    "id": "i-ship-products-not-just-guides",
    "text": "I ship products, not just guides"
  },
  {
    "id": "full-transparency",
    "text": "Full transparency"
  },
  {
    "id": "what-i-ve-built",
    "text": "What I've built"
  },
  {
    "id": "get-in-touch",
    "text": "Get in touch"
  }
];

---
<Base title="About Luke Sandelands — Founder, Stack Architect" description="Luke Sandelands builds free, open-source Shopify automation tools that replace paid apps. Hands-on with Make.com, Meta CAPI and Google Enhanced Conversions.">
<Fragment slot="head">
