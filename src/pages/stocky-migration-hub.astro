---
import Base from '../layouts/Base.astro';
import AuthorCard from '../components/AuthorCard.astro';
import TLDR from '../components/TLDR.astro';

const title = "Shopify Stocky Migration Command Center | August 2026";
const description = "Shopify Stocky is shutting down permanently on August 31, 2026. This is the ultimate hub to export your data, assess your risk, and migrate to a free automated workflow before the deadline.";
const canonicalUrl = "https://stackarchitect.xyz/stocky-migration-hub/";

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  author: {
    '@type': 'Person',
    name: 'Luke',
    url: 'https://stackarchitect.xyz/about'
  },
  publisher: {
    '@type': 'Organization',
    name: 'Stack Architect',
    logo: {
      '@type': 'ImageObject',
      url: 'https://stackarchitect.xyz/logo.png'
    }
  },
  datePublished: new Date().toISOString(),
  dateModified: new Date().toISOString()
};

const schemas = [articleSchema];
---

<Base
  title={title}
  description={description}
  canonical={canonicalUrl}
  schema={schemas}
  pageType="article"
>
  <main class="flex-1 max-w-4xl mx-auto px-4 py-12 w-full">
    <div class="mb-10 text-center">
      <span class="inline-block px-3 py-1 mb-4 text-xs font-mono font-bold tracking-widest text-red-500 border border-red-500 rounded-full uppercase bg-red-500/10">
        CRITICAL DEADLINE: AUGUST 31, 2026
      </span>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-white mb-6">
        The Stocky Migration Command Center
      </h1>
      <p class="text-lg text-gray-400 font-mono max-w-2xl mx-auto">
        Stocky is shutting down. Your purchase orders, supplier data, and inventory history will be deleted. Use the resources below to migrate your data today.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
      
      <!-- Resource 1 -->
      <a href="/stocky-shutdown/" class="block bg-[#111311] border border-gray-800 hover:border-red-500/50 p-6 rounded-2xl transition-all hover:shadow-[0_0_30px_rgba(239,68,68,0.1)]">
        <div class="w-12 h-12 bg-red-500/10 rounded-xl flex items-center justify-center mb-4 text-red-500">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">What Happens When Stocky Shuts Down?</h3>
        <p class="text-gray-400 text-sm">Understand the exact timeline, what data will be deleted on August 31, and what will automatically migrate to Shopify native admin.</p>
      </a>

      <!-- Resource 2 -->
      <a href="/stocky-swap/" class="block bg-[#111311] border border-gray-800 hover:border-[#34d377]/50 p-6 rounded-2xl transition-all hover:shadow-[0_0_30px_rgba(52,211,119,0.1)]">
        <div class="w-12 h-12 bg-[#34d377]/10 rounded-xl flex items-center justify-center mb-4 text-[#34d377]">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">Stocky Swap: The Free Replacement</h3>
        <p class="text-gray-400 text-sm">Don't pay $300/mo for an enterprise inventory app. Deploy our free, open-source Make.com automation architecture to replace Stocky.</p>
      </a>

      <!-- Resource 3 -->
      <a href="/blog/shopify-stocky-data-export-before-shutdown/" class="block bg-[#111311] border border-gray-800 hover:border-blue-500/50 p-6 rounded-2xl transition-all hover:shadow-[0_0_30px_rgba(59,130,246,0.1)]">
        <div class="w-12 h-12 bg-blue-500/10 rounded-xl flex items-center justify-center mb-4 text-blue-500">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">The Complete Data Export Guide</h3>
        <p class="text-gray-400 text-sm">Step-by-step instructions on how to export your purchase orders, supplier profiles, and historical margins before the servers are wiped.</p>
      </a>

      <!-- Resource 4 -->
      <a href="/stocky-migration-checklist/" class="block bg-[#111311] border border-gray-800 hover:border-purple-500/50 p-6 rounded-2xl transition-all hover:shadow-[0_0_30px_rgba(168,85,247,0.1)]">
        <div class="w-12 h-12 bg-purple-500/10 rounded-xl flex items-center justify-center mb-4 text-purple-500">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">The Migration Checklist & Risk Scorer</h3>
        <p class="text-gray-400 text-sm">Are you using features that will break your store if not migrated properly? Take the risk assessment and follow the checklist.</p>
      </a>

    </div>

    <section class="pro-cta" style="margin: 64px auto; max-width: 860px; padding: 40px; background: linear-gradient(135deg, rgba(52,211,119,0.1), rgba(12,15,13,0.9)); border: 2px solid var(--g); border-radius: 16px; text-align: center;">
      <h2 style="font-size: 28px; color: var(--text); margin-bottom: 16px; font-weight: 800;">The Complete Shopify Automation Kit (Pro)</h2>
      <p style="font-size: 16px; color: var(--text-2); margin-bottom: 32px; max-width: 600px; margin-inline: auto;">Skip the setup and get all 40+ systems pre-built. Includes the exact Make.com blueprints, CAPI templates, and AI prompts we use for 7-figure stores, including the full Stocky replacement system.</p>
      <a href="/pro/" class="btn-g" style="font-size: 18px; padding: 16px 32px;">Get the Pro Bundle →</a>
    </section>

    <div class="border-t border-gray-800 pt-12 mt-12">
      <AuthorCard />
    </div>
  </main>
</Base>
