---
import KeyFacts from '../components/KeyFacts.astro';
import ToolShot from '../components/ToolShot.astro';
import { pageUpdated } from '../data/pageUpdated';
import Base from '../layouts/Base.astro';
import AuthorCard from '../components/AuthorCard.astro';
import TableOfContents from '../components/TableOfContents.astro';
import appsData from '../data/apps.json';
import Disclosure from '../components/Disclosure.astro';
import PriceSources from '../components/PriceSources.astro';
import JumpTo from '../components/JumpTo.astro';
import { READ_DATE, SOURCES } from '../data/priceSources';

const SITE = "https://stackarchitect.xyz";
const canonical = `${SITE}/shopify-attribution-tools-compared/`;

const title = "Shopify Attribution Tools Compared — 4 Pricing Models";
const description =
  "Elevar, Triple Whale, Northbeam and Analyzify each price on a different axis, so one store gets four wildly different quotes. Worked example inside.";

const dateModified = pageUpdated('/shopify-attribution-tools-compared/')!;

// ── vendor records ──────────────────────────────────────────────────────────
// Only apps.json figures carry a verification date and a vendor-page source.
// Everything else on this page is third-party reported and marked as such.
interface AppProfile {
  id: string;
  name: string;
  category: string;
  description: string;
  monthlyCost: string;
  priceVerifiedDate: string | null;
  priceSourceUrl: string | null;
}
const byId = new Map((appsData as AppProfile[]).map((a) => [a.id, a]));
const ids = ["elevar", "triple-whale", "northbeam", "analyzify"];
const records = ids.map((id) => byId.get(id)!).filter(Boolean);

// Offer is emitted only where BOTH priceVerifiedDate and priceSourceUrl exist.
// Triple Whale no longer passes it: on 19 October 2026 its pricing page showed
// no price for Foundation or Automate, only a walkthrough booking, so apps.json
// holds it (priceHeldReason) and it carries no Offer. No
// figure from the research brief is admitted here — structured data carries
// only what was read from the vendor's own page and recorded in apps.json.
function offerFor(app: AppProfile) {
  if (!app.priceVerifiedDate || !app.priceSourceUrl) return null;
  const s = String(app.monthlyCost).replace(/,/g, "");
  const nums = [...s.matchAll(/\$\s*([0-9]+(?:\.[0-9]+)?)/g)].map((m) => parseFloat(m[1]));
  if (!nums.length) return null;
  const openEnded = s.includes("+");
  const base = {
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    url: app.priceSourceUrl,
    priceVerifiedDate: app.priceVerifiedDate,
  };
  if (nums.length === 1 && !openEnded) return { "@type": "Offer", ...base, price: String(nums[0]) };
  const agg: Record<string, unknown> = { "@type": "AggregateOffer", ...base, lowPrice: String(nums[0]) };
  if (nums.length > 1) agg.highPrice = String(nums[nums.length - 1]);
  return agg;
}

// Every vendor price on this page is one of the ledger's (priceSources.ts),
// read on READ_DATE, the same convention as /capi-shield/ and /stack/. Until
// 20 Oct 2026 this page passed apps.json's older 8 Aug date and labelled the
// ledger's own figures "third-party reported, pending verification".
const latestVerified = READ_DATE;
const readLabel = new Date(READ_DATE + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

// The quote tool at the top. Elevar is the only one of the four whose price
// follows inputs a merchant knows (orders and destinations), so it is the only
// one computed; the other three are stated as their pages state them. Figures
// are the ledger's, as read on the vendors' pages.
const ELEVAR_PLANS = [
  { plan: 'Core', price: 225, maxOrders: 2000, maxDest: 2 },
  { plan: 'Advanced', price: 650, maxOrders: 10000, maxDest: 4 },
  { plan: 'Premium', price: 1250, maxOrders: 30000, maxDest: 10 },
];
const ELEVAR_ELITE_FROM = 3000;
const NORTHBEAM_STARTER = 1500;
const ANALYZIFY = { monthly: 145, yearlyPerMonth: 109, plusMonthly: 275, plusYearlyPerMonth: 206 };
const usd = (n: number) => '$' + n.toLocaleString('en-US');
// The constants above must be the ledger's figures, or the build stops.
const LEDGER_CHECK: [keyof typeof SOURCES, number[]][] = [
  ['elevar', [...ELEVAR_PLANS.map((x) => x.price), ELEVAR_ELITE_FROM]],
  ['northbeam', [NORTHBEAM_STARTER]],
  ['analyzify', Object.values(ANALYZIFY)],
];
for (const [id, nums] of LEDGER_CHECK) {
  for (const n of nums) if (!SOURCES[id].read.includes(usd(n))) throw new Error(`attribution page: ${id} ${n} is not in priceSources.ts`);
}
const elevarFor = (orders: number, dest: number) => {
  const p = ELEVAR_PLANS.find((x) => orders <= x.maxOrders && dest <= x.maxDest);
  return p ? { plan: p.plan, price: p.price, from: false } : { plan: 'Elite', price: ELEVAR_ELITE_FROM, from: true };
};
const DEFAULT_ORDERS = 5000;
const DEFAULT_DEST = 4;
const elevarDefault = elevarFor(DEFAULT_ORDERS, DEFAULT_DEST);
const BAR_MAX = Math.max(ELEVAR_ELITE_FROM, NORTHBEAM_STARTER);
const pct = (n: number) => Math.max(3, Math.round((n / BAR_MAX) * 100));

// ── the spine: four vendors, four pricing axes ──────────────────────────────
const axes = [
  {
    brand: "Elevar",
    axis: "Monthly order volume × number of destinations",
    entry: "$225/mo (Core)",
    lever: "Crossing an order tier, or adding one more ad platform",
  },
  {
    brand: "Triple Whale",
    axis: "Store GMV",
    entry: "Free plan; paid tiers quoted",
    lever: "Revenue growth, and unlocking the features the entry tier excludes",
  },
  {
    brand: "Northbeam",
    axis: "Traffic and data volume: pageviews, not revenue",
    entry: "From $1,500/mo (Starter)",
    lever: "Sessions and events ingested, regardless of what they earn",
  },
  {
    brand: "Analyzify",
    axis: "Plan tier, billed monthly or yearly",
    entry: "$145/mo, or $109/mo billed yearly",
    lever: "Moving from Standard to Plus",
  },
];

// Elevar's published plan ladder, read on the vendor's page (see priceSources.ts).
const elevarTiers = [
  { plan: "Core",     billed: "$225/month",        orders: "Up to 2,000 orders/mo",  dest: "2 destinations" },
  { plan: "Advanced", billed: "$650/month",        orders: "Up to 10,000 orders/mo", dest: "4 destinations" },
  { plan: "Premium",  billed: "$1,250/month",      orders: "Up to 30,000 orders/mo", dest: "10 destinations" },
  { plan: "Elite",    billed: "From $3,000/month", orders: "Higher volumes",         dest: "Contact sales" },
];

const tocHeadings = [
  { id: "answer-h",     text: "Shopify Attribution Tools Compared" },
  { id: "axes-h",       text: "Four Tools, Four Different Pricing Axes" },
  { id: "example-h",    text: "One Store, Four Very Different Quotes" },
  { id: "conflicts-h",  text: "Three Open Price Conflicts" },
  { id: "elevar-h",     text: "Elevar: The Tracking Pipeline" },
  { id: "whale-h",      text: "Triple Whale: The Operator Dashboard" },
  { id: "northbeam-h",  text: "Northbeam: The Measurement Layer" },
  { id: "analyzify-h",  text: "Analyzify: GA4, Done For You" },
  { id: "table-h",      text: "The Four Side By Side" },
  { id: "capi-h",       text: "When the Free CAPI Shield Route Is Better" },
  { id: "faq-h",        text: "Common Questions" },
];

const faqs = [
  {
    q: "Which Shopify attribution tool is cheapest?",
    a: "There is no single answer, because the four do not price on the same thing. Elevar prices on order volume multiplied by the number of destinations you send events to. Triple Whale prices on store GMV and package, and quotes its paid tiers after a walkthrough. Northbeam prices on traffic and data volume. Analyzify charges a plan fee, monthly or at a discount yearly. The cheapest tool is whichever axis your store happens to sit low on."
  },
  {
    q: "Why do two similar stores get completely different quotes?",
    a: "Because the axis, not the store size, sets the price. A high-traffic, low-average-order-value store is penalised by Northbeam's traffic-based pricing while barely registering on Triple Whale's GMV tiers. A low-traffic, high-average-order-value store is the reverse. A store sending events to six ad platforms is penalised by Elevar's destination count no matter how few orders it takes."
  },
  {
    q: "Do Northbeam and Triple Whale compete with a free server-side setup?",
    a: "Not directly. Northbeam and Triple Whale are measurement and reporting layers: they exist to tell you what worked. A free server-side event pipeline exists to get events delivered to the ad platforms. Elevar and Analyzify are the two of the four that genuinely overlap with it, because both are fundamentally about event delivery and configuration."
  },
  {
    q: "Is Analyzify's 99% purchase-tracking accuracy claim reliable?",
    a: "The figure measures capture rate, not data quality. It describes the share of purchase events captured, not whether the contents of those events are trustworthy. Bot purchases, synthetic sessions and proxy traffic are captured at the same rate as real ones. The number is accurate about what it measures and misleading about what most merchants assume it means."
  },
  {
    q: "Are the prices on this page verified?",
    a: `Yes, the prices are. Every price for Elevar, Northbeam and Analyzify was read on the vendor's own pricing page on ${readLabel}, and the sources are listed at the foot of the page. Triple Whale publishes no paid price, so none is given. A few non-price figures, such as install counts and the GMV a vendor typically sells to, are third-party reported and are labelled as reported where they appear.`
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#collection`,
      url: canonical,
      name: title,
      description,
      inLanguage: "en-GB",
      dateModified,
      isPartOf: { "@id": `${SITE}/#website` },
      about: { "@id": `${SITE}/#org` },
      author: { "@id": `${SITE}/#luke` },
      publisher: { "@id": `${SITE}/#org` },
      mainEntity: { "@id": `${canonical}#itemlist` },
    },
    {
      "@type": "ItemList",
      "@id": `${canonical}#itemlist`,
      name: "Shopify attribution and tracking tools compared",
      numberOfItems: records.length,
      itemListOrder: "https://schema.org/ItemListUnordered",
      itemListElement: records.map((app, i) => {
        const offers = offerFor(app);
        return {
          "@type": "ListItem",
          position: i + 1,
          item: {
            "@type": "SoftwareApplication",
            "@id": `${SITE}/apps/${app.id}/#app`,
            name: app.name,
            applicationCategory: app.category,
            operatingSystem: "Shopify",
            description: app.description,
            ...(offers ? { offers } : {}),
          },
        };
      }),
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      isPartOf: { "@id": `${canonical}#collection` },
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  updatedDate={dateModified}
  verifiedDate={latestVerified}
  breadcrumb={[{ label: "Home", href: "/" }, { label: "Attribution Tools Compared" }]}
>
<main class="max-w-4xl mx-auto px-4 py-12">

  <h1 id="answer-h" class="text-4xl md:text-5xl font-bold text-white mb-6" style="text-align:left;">
    Shopify Attribution Tools,<br><span class="green">Compared.</span>
  </h1>

  <p id="answer" style="text-align:left;">Elevar, Triple Whale, Northbeam and Analyzify each price on a different axis: order volume times destinations, store GMV, traffic volume, and a plan fee. The same Shopify store therefore receives quotes an order of magnitude apart. Which tool is cheapest depends on which axis your store happens to sit high on.</p>

  <TableOfContents headings={tocHeadings} />

  <!-- Retention, 20 Oct 2026: readers left this page after about three
       seconds. Its first screen was a paragraph, then a warning that most
       prices were unverified, which was no longer true. The question a reader
       brings ("what would I pay?") is now answered by the first thing below
       the answer, from the vendors' own price lists. -->
  <section class="aq" id="quote" aria-labelledby="aq-h" data-elevar={JSON.stringify(ELEVAR_PLANS)} data-elite={ELEVAR_ELITE_FROM} data-max={BAR_MAX}>
    <h2 id="aq-h" class="aq-h">What would your store pay?</h2>
    <div class="aq-in">
      <label class="aq-f"><span>Orders a month</span>
        <input type="number" name="orders" min="0" max="1000000" step="100" value={DEFAULT_ORDERS} inputmode="numeric" />
      </label>
      <label class="aq-f"><span>Ad and analytics destinations</span>
        <input type="number" name="dest" min="1" max="50" step="1" value={DEFAULT_DEST} inputmode="numeric" />
      </label>
    </div>
    <ul class="aq-bars">
      <li>
        <div class="aq-row"><span class="aq-n">Elevar <span class="aq-m">meters orders and destinations</span></span><span class="aq-v" data-elevar-v>{elevarDefault.from ? 'From ' : ''}{usd(elevarDefault.price)}/mo</span></div>
        <div class="aq-track"><span class="aq-bar aq-live" data-elevar-bar style={`width:${pct(elevarDefault.price)}%`}></span></div>
        <p class="aq-why" data-elevar-why>{elevarDefault.plan} plan: the first that covers {DEFAULT_ORDERS.toLocaleString('en-US')} orders and {DEFAULT_DEST} destinations.</p>
      </li>
      <li>
        <div class="aq-row"><span class="aq-n">Analyzify <span class="aq-m">flat plan fee</span></span><span class="aq-v">{usd(ANALYZIFY.monthly)}/mo</span></div>
        <div class="aq-track"><span class="aq-bar" style={`width:${pct(ANALYZIFY.monthly)}%`}></span></div>
        <p class="aq-why">Standard; {usd(ANALYZIFY.yearlyPerMonth)}/mo billed yearly. Plus is {usd(ANALYZIFY.plusMonthly)}/mo ({usd(ANALYZIFY.plusYearlyPerMonth)} yearly). Your volume does not change it.</p>
      </li>
      <li>
        <div class="aq-row"><span class="aq-n">Northbeam <span class="aq-m">meters traffic</span></span><span class="aq-v">From {usd(NORTHBEAM_STARTER)}/mo</span></div>
        <div class="aq-track"><span class="aq-bar aq-q" style={`width:${pct(NORTHBEAM_STARTER)}%`}></span></div>
        <p class="aq-why">Starter, the lowest figure its page names, beside &ldquo;contact us for a quote&rdquo;. Set by pageviews, which neither input above measures.</p>
      </li>
      <li>
        <div class="aq-row"><span class="aq-n">Triple Whale <span class="aq-m">meters GMV</span></span><span class="aq-v">Quote only</span></div>
        <div class="aq-track aq-none"><span class="aq-bar aq-q" style="width:0%"></span></div>
        <p class="aq-why">A free plan; paid tiers are priced on annual GMV after a walkthrough, so there is no figure to draw.</p>
      </li>
    </ul>
    <p class="aq-foot">Prices read on each vendor&rsquo;s own pricing page on {readLabel}, in USD (sources at the foot of the page). Only Elevar&rsquo;s bill follows the two numbers you know; that is the point of this page.</p>
  </section>

  <JumpTo items={[
    { href: '#axes-h', label: 'Pricing axes' },
    { href: '#example-h', label: 'Worked example' },
    { href: '#table-h', label: 'Side by side' },
    { href: '#capi-h', label: 'Free route' },
    { href: '#faq-h', label: 'FAQ' },
  ]} />

  <!-- ── the spine ──────────────────────────────────────────────── -->
  <h2 id="axes-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3rem;">Four Tools, Four Different Pricing Axes</h2>
  <p class="text-gray-300 leading-relaxed mb-4">
    This is the single most important thing to understand before you request a quote from any of them. The four tools
    do not merely charge different amounts. They charge for different <em>things</em>. One meters orders, one meters
    revenue, one meters traffic, and one charges a flat plan fee that your volume never moves.
  </p>

  <div style="overflow-x:auto;margin:1.5rem 0;">
    <table style="width:100%;border-collapse:collapse;font-size:.95rem;">
      <thead>
        <tr style="border-bottom:1px solid var(--border);">
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Tool</th>
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Meters</th>
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Entry point</th>
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">What pushes the bill up</th>
        </tr>
      </thead>
      <tbody>
        {axes.map((a) => (
          <tr style="border-bottom:1px solid var(--border);">
            <td style="padding:10px 12px;color:#fff;font-weight:600;">{a.brand}</td>
            <td style="padding:10px 12px;color:var(--text-3);">{a.axis}</td>
            <td style="padding:10px 12px;color:#fff;font-family:var(--mono);">{a.entry}</td>
            <td style="padding:10px 12px;color:var(--text-3);">{a.lever}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="text-gray-400" style="font-size:.85rem;margin-top:-0.5rem;">
    Entry points read on each vendor's own pricing page (sources at the foot of the page). Northbeam's is the lowest
    figure its page names, beside a quote form; Triple Whale publishes no paid price.
  </p>

  <p class="text-gray-300 leading-relaxed mb-4" style="margin-top:1.5rem;">
    The consequence is the useful part. Two stores with <strong>identical ad spend</strong> can receive quotes an order
    of magnitude apart, purely because of which axis they happen to sit high on. A high-traffic, low-average-order-value
    store (think a fast-moving consumables brand with a lot of browsing and a small basket) is punished hard by
    traffic-based pricing, because it generates enormous event volume for modest revenue. Flip it around: a low-traffic,
    high-average-order-value store, the sort selling a small number of expensive items to a narrow audience, is punished
    by GMV-based pricing, because it books a lot of revenue on very few sessions. And a store that sends its events to
    six or seven ad platforms is punished by destination-count pricing regardless of how many orders it takes, because
    the destination list is a second meter running alongside the first.
  </p>
  <p class="text-gray-300 leading-relaxed mb-4">
    None of this shows up on a feature comparison. It only shows up when the quotes arrive and they are four figures
    apart for no reason anyone can immediately explain.
  </p>

  <!-- ── worked example ─────────────────────────────────────────── -->
  <h2 id="example-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3rem;">One Store, Four Very Different Quotes</h2>
  <p class="text-gray-300 leading-relaxed mb-4">
    Take a single hypothetical store and price it four ways. Assume <strong>5,000 orders a month</strong> and
    <strong>roughly $500,000 in monthly GMV</strong>: an average order value around $100, which is an ordinary shape
    for a mid-sized direct-to-consumer brand. It is one store. Here is what it costs, using the reported figures:
  </p>

  <div style="overflow-x:auto;margin:1.5rem 0;">
    <table style="width:100%;border-collapse:collapse;font-size:.95rem;">
      <thead>
        <tr style="border-bottom:1px solid var(--border);">
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Tool</th>
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Reported cost for this store</th>
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Why it lands there</th>
        </tr>
      </thead>
      <tbody>
        <tr style="border-bottom:1px solid var(--border);">
          <td style="padding:10px 12px;color:#fff;font-weight:600;">Elevar</td>
          <td style="padding:10px 12px;color:#fff;font-family:var(--mono);">$650/mo</td>
          <td style="padding:10px 12px;color:var(--text-3);">5,000 orders lands in the 10,000-order tier, with 4 destinations included</td>
        </tr>
        <tr style="border-bottom:1px solid var(--border);">
          <td style="padding:10px 12px;color:#fff;font-weight:600;">Triple Whale</td>
          <td style="padding:10px 12px;color:#fff;font-family:var(--mono);">Quote only</td>
          <td style="padding:10px 12px;color:var(--text-3);">Paid tiers are priced on annual GMV and package, after a walkthrough</td>
        </tr>
        <tr style="border-bottom:1px solid var(--border);">
          <td style="padding:10px 12px;color:#fff;font-weight:600;">Northbeam</td>
          <td style="padding:10px 12px;color:#fff;font-family:var(--mono);">From $1,500/mo</td>
          <td style="padding:10px 12px;color:var(--text-3);">The Starter figure, the lowest its page names; the quote is set by traffic</td>
        </tr>
        <tr style="border-bottom:1px solid var(--border);">
          <td style="padding:10px 12px;color:#fff;font-weight:600;">Analyzify</td>
          <td style="padding:10px 12px;color:#fff;font-family:var(--mono);">$109–$275/mo</td>
          <td style="padding:10px 12px;color:var(--text-3);">Standard or Plus; the low end is Standard billed yearly, the high end Plus billed monthly</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="text-gray-400" style="font-size:.85rem;margin-top:-0.5rem;">
    Elevar and Analyzify figures are read from the vendors' pricing pages; Northbeam's starter figure is the one its
    page names before "contact us for a quote"; Triple Whale publishes no paid price. They show the <em>shape</em> of
    the difference, not quotes for your store.
  </p>

  <p class="text-gray-300 leading-relaxed mb-4" style="margin-top:1.5rem;">
    The spread across the published figures in that table is almost fourteen to one, $109 against $1,500, for one
    store on one day. That is not a
    quality gradient. It is four companies metering four different quantities and one store that happens to sit
    differently on each meter. Before you compare features, work out which meter you are expensive on: it will tell
    you more about your eventual bill than any capability list will.
  </p>

  <!-- ── conflicts ──────────────────────────────────────────────── -->
  <h2 id="conflicts-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3rem;">Three Price Conflicts, and How Each Was Settled</h2>
  <p class="text-gray-300 leading-relaxed mb-4">
    Earlier versions of this page carried three figures that other sources contradicted, and said so rather than pick
    the number that read best. Each has since been settled the only way that counts: by reading the vendor's own
    pricing page. The record stays here because other comparisons still repeat the losing figures.
  </p>
  <ol class="space-y-3 my-6" style="padding-left:1.25rem;">
    <li class="text-gray-300">
      <strong class="text-white">Elevar's plan structure.</strong> One source described a ladder priced on orders and
      destinations; an older one described $200 at 1,000 orders, $450 at 10,000 and $950 at 50,000, with per-order
      overages. The vendor's page shows the first: Core, Advanced, Premium and Elite, each with an order allowance and a
      destination count. The overage ladder is out of date.
    </li>
    <li class="text-gray-300">
      <strong class="text-white">Northbeam's floor: $1,500 or $1,000.</strong> Its pricing page names $1,500 for
      Starter, beside a quote form. The lower figure is not on it.
    </li>
    <li class="text-gray-300">
      <strong class="text-white">Analyzify's billing basis.</strong> A reported annual fee did not match the monthly
      figure. The page sells both: Standard at $145 a month or $1,305 a year, Plus at $275 a month or $2,475 a year.
      The old annual figure matched neither and is gone.
    </li>
  </ol>

  <!-- ── ELEVAR ─────────────────────────────────────────────────── -->
  <h2 id="elevar-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3.5rem;">Elevar: The Tracking Pipeline</h2>

  <p class="text-gray-300 leading-relaxed mb-4">
    <strong class="text-white">First, a corporate note that matters.</strong> Elevar has been sold through Audiense
    since July 2025, and the Shopify App Store listing now reads "Elevar by Audiense". If you are searching for
    documentation, pricing or support and finding two brand names, that is why. The product name has been retained as a
    sub-brand rather than retired, so both names appear across the vendor's own material. Anyone renewing a contract
    should confirm which entity they are contracting with.
  </p>

  <p class="text-gray-300 leading-relaxed mb-4">
    <strong class="text-white">How the pricing works.</strong> Two meters run at once: how many orders you process, and
    how many destinations you send events to. Destinations means ad platforms and analytics endpoints: Meta, Google,
    TikTok, Pinterest, a warehouse, and so on. Adding a channel can move you up a tier even if your order count has not
    moved an inch. This is unusual, and it is the single most common way people are caught out, because nobody expects
    switching on one more ad platform to change their subscription price.
  </p>

  <div style="overflow-x:auto;margin:1.5rem 0;">
    <table style="width:100%;border-collapse:collapse;font-size:.95rem;">
      <thead>
        <tr style="border-bottom:1px solid var(--border);">
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Plan</th>
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Price</th>
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Order allowance</th>
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Destinations</th>
        </tr>
      </thead>
      <tbody>
        {elevarTiers.map((t) => (
          <tr style="border-bottom:1px solid var(--border);">
            <td style="padding:10px 12px;color:#fff;font-weight:600;">{t.plan}</td>
            <td style="padding:10px 12px;color:#fff;font-family:var(--mono);">{t.billed}</td>
            <td style="padding:10px 12px;color:var(--text-3);">{t.orders}</td>
            <td style="padding:10px 12px;color:var(--text-3);">{t.dest}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="text-gray-400" style="font-size:.85rem;margin-top:-0.5rem;">
    Ladder as published on the vendor's own pricing page, which now sits on audiense.com and is titled for both
    names. The entry price is also in this site's
    <a href="/apps/#app-elevar" style="color:var(--g);text-decoration:underline">app record</a> with its source link.
  </p>

  <h3 class="text-xl font-bold text-white mb-3" style="margin-top:2rem;">What only this tool does</h3>
  <p class="text-gray-300 leading-relaxed mb-4">
    <strong class="text-white">Session Enrichment.</strong> This is the genuine differentiator, and none of the other
    three offer an equivalent. It stitches events, sessions and channel attribution together so that a returning
    anonymous visitor can be recognised across separate visits, and their behaviour connected into a single thread
    rather than three unrelated ones. For a store with a long consideration cycle: where somebody browses on Tuesday,
    reads reviews on Thursday and buys the following week: that stitching is the difference between three orphaned
    sessions and one attributable journey.
  </p>
  <p class="text-gray-300 leading-relaxed mb-4">
    Two supporting capabilities are worth naming. The first is a <strong>managed server-side GTM container</strong>:
    the tagging infrastructure is provisioned and maintained as part of the product rather than left as an exercise for
    you. The second is a <strong>Chrome-extension event builder</strong>, which lets you define custom events by
    clicking elements on your storefront instead of editing theme code: genuinely useful if the person defining events
    is a marketer rather than a developer.
  </p>
  <p class="text-gray-300 leading-relaxed mb-4">
    On positioning: it is a Shopify preferred partner for checkout extensibility, is reported to power tracking for
    over 6,500 direct-to-consumer brands, and was reported to hold a 4.6 rating from 138 App Store reviews. That is a real install
    base, not a startup.
  </p>

  <h3 class="text-xl font-bold text-white mb-3" style="margin-top:2rem;">Where it concretely falls short</h3>
  <ul class="space-y-3 my-6">
    <li class="text-gray-300"><strong class="text-white">There is infrastructure to run.</strong> Because it is built on server-side GTM, there is a Google Cloud tagging server in your stack to provision, monitor and pay for. That is a real operational surface, and it is the only one of these four that adds one.</li>
    <li class="text-gray-300"><strong class="text-white">Advanced configuration needs real GTM knowledge.</strong> The out-of-the-box container covers standard events well. Anything bespoke requires someone who genuinely understands tag manager, or paying for setup services on top of the subscription.</li>
    <li class="text-gray-300"><strong class="text-white">Destination count is a pricing lever.</strong> Worth repeating because it is so unusual: adding an ad platform can raise your bill. Budget for the destinations you will want in twelve months, not the ones you have now.</li>
    <li class="text-gray-300"><strong class="text-white">Communication around breaking changes.</strong> There are reported gaps in advance notice when tracking behaviour changes, which, for a component sitting in the path of your revenue data, is a meaningful risk to plan around.</li>
  </ul>

  <p class="text-gray-300 leading-relaxed mb-4">
    <strong class="text-white">Who it genuinely suits:</strong> stores where the tracking <em>pipeline itself</em> is
    the problem (events arriving late, incompletely or not at all) with in-house or agency GTM capability to exploit
    it, and roughly $5,000 a month or more in ad spend to justify the line item. If your problem is that you cannot
    read your data, this is the wrong tool; it moves data, it does not interpret it.
  </p>

  <!-- ── TRIPLE WHALE ───────────────────────────────────────────── -->
  <h2 id="whale-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3.5rem;">Triple Whale: The Operator Dashboard</h2>

  <p class="text-gray-300 leading-relaxed mb-4">
    <strong class="text-white">How the pricing works.</strong> Tiers are set by store GMV, so the bill tracks revenue.
    Triple Whale's pricing page lists four plans: Free, Foundation, Automate and Enterprise. Only the free plan has a
    published price. When we read the page on 19 October 2026, Foundation and Automate showed a "Book a walkthrough"
    button and no figure, and the page's FAQ says every price is set by a combination of annual GMV and the package
    you choose, billed monthly or yearly with two months free. Until August 2026 the page published self-serve prices;
    it no longer does, so we do not quote one.
  </p>
  <p class="text-gray-300 leading-relaxed mb-4">
    <strong class="text-white">The single most useful warning on this page:</strong> the entry tier excludes creative
    analytics, customer journey reporting and the survey-based features. Those are, for most buyers, the actual reasons
    to buy the product. Ask for the quote on the tier that contains the features you came for, not the entry tier, because
    that is the number you will actually pay.
  </p>

  <h3 class="text-xl font-bold text-white mb-3" style="margin-top:2rem;">What only this tool does</h3>
  <p class="text-gray-300 leading-relaxed mb-4">
    A Shopify-native first-party pixel combined with <strong>post-purchase surveys</strong>. The surveys are the
    distinctive part: at checkout, the customer is asked directly where they heard about you, and that self-reported
    answer is blended with the pixel data. It is the only one of the four that collects a signal the ad platforms
    cannot see at all, because it comes from the customer's mouth rather than from a cookie. For channels that are
    structurally invisible to click-based attribution (podcast reads, influencer mentions, word of mouth) it is often
    the only evidence you will ever get.
  </p>
  <p class="text-gray-300 leading-relaxed mb-4">
    The right mental model: this is an ecommerce operating dashboard with attribution inside it, not a tracking
    pipeline. People open it every morning. That is a different product category from the other three, and it is why
    comparing it feature-for-feature against a data-delivery tool produces nonsense.
  </p>

  <h3 class="text-xl font-bold text-white mb-3" style="margin-top:2rem;">Where it concretely falls short</h3>
  <ul class="space-y-3 my-6">
    <li class="text-gray-300"><strong class="text-white">The entry tier is hollowed out.</strong> As above: creative analytics, journey reporting and surveys all sit above it. This is the most consequential thing to know before buying.</li>
    <li class="text-gray-300"><strong class="text-white">The "Total Impact" model has been criticised for over-counting.</strong> A customer who clicks a Meta ad and then a Google search ad can have both channels credited in certain views. The result is a report where the channel contributions sum to more than the revenue actually earned, which produces confidence that is not warranted by the data.</li>
    <li class="text-gray-300"><strong class="text-white">Blended CAC, not per-channel CAC.</strong> You get a customer acquisition cost for the business, not a defensible one per channel. If your question is "should I move budget from Meta to TikTok", a blended number cannot answer it. This is a real and specific limitation against Northbeam.</li>
  </ul>

  <p class="text-gray-300 leading-relaxed mb-4">
    <strong class="text-white">Who it genuinely suits:</strong> Shopify-first direct-to-consumer operators who want one
    dashboard to open each morning and a number to run the day from. Below roughly $30,000 a month in paid media, the
    honest recommendation is the free plan: the paid tiers are priced for stores whose media decisions are large
    enough that a percentage point of improvement covers the subscription.
  </p>

  <!-- ── NORTHBEAM ──────────────────────────────────────────────── -->
  <h2 id="northbeam-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3.5rem;">Northbeam: The Measurement Layer</h2>

  <p class="text-gray-300 leading-relaxed mb-4">
    <strong class="text-white">How the pricing works.</strong> This is the one that is priced on traffic and data
    volume rather than on revenue, which catches people out in the opposite direction from everything else here. Two
    stores earning identical revenue can be quoted very differently if one of them generates three times the pageviews.
    Contracts are annual. Northbeam's own pricing page names two figures: Starter at $1,500, beside "contact us for a
    quote", and Professional at $3,500 a month; Growth and Enterprise are custom. Third parties report that it rarely
    sells to stores below about $500,000 in monthly GMV; that is reported, not on its page.
  </p>

  <h3 class="text-xl font-bold text-white mb-3" style="margin-top:2rem;">What only this tool does</h3>
  <p class="text-gray-300 leading-relaxed mb-4">
    The <strong>Clicks + Deterministic Views</strong> model. Server-side ingestion feeds a multi-touch attribution
    engine that credits view-through conversions <em>deterministically</em> rather than inferring them, which is the
    substantive distinction, because view-through is where most attribution tooling quietly resorts to modelling and
    hopes nobody asks. Media mix modelling is available on the upper tiers for the channels that have no click at all.
  </p>
  <p class="text-gray-300 leading-relaxed mb-4">
    It also reports <strong>per-channel customer acquisition cost</strong>. That sounds mundane until you try to make a
    budget reallocation decision with a blended figure and find you cannot. Per-channel CAC is precisely what Triple
    Whale does not give you, and it is the clearest functional line between the two.
  </p>

  <h3 class="text-xl font-bold text-white mb-3" style="margin-top:2rem;">Where it concretely falls short</h3>
  <ul class="space-y-3 my-6">
    <li class="text-gray-300"><strong class="text-white">The price floor excludes most Shopify stores outright.</strong> This is not a criticism of the product so much as a statement of who it is for. For the large majority of stores, the conversation ends at the first number.</li>
    <li class="text-gray-300"><strong class="text-white">It is analyst-led.</strong> The models need somebody whose actual job is to use them. Bought by a lean team with no analyst, the depth is dead weight: an expensive dashboard nobody has time to interrogate.</li>
    <li class="text-gray-300"><strong class="text-white">Annual contracts, no monthly escape.</strong> If it turns out to be wrong for you in month three, you are still paying in month eleven.</li>
    <li class="text-gray-300"><strong class="text-white">It does not work as a Shopify-only stack.</strong> The other three are comfortable being the whole of a Shopify store's tracking setup. This one assumes a multi-channel media mix around it, and delivers proportionally less value without one.</li>
  </ul>

  <p class="text-gray-300 leading-relaxed mb-4">
    <strong class="text-white">Who it genuinely suits:</strong> brands north of $10 million in annual revenue running
    multi-channel mixes that include TV, podcast or influencer spend, with an analyst on staff. If you buy media across
    channels that do not produce clicks, this is the category of tool built for that problem.
  </p>

  <!-- ── ANALYZIFY ──────────────────────────────────────────────── -->
  <h2 id="analyzify-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3.5rem;">Analyzify: GA4, Done For You</h2>

  <p class="text-gray-300 leading-relaxed mb-4">
    <strong class="text-white">How the pricing works.</strong> Two plans, each billed monthly or yearly. Analyzify
    Standard is $145 a month, or $109 a month billed yearly ($1,305 a year); Analyzify Plus is $275 a month, or $206 a
    month billed yearly ($2,475 a year). Server-side GTM setup is a separate one-time add-on. Earlier versions of this
    page quoted an annual figure third parties reported; Analyzify's own page does not show it, so it is gone.
  </p>

  <h3 class="text-xl font-bold text-white mb-3" style="margin-top:2rem;">What only this tool does</h3>
  <p class="text-gray-300 leading-relaxed mb-4">
    <strong class="text-white">Done-for-you setup, included at no extra cost.</strong> Managed onboarding, migration
    and professional implementation are bundled into the fee rather than sold as a services add-on. That is the actual
    product. It is a service wrapped in an app, and the fee is best understood as buying an implementation, not a
    subscription. Every other tool here sells you software and leaves the configuration to you or your agency.
  </p>
  <p class="text-gray-300 leading-relaxed mb-4">
    Technically, it adds more than ten events and parameters that GA4 does not capture natively on Shopify: collection
    views, coupon codes, variant IDs, which are exactly the dimensions you find yourself missing the first time you
    try to answer a real merchandising question in GA4.
  </p>

  <h3 class="text-xl font-bold text-white mb-3" style="margin-top:2rem;">Where it concretely falls short</h3>
  <p class="text-gray-300 leading-relaxed mb-4">
    <strong class="text-white">The 99% purchase-tracking accuracy claim measures capture rate, not data quality.</strong>
    This deserves unpacking, because it is the most quietly misleading number in this whole category. The claim is that
    99% of purchase events are captured. That is a statement about <em>delivery</em>. It says nothing whatsoever about
    what those events contain. Bot purchases are captured at 99% accuracy. Synthetic sessions are captured at 99%
    accuracy. Proxy traffic is captured at 99% accuracy. The figure is entirely accurate about what it measures, and
    entirely misleading about what most merchants assume it means, which is "99% of my analytics data is correct". A
    high capture rate on dirty input produces a high-fidelity record of dirty input.
  </p>
  <ul class="space-y-3 my-6">
    <li class="text-gray-300"><strong class="text-white">It is GA4-centric.</strong> The value proposition is a correctly configured GA4. If GA4 is not your reporting layer, if you live in a BI tool or in the ad platforms, most of that value evaporates.</li>
    <li class="text-gray-300"><strong class="text-white">The true cost is often higher than the fee.</strong> It is commonly paired with Stape hosting for the server-side container, which can push genuine annual cost past $3,000. The headline annual figure is the software, not the setup.</li>
    <li class="text-gray-300"><strong class="text-white">The reviewer base skews small-business.</strong> Worth weighing when reading ratings: the population rating it is not the population running complex multi-channel measurement.</li>
  </ul>

  <p class="text-gray-300 leading-relaxed mb-4">
    <strong class="text-white">Who it genuinely suits:</strong> teams with no in-house analytics capability who want
    GA4 configured properly once and then left alone. If the honest description of your situation is "we know our
    tracking is wrong and nobody here can fix it", the bundled implementation is worth more than any feature on the
    list.
  </p>

