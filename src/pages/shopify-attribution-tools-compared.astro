  <p class="text-gray-300" style="margin-top:1rem;font-size:.9rem;">
    <strong class="text-white">How these figures were checked:</strong> prices come from each vendor's own pricing
    page, read on the date above, and only those prices are carried into structured data. Triple Whale's page shows no
    paid price, so this page gives none. Figures that are not prices (install counts, typical customer size) come from
    third parties and are marked <em>reported</em> where they appear. Our sourcing standard is in
    <a href="/how-we-test/" style="color:var(--g);text-decoration:underline">how we test</a>.
  </p>

  <KeyFacts />
  <AuthorCard />
</main>

<script>
  // The quote tool. Elevar's plan is the first whose order allowance and
  // destination count both cover the inputs; past Premium it is Elite, which
  // the vendor prices "from". No network request; the plan list is the one the
  // page rendered from priceSources.ts.
  const root = document.getElementById('quote');
  if (root) {
    const plans: { plan: string; price: number; maxOrders: number; maxDest: number }[] = JSON.parse(root.dataset.elevar || '[]');
    const elite = Number(root.dataset.elite);
    const max = Number(root.dataset.max);
    const orders = root.querySelector<HTMLInputElement>('input[name="orders"]')!;
    const dest = root.querySelector<HTMLInputElement>('input[name="dest"]')!;
    const v = root.querySelector('[data-elevar-v]')!;
    const bar = root.querySelector<HTMLElement>('[data-elevar-bar]')!;
    const why = root.querySelector('[data-elevar-why]')!;
    const usd = (n: number) => '$' + n.toLocaleString('en-US');
    const update = () => {
      const o = Math.max(0, Math.floor(Number(orders.value) || 0));
      const d = Math.max(1, Math.floor(Number(dest.value) || 1));
      const p = plans.find((x) => o <= x.maxOrders && d <= x.maxDest);
      const price = p ? p.price : elite;
      v.textContent = `${p ? '' : 'From '}${usd(price)}/mo`;
      bar.style.width = `${Math.max(3, Math.round((price / max) * 100))}%`;
      why.textContent = p
        ? `${p.plan} plan: the first that covers ${o.toLocaleString('en-US')} orders and ${d} destination${d === 1 ? '' : 's'}.`
        : `Elite: past Premium's ${plans[plans.length - 1].maxOrders.toLocaleString('en-US')} orders or ${plans[plans.length - 1].maxDest} destinations, Elevar prices from ${usd(elite)} on a quote.`;
    };
    orders.addEventListener('input', update);
    dest.addEventListener('input', update);
  }
</script>

