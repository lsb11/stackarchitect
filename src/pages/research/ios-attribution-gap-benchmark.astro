---
import Base from '../../layouts/Base.astro';
import { dataPoints as data } from '../../data/attributionGap.js';

const title = "iOS 14.5+ Attribution Gap Benchmark 2026 | Stack Architect";
const description = "Live benchmark data on the discrepancy between Shopify first-party data and Meta Ads reporting caused by iOS 14.5+ ATT (App Tracking Transparency).";

// 1. Dataset Schema for the data itself
const datasetSchema = {
  "@context": "https://schema.org/",
  "@type": "Dataset",
  "name": "iOS Attribution Gap Benchmark for Shopify & Meta Ads",
  "description": description,
  "creator": {
    "@type": "Organization",
    "name": "Stack Architect",
    "url": "https://stackarchitect.xyz"
  },
  "datePublished": "2026-07-24",
  "dateModified": new Date().toISOString().split('T')[0],
  "keywords": [
    "iOS 14.5",
    "ATT",
    "App Tracking Transparency",
    "Shopify",
    "Meta Ads",
    "Facebook Ads",
    "Attribution Gap",
    "Data Loss"
  ],
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "distribution": [
    {
      "@type": "DataDownload",
      "encodingFormat": "CSV",
      "contentUrl": "https://stackarchitect.xyz/downloads/ios-attribution-gap-benchmark.csv"
    },
    {
      "@type": "DataDownload",
      "encodingFormat": "JSON",
      "contentUrl": "https://stackarchitect.xyz/downloads/ios-attribution-gap-benchmark.json"
    }
  ]
};

// 2. FAQ Schema for organic snippet capture
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the iOS attribution gap?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The iOS attribution gap refers to the discrepancy between actual sales data recorded in e-commerce platforms like Shopify and the reported conversions in ad platforms like Meta Ads. This is primarily caused by Apple's App Tracking Transparency (ATT) framework introduced in iOS 14.5, which requires users to opt-in to tracking."
      }
    },
    {
      "@type": "Question",
      "name": "How much data is lost due to iOS 14.5+?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our live benchmark data indicates that brands typically experience a 30-40% data loss in in-platform ad reporting compared to their first-party store data without server-side tracking implemented."
      }
    },
    {
      "@type": "Question",
      "name": "How can I fix the iOS attribution gap on Shopify?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To recover lost attribution data, Shopify merchants must implement Server-Side Tracking via the Meta Conversions API (CAPI). This bypasses the browser level restrictions and sends first-party conversion data directly from the server to the ad platform."
      }
    }
  ]
};

// Compute dynamic metric for the gauge
const parsePercent = (str: string) => {
  const match = str.match(/(\d+)%/);
  return match ? parseInt(match[1]) : 0;
};
---

<Base
  title={title}
  description={description}
  schema={[datasetSchema, faqSchema]}
>
  <main class="max-w-6xl mx-auto px-6 py-20">
    <header class="text-center mb-16 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-green-500/10 border border-green-500/20 text-green-400 text-sm font-medium mb-6 tracking-wide">
        <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
        Live Data Hub
      </div>
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6 bg-gradient-to-br from-white to-neutral-400 bg-clip-text text-transparent">
        iOS 14.5+ Attribution Gap <br class="hidden md:block"/> Benchmark
      </h1>
      <p class="text-xl text-neutral-400 max-w-3xl mx-auto leading-relaxed">
        The authoritative, real-time index of data discrepancy between Shopify first-party analytics and Meta Ads reporting caused by Apple's App Tracking Transparency.
      </p>
    </header>

    <!-- Executive Summary -->
    <section class="mb-20 max-w-4xl mx-auto prose prose-invert prose-lg text-neutral-300">
      <h2 class="text-white text-3xl font-bold mb-4">Executive Summary</h2>
      <p>
        Since the rollout of Apple's App Tracking Transparency (ATT) framework in iOS 14.5, e-commerce brands have experienced a severe degradation in ad platform reporting. This data hub provides a continuously updated benchmark of the attribution gap&mdash;the percentage of actual revenue generated that ad platforms fail to claim natively. 
      </p>
      <p>
        For media buyers, marketing agencies, and journalists, these figures highlight the absolute necessity of transitioning to first-party, server-side tracking solutions (like the Meta Conversions API) to recover algorithmic efficiency.
      </p>
    </section>

    <!-- The Data Grid with Gauges -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20 relative z-10">
      <!-- Glow Underlay -->
      <div class="absolute inset-0 bg-green-500/5 blur-[120px] rounded-full pointer-events-none -z-10"></div>

      {data.map((point) => {
        const pct = parsePercent(point.value);
        return (
          <div class="group relative overflow-hidden bg-neutral-900/50 backdrop-blur-xl border border-white/10 rounded-3xl p-8 hover:border-green-500/50 transition-all duration-500 hover:shadow-[0_0_40px_rgba(52,211,119,0.15)] hover:-translate-y-1">
            <!-- Animated border gradient -->
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-gradient-to-br from-green-500/20 to-transparent pointer-events-none"></div>
            
            <div class="flex flex-col items-center text-center">
              {pct > 0 ? (
                <div class="relative w-32 h-32 mb-6 flex items-center justify-center">
                  <!-- The Gauge Ring -->
                  <div class="absolute inset-0 rounded-full" style={`background: conic-gradient(#34d377 ${pct}%, #262626 ${pct}% 100%);`}></div>
                  <!-- Inner cutout -->
                  <div class="absolute inset-2 bg-neutral-900 rounded-full flex items-center justify-center shadow-inner">
                    <span class="text-3xl font-black bg-gradient-to-br from-[#34d377] to-[#0ea5e9] bg-clip-text text-transparent">{point.value}</span>
                  </div>
                </div>
              ) : (
                <div class="h-32 mb-6 flex items-center justify-center">
                  <span class="text-5xl font-black bg-gradient-to-br from-[#34d377] to-[#0ea5e9] bg-clip-text text-transparent">{point.value}</span>
                </div>
              )}
              
              <h3 class="text-white font-bold text-lg mb-2">{point.metric}</h3>
              <p class="text-neutral-400 text-sm">{point.detail}</p>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Methodology -->
    <section class="mb-20 max-w-4xl mx-auto prose prose-invert prose-lg text-neutral-300">
      <h2 class="text-white text-3xl font-bold mb-4">Methodology</h2>
      <p>
        Data is aggregated anonymously from a cohort of scaling Shopify Plus merchants utilizing advanced server-side tracking pipelines. The "Attribution Gap" is calculated by subtracting the in-platform reported purchase events (e.g., inside Meta Ads Manager) from the indisputable server-side purchase payload received directly by Shopify webhooks.
      </p>
    </section>

    <!-- Cite This Report (DR Building Engine) -->
    <section class="mb-20 max-w-4xl mx-auto">
      <div class="bg-gradient-to-br from-neutral-900 to-black border border-green-500/30 rounded-3xl p-8 md:p-12 shadow-2xl relative overflow-hidden">
        <!-- Accent decorative blob -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-green-500/10 blur-[80px] rounded-full pointer-events-none"></div>

        <h2 class="text-2xl font-bold text-white mb-4">Cite This Data</h2>
        <p class="text-neutral-400 mb-6">
          We provide this benchmark data under a Creative Commons (CC BY 4.0) license. If you use these statistics in your article, report, or social media post, please copy the HTML snippet below to accurately cite the source and provide an authoritative reference link for your readers.
        </p>

        <div class="relative">
          <textarea readonly class="w-full h-32 bg-black/50 border border-neutral-700 rounded-xl p-4 text-sm text-green-400 font-mono focus:outline-none focus:border-green-500 transition-colors resize-none">&lt;blockquote&gt;
  &lt;p&gt;"According to benchmark data, e-commerce brands experience a 30-40% data loss in Meta Ads reporting due to iOS 14.5+ restrictions."&lt;/p&gt;
  &lt;footer&gt;&mdash; Source: &lt;a href="https://stackarchitect.xyz/research/ios-attribution-gap-benchmark/" target="_blank" rel="noopener"&gt;Stack Architect's 2026 iOS Attribution Gap Benchmark&lt;/a&gt;&lt;/footer&gt;
&lt;/blockquote&gt;</textarea>
          <button onclick="navigator.clipboard.writeText(this.previousElementSibling.value); this.innerText='Copied!'; setTimeout(() => this.innerText='Copy HTML', 2000)" class="absolute top-4 right-4 bg-neutral-800 hover:bg-green-600 text-white text-xs font-bold px-3 py-1.5 rounded transition-colors z-10">
            Copy HTML
          </button>
        </div>
      </div>
    </section>

    <!-- API & Downloads -->
    <div class="flex flex-col items-center border-t border-white/10 pt-12 max-w-4xl mx-auto mb-20">
      <h3 class="text-xl font-bold text-white mb-6">Raw Data Access</h3>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/downloads/ios-attribution-gap-benchmark.csv" download class="inline-flex items-center justify-center px-6 py-3 border border-white/20 rounded-lg text-sm font-semibold text-white hover:bg-white hover:text-black transition-colors">
          Download CSV
        </a>
        <a href="/downloads/ios-attribution-gap-benchmark.json" target="_blank" class="inline-flex items-center justify-center px-6 py-3 border border-white/20 rounded-lg text-sm font-semibold text-white hover:bg-white hover:text-black transition-colors">
          JSON API Endpoint
        </a>
      </div>
    </div>

    <!-- FAQ Section for PAA -->
    <section class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-bold text-white mb-8 text-center">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map((faq) => (
          <details class="group bg-neutral-900 border border-white/10 rounded-2xl overflow-hidden [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-white hover:bg-white/5 transition-colors">
              {faq.name}
              <span class="transition group-open:rotate-180">
                <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
              </span>
            </summary>
            <div class="p-6 pt-0 text-neutral-400 leading-relaxed border-t border-white/5 mt-2">
              {faq.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </section>
  </main>
</Base>
