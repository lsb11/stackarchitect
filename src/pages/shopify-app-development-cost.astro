---
import Base from '../layouts/Base.astro';
import AuthorCard from '../components/AuthorCard.astro';
import TableOfContents from '../components/TableOfContents.astro';
// src/pages/shopify-app-development-cost.astro
// Stack Architect — What custom Shopify app development actually costs

const SITE = "https://stackarchitect.xyz";
const PAGE = `${SITE}/shopify-app-development-cost/`;
const DATE_PUBLISHED = "2026-08-08";
const DATE_MODIFIED = "2026-08-08";
const DATE_VERIFIED = "2026-08-08";

const CALCULATOR = "/shopify-app-cost-calculator/";
const STACK = "/stack/";
const MAKE_GUIDE = "/make-com-shopify/";
const AFF_MAKE = "/go/make";

// ── Structured data ──────────────────────────────────────────
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${PAGE}#webpage`,
      "url": PAGE,
      "name": "What a Custom Shopify App Actually Costs in 2026",
      "description": "Real cost ranges for custom Shopify app development — agency, freelance, and in-house — with sources. The ongoing costs people forget, when custom development is genuinely the right call, and when a free Make.com composition does the same job.",
      "datePublished": DATE_PUBLISHED,
      "dateModified": DATE_MODIFIED,
      "inLanguage": "en-GB",
      "isPartOf": { "@id": `${SITE}/#website` },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE}/` },
          { "@type": "ListItem", "position": 2, "name": "Shopify App Development Cost", "item": PAGE }
        ]
      },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["#hero-headline", "#costs-h", "#faq-h"]
      }
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      "url": SITE,
      "name": "Stack Architect",
      "description": "Free automation tools for Shopify operators — $0 stack replacing paid apps.",
      "publisher": { "@id": `${SITE}/#org` },
    },
    {
      "@type": ["Article", "TechArticle"],
      "@id": `${PAGE}#article`,
      "headline": "What a Custom Shopify App Actually Costs — and When Composing Free Tools Is the Better Answer",
      "description": "Real cost ranges for custom Shopify app development with sources, the ongoing costs people forget, when custom development is genuinely the right call, and concrete examples of Make.com compositions doing the same job for $0.",
      "author": { "@id": `${SITE}/#org` },
      "publisher": { "@id": `${SITE}/#org` },
      "datePublished": DATE_PUBLISHED,
      "dateModified": DATE_MODIFIED,
      "inLanguage": "en-GB",
      "url": PAGE,
      "wordCount": 3200,
      "timeRequired": "PT10M",
      "mainEntityOfPage": { "@id": `${PAGE}#webpage` },
      "about": [
        { "@type": "Thing", "name": "Shopify app development", "sameAs": "https://shopify.dev/docs/apps" },
        { "@type": "Thing", "name": "Make.com automation platform", "sameAs": "https://www.make.com" },
        { "@type": "Thing", "name": "Shopify API versioning", "sameAs": "https://shopify.dev/docs/api/usage/versioning" }
      ],
      "mentions": [
        { "@type": "SoftwareApplication", "name": "Make.com" },
        { "@type": "SoftwareApplication", "name": "Shopify" }
      ],
      "educationalLevel": "beginner",
      "proficiencyLevel": "Beginner"
    },
    {
      "@type": "HowTo",
      "@id": `${PAGE}#howto`,
      "name": "How to decide between custom Shopify app development and a Make.com composition",
      "description": "A five-question decision framework for choosing between building a custom Shopify app and composing existing free automation tools.",
      "step": [
        { "@type": "HowToStep", "position": 1, "name": "Check if an existing tool already does 90% of it",
          "text": "Search for an existing Shopify app, Shopify Flow, or Make.com scenario that covers most of what you need. If one exists, compose it — don't commission a custom build for something already solved." },
        { "@type": "HowToStep", "position": 2, "name": "Identify whether the logic is genuinely proprietary",
          "text": "If the requirement is business logic unique to your operation, or true bidirectional real-time sync with an internal system that has no accessible API, that's a real signal for custom development." },
        { "@type": "HowToStep", "position": 3, "name": "Determine if you're building a product, not a fix",
          "text": "If the app is meant to be sold on the Shopify App Store to other merchants, this is a product decision, not a cost-avoidance one — the calculation below doesn't apply." },
        { "@type": "HowToStep", "position": 4, "name": "Price the full three-year cost, not the initial quote",
          "text": "Add first-year maintenance, API version migration time, and — for public apps — App Store review and any ongoing retainer, to the build quote before comparing it to anything." },
        { "@type": "HowToStep", "position": 5, "name": "Prototype in Make.com first, even if you plan to rebuild",
          "text": "Building the workflow in Make.com first is free and fast, and tells you exactly what a custom version needs to do — turning a vague spec into a precise one before anyone gets paid to build it." }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${PAGE}#faq`,
      "mainEntity": [
        { "@type": "Question", "name": "How much does a custom Shopify app cost in 2026?",
          "acceptedAnswer": { "@type": "Answer", "text": "A simple private app (single internal tool, e.g. a webhook receiver) runs roughly $5,000–$15,000. A substantial private app with multiple features and integrations runs $15,000–$60,000. A public App Store app MVP runs $30,000–$150,000 to build, plus $20,000–$50,000 in first-year operations. Figures vary widely by developer location and experience — see the sourced breakdown above." } },
        { "@type": "Question", "name": "What's the cost difference between a private app and a public app?",
          "acceptedAnswer": { "@type": "Answer", "text": "A private app only needs to work for your own store, so it skips Shopify's App Store review process, public-app security requirements, and multi-tenant architecture — which is most of why private apps cost a fraction of public ones. A public app also carries an ongoing retainer, commonly $5,000–$40,000/month depending on complexity, because it has to keep working for every merchant who installs it, not just you." } },
        { "@type": "Question", "name": "What ongoing costs does a custom Shopify app have beyond the initial build?",
          "acceptedAnswer": { "@type": "Answer", "text": "Four recurring costs people underbudget: maintenance (commonly quoted as 20–30% of build cost per year, or a $2,000–$10,000+/month retainer for an active store), Shopify API version migrations (mandatory testing work roughly every quarter), App Store re-review for public apps when functionality changes, and hosting for the backend server and database the app runs on." } },
        { "@type": "Question", "name": "How often does Shopify's API change, and does that affect a custom app?",
          "acceptedAnswer": { "@type": "Answer", "text": "Shopify ships a new API version every three months. Each stable version is supported for a minimum of 12 months with at least nine months of overlap between versions, so nothing breaks overnight — but a custom app that never gets touched will eventually stop working once its version's support window closes. That's recurring engineering time a workflow-automation platform absorbs on your behalf, since Make.com maintains its own Shopify connector." } },
        { "@type": "Question", "name": "How long does Shopify App Store review take?",
          "acceptedAnswer": { "@type": "Answer", "text": "Shopify's own guidance and community reports put the initial review at roughly 4–10 business days. If the reviewer requests changes — common on a first submission — the app moves to a Paused status until you resubmit, and the full process commonly stretches to 2–4 weeks. This only applies to public apps; private apps for your own store skip review entirely." } },
        { "@type": "Question", "name": "When should I build a custom Shopify app instead of using Make.com?",
          "acceptedAnswer": { "@type": "Answer", "text": "When the logic is genuinely proprietary and unique to your operation, when you need true real-time bidirectional sync with an internal system that has no accessible API, when you're building the app to sell on the App Store as a product, or when your scale exceeds what a workflow-automation platform's rate limits can sustain. Outside those cases, an existing free tool or a Make.com scenario usually gets there faster and cheaper." } },
        { "@type": "Question", "name": "Can Make.com really replace a custom-built Shopify integration?",
          "acceptedAnswer": { "@type": "Answer", "text": "For the common case — receive a Shopify webhook, transform the data, send it somewhere else — yes. That pattern is exactly what CAPI Shield, Stocky Swap, Shopify P&L Automation, and Autocrat Quota Fix do, each replacing what would otherwise be a small custom backend service, at $0 instead of a $5,000–$15,000+ build. It doesn't replace custom development for logic a workflow tool genuinely can't express." } },
        { "@type": "Question", "name": "Is a free Make.com scenario really equivalent to a paid custom app?",
          "acceptedAnswer": { "@type": "Answer", "text": "For webhook-in, transform, API-out workflows, functionally yes — the underlying mechanism (a server receiving an event and calling an API) is identical to what a custom backend would do. What you give up is full control over the code, and you take on a dependency on Make.com's platform instead of your own infrastructure. For most Shopify operators that trade-off favours the free composition; for a small number of genuinely custom requirements, it doesn't." } }
      ]
    }
  ]
});

const tocHeadings = [
  { "id": "costs-h", "text": "What custom Shopify app development actually costs" },
  { "id": "ongoing-h", "text": "The ongoing costs people forget" },
  { "id": "when-custom-h", "text": "When custom development is genuinely the right call" },
  { "id": "when-compose-h", "text": "When a Make.com composition does the same job" },
  { "id": "framework-h", "text": "Decision framework" },
  { "id": "faq-h", "text": "Frequently asked questions" },
  { "id": "related-h", "text": "Related guides" }
];
---
<Base title="Shopify App Development Cost 2026 — Build vs Compose" description="Real cost ranges for custom Shopify app development, the ongoing costs people forget, and when a free Make.com scenario does the same job instead." verifiedDate={DATE_VERIFIED}>
<Fragment slot="head">
<script type="application/ld+json" set:html={schema} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700;800&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700;800&display=swap" />
  <link rel="dns-prefetch" href="https://www.make.com" />

  <style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;}
body{overflow-x:hidden;}
::selection{background:rgba(52,211,119,.2);color:#f2f5f3;}
::-webkit-scrollbar{width:4px;}
::-webkit-scrollbar-track{background:#0c0f0d;}
::-webkit-scrollbar-thumb{background:rgba(52,211,119,.3);border-radius:2px;}
:root{
  --g:#34d377;--g-dim:#15803d;--g-bg:rgba(52,211,119,.08);--g-border:rgba(52,211,119,.2);
  --bg:#0c0f0d;--bg-2:#0f1311;--bg-3:#121614;--bg-4:#171c19;
  --border:#222825;--border-2:#2f3733;
  --text:#f2f5f3;--text-2:#b6c0ba;--text-3:#93a09a;--text-4:#6b7671;--text-inv:#0c0f0d;
  --red:#f08a8a;--red-bg:rgba(240,138,138,.07);--red-border:rgba(240,138,138,.18);
  --sky:#8ccfe8;--sky-bg:rgba(140,207,232,.07);--sky-border:rgba(140,207,232,.18);
  --vio:#c3b8ef;--vio-bg:rgba(195,184,239,.07);--vio-border:rgba(195,184,239,.18);
  --amber:#f5b64d;
  --mono:'JetBrains Mono',monospace;
  --sans:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
}
html,body{font-family:var(--sans);background:var(--bg);color:var(--text-3);line-height:1.75;-webkit-font-smoothing:antialiased;}
.tag{display:inline-flex;align-items:center;gap:6px;font-family:var(--mono);font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:5px 12px;border-radius:3px;background:var(--g-bg);border:1px solid var(--g-border);color:var(--g);}
.tag-dim{background:rgba(255,255,255,.03);border-color:var(--border-2);color:var(--text-4);}
.tag-sky{background:var(--sky-bg);border-color:var(--sky-border);color:var(--sky);}
.tag-vio{background:var(--vio-bg);border-color:var(--vio-border);color:var(--vio);}
.tag-amber{background:rgba(245,182,77,.08);border-color:rgba(245,182,77,.2);color:var(--amber);}
.dot{display:inline-block;width:7px;height:7px;min-width:7px;border-radius:50%;background:var(--g);animation:dotPing 2.2s cubic-bezier(.4,0,.6,1) infinite;}
@keyframes dotPing{0%{box-shadow:0 0 0 0 rgba(52,211,119,.5);}70%{box-shadow:0 0 0 8px rgba(52,211,119,0);}100%{box-shadow:0 0 0 0 rgba(52,211,119,0);}}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;font-family:var(--sans);font-size:16px;font-weight:700;text-decoration:none;letter-spacing:-.01em;padding:16px 32px;border-radius:6px;border:none;cursor:pointer;white-space:nowrap;background:var(--g);color:var(--text-inv);transition:background .2s,transform .15s,box-shadow .2s;min-height:52px;}
.btn:hover{background:#45e28a;transform:translateY(-2px);box-shadow:0 8px 28px rgba(52,211,119,.3);}
.btn.pulse{animation:btnGlow 2.8s ease-in-out infinite;}
@keyframes btnGlow{0%,100%{box-shadow:0 0 16px rgba(52,211,119,.1);}50%{box-shadow:0 0 28px rgba(52,211,119,.28);}}
.btn.pulse:hover{animation:none;}
.btn-sm{font-size:14px;padding:12px 22px;min-height:44px;}
.btn-outline{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--sans);font-size:15px;font-weight:600;text-decoration:none;letter-spacing:-.01em;padding:15px 28px;border-radius:6px;border:1.5px solid var(--border-2);cursor:pointer;white-space:nowrap;background:transparent;color:var(--text-2);transition:border-color .2s,color .2s,background .2s;min-height:52px;}
.btn-outline:hover{border-color:var(--g);color:var(--g);background:var(--g-bg);}
.section{padding:100px 24px;}.section-alt{padding:100px 24px;background:var(--bg-2);border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
.inner{max-width:1000px;margin:0 auto;}.inner-sm{max-width:720px;margin:0 auto;}.inner-md{max-width:860px;margin:0 auto;}
.sec-head{text-align:center;margin-bottom:56px;}
.sec-head h2{font-family:var(--sans);font-weight:700;font-size:clamp(24px,4vw,38px);letter-spacing:-.03em;color:var(--text);line-height:1.1;margin-bottom:10px;}
.sec-head p{font-size:15px;color:var(--text-3);max-width:540px;margin:14px auto 0;line-height:1.75;}
.bg-grid{background-color:var(--bg);background-image:radial-gradient(ellipse 80% 40% at 50% 0%,rgba(52,211,119,.06) 0%,transparent 60%),radial-gradient(circle,var(--border) 1px,transparent 1px);background-size:100% 100%,44px 44px;}
.stat-strip{display:grid;grid-template-columns:repeat(4,1fr);background:var(--border);gap:1px;border:1px solid var(--border);border-radius:8px;overflow:hidden;}
.stat-cell{background:var(--bg);padding:20px 12px;text-align:center;}
.stat-v{font-family:var(--mono);font-size:19px;font-weight:700;color:var(--g);line-height:1;}
.stat-l{font-size:11px;color:var(--text-4);text-transform:uppercase;letter-spacing:.1em;margin-top:6px;font-family:var(--mono);}
.divider{height:1px;background:var(--border);margin:0;}
.hero{padding:96px 24px 80px;text-align:center;position:relative;overflow:hidden;}
.hero-inner{max-width:900px;margin:0 auto;position:relative;}
.hero-proof{display:inline-flex;align-items:center;gap:12px;background:rgba(255,255,255,.04);border:1px solid var(--border-2);border-radius:100px;padding:9px 22px;margin-bottom:36px;flex-wrap:wrap;justify-content:center;}
.hero-proof-txt{font-family:var(--mono);font-size:11px;color:var(--text-4);letter-spacing:.08em;}
.hero h1{font-size:clamp(32px,5.6vw,58px);font-weight:700;color:var(--text);line-height:1.05;letter-spacing:-.04em;margin:0 auto 22px;max-width:840px;}
.hero h1 .green{color:var(--g);}
.hero h1 .dim{color:var(--text-4);}
.hero-sub{font-size:clamp(15px,2vw,18px);color:var(--text-3);max-width:620px;margin:0 auto 30px;line-height:1.7;}
.hero-sub strong{color:var(--text-2);font-weight:600;}
.trust-row{display:flex;flex-wrap:wrap;justify-content:center;gap:22px;margin-bottom:36px;}
.trust-item{display:flex;align-items:center;gap:7px;font-size:13px;color:var(--text-3);}
.hero-ctas{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:14px;margin-bottom:14px;}
.hero-cta-note{font-size:13px;color:var(--text-4);line-height:1.6;}
.hero-cta-note a{color:rgba(52,211,119,.7);text-decoration:underline;}
.expert-byline{display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.025);border:1px solid var(--border);border-radius:8px;padding:12px 18px;max-width:fit-content;margin:0 auto 20px;}
.expert-byline span{font-family:var(--mono);font-size:10px;color:var(--text-4);letter-spacing:.08em;}
.expert-byline strong{color:var(--text-3);}
.comp-wrap{overflow-x:auto;margin:24px 0;}
.comp-table{width:100%;border-collapse:collapse;min-width:640px;font-size:13.5px;}
.comp-table th{font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-4);padding:12px 16px;text-align:left;background:rgba(255,255,255,.025);border-bottom:1px solid var(--border);}
.comp-table td{color:var(--text-3);padding:12px 16px;border-bottom:1px solid var(--border);vertical-align:top;}
.comp-table tr:last-child td{border-bottom:none;}
.comp-table td.bold{color:var(--text);font-weight:700;}
.comp-table td.green{color:var(--g);}
.comp-table tr:hover td{background:rgba(255,255,255,.02);}
.step-cards{display:flex;flex-direction:column;gap:12px;margin:20px 0;}
.step-card{background:var(--bg-3);border:1px solid var(--border);border-radius:10px;padding:20px 20px 20px 24px;display:flex;gap:16px;align-items:flex-start;}
.step-num{width:28px;height:28px;min-width:28px;border-radius:50%;background:rgba(52,211,119,.1);border:1px solid rgba(52,211,119,.25);display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:11px;font-weight:700;color:var(--g);flex-shrink:0;}
.step-title{font-size:15px;font-weight:700;color:var(--text);margin-bottom:4px;line-height:1.3;}
.step-desc{font-size:13px;color:var(--text-3);line-height:1.65;}
.callout{background:var(--bg-3);border:1px solid var(--border-2);border-radius:10px;padding:22px 22px 22px 26px;margin:24px 0;border-left:3px solid var(--g);text-align:left;}
.callout.warn{border-left-color:var(--amber);background:rgba(245,182,77,.04);}
.callout.info{border-left-color:var(--sky);background:rgba(140,207,232,.04);}
.callout.vio{border-left-color:var(--vio);background:rgba(195,184,239,.04);}
.callout-label{font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--g);margin-bottom:6px;}
.callout.warn .callout-label{color:var(--amber);}
.callout.info .callout-label{color:var(--sky);}
.callout.vio .callout-label{color:var(--vio);}
.callout p{font-size:14px;color:var(--text-2);line-height:1.7;margin:0;}
.callout p strong{color:var(--text);}
.callout p a{color:var(--g);text-decoration:underline;}
.stat-callout{background:rgba(52,211,119,.06);border:1.5px solid rgba(52,211,119,.2);border-radius:10px;padding:24px;margin:24px 0;display:flex;align-items:flex-start;gap:20px;text-align:left;}
.sc-val{font-family:var(--mono);font-size:30px;font-weight:700;color:var(--g);line-height:1;flex-shrink:0;}
.sc-body p{font-size:14px;color:var(--text-3);line-height:1.65;margin:0;}
.sc-body p strong{color:var(--text-2);}
@media(max-width:500px){.stat-callout{flex-direction:column;gap:10px;}}
.body-text{max-width:780px;margin:0 auto;}
.body-text p{font-size:15px;color:var(--text-3);line-height:1.8;margin-bottom:18px;text-align:left;}
.body-text p strong{color:var(--text-2);font-weight:600;}
.body-text p a{color:var(--g);text-decoration:underline;}
.body-text h3{font-weight:700;font-size:clamp(17px,2.4vw,20px);color:var(--text-2);letter-spacing:-.02em;line-height:1.2;margin:30px 0 12px;text-align:left;}
.body-text ul{padding-left:0;list-style:none;display:flex;flex-direction:column;gap:8px;margin-bottom:20px;}
.body-text li{display:flex;align-items:flex-start;gap:10px;font-size:15px;color:var(--text-3);line-height:1.65;text-align:left;}
.body-text li::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--g);flex-shrink:0;margin-top:9px;}
.body-text li strong{color:var(--text-2);font-weight:600;}
.crosslink-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:32px;}
.crosslink-card{background:var(--bg-3);border:1.5px solid var(--border);border-radius:12px;padding:26px;text-decoration:none;display:flex;flex-direction:column;transition:border-color .2s,transform .2s;}
.crosslink-card:hover{border-color:var(--g-border);transform:translateY(-4px);}
.crosslink-card.sky:hover{border-color:var(--sky-border);}
.crosslink-card.vio:hover{border-color:var(--vio-border);}
.crosslink-name{font-weight:700;font-size:19px;color:var(--text);letter-spacing:-.02em;margin:10px 0 6px;}
.crosslink-desc{font-size:13px;color:var(--text-3);line-height:1.6;margin-bottom:14px;flex:1;}
.crosslink-save{font-family:var(--mono);font-size:12px;font-weight:700;}
@media(max-width:600px){.crosslink-grid{grid-template-columns:1fr;}}
.faq-list-adc{display:flex;flex-direction:column;gap:8px;margin-top:36px;}
details.faq-item-adc{border-radius:10px;border:1.5px solid var(--border);background:rgba(255,255,255,.02);transition:border-color .2s;}
details.faq-item-adc[open]{border-color:rgba(52,211,119,.25);background:rgba(52,211,119,.025);}
details.faq-item-adc summary{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 22px;cursor:pointer;list-style:none;min-height:58px;font-size:15px;font-weight:600;color:var(--text-3);}
details.faq-item-adc summary::-webkit-details-marker{display:none;}
details.faq-item-adc[open] summary{color:var(--text);}
.faq-ico{width:16px;height:16px;min-width:16px;display:inline-block;flex-shrink:0;position:relative;opacity:.4;}
