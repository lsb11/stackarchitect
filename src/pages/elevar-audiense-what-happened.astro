---
import Base from '../layouts/Base.astro';
import AuthorCard from '../components/AuthorCard.astro';
import TableOfContents from '../components/TableOfContents.astro';
import CrossLinkCallout from '../components/CrossLinkCallout.astro';

const title = "Elevar Is Now Audiense — What Changed and What It Costs";
const description = "Elevar's domain now redirects to Audiense. The current published plans — Core $225/mo to Elite $3,000+/mo — plus overage rates and what we could not verify.";
const canonical = "https://stackarchitect.xyz/elevar-audiense-what-happened/";
const dateModified = "2026-08-08";
const priceVerifiedDate = "2026-08-08";
const priceSourceUrl = "https://www.audiense.com/products/audiense-online/pricing/";

// Published plans, transcribed from the vendor pricing page on 2026-08-08.
const plans = [
  { name: "Core",     price: "$225/month",        orders: "Up to 2,000 orders/mo",  dest: "2 destinations",  overage: "$0.50 per extra order" },
  { name: "Advanced", price: "$650/month",        orders: "Up to 10,000 orders/mo", dest: "4 destinations",  overage: "$0.15 per extra order" },
  { name: "Premium",  price: "$1,250/month",      orders: "Up to 30,000 orders/mo", dest: "10 destinations", overage: "$0.10 per extra order" },
  { name: "Elite",    price: "From $3,000/month", orders: "Up to 75,000 orders/mo", dest: "25 destinations", overage: "$0.04 per extra order" },
];

const tocHeadings = [
  { id: "answer-h",    text: "What Happened to Elevar?" },
  { id: "verified-h",  text: "What Is Verifiable Today" },
  { id: "unknown-h",   text: "What We Cannot Confirm" },
  { id: "pricing-h",   text: "Current Published Pricing" },
  { id: "customers-h", text: "What This Means If You Pay for Elevar" },
  { id: "alts-h",      text: "Alternatives to Elevar" },
  { id: "faq-h",       text: "Common Questions" },
];

const faqs = [
  {
    q: "What happened to Elevar?",
    a: "As of 8 August 2026, the domain getelevar.com issues a 301 permanent redirect to Audiense, and the destination pricing page is titled \"Audiense Online Pricing — Powered by Elevar\". Both brand names appear on that page. Stack Architect has not located a statement from either company explaining the reason for the change, so no motive is asserted here."
  },
  {
    q: "How much does Elevar cost now?",
    a: "The vendor pricing page lists four plans: Core at $225/month for up to 2,000 orders and 2 destinations, Advanced at $650/month for up to 10,000 orders and 4 destinations, Premium at $1,250/month for up to 30,000 orders and 10 destinations, and Elite from $3,000/month for up to 75,000 orders and 25 destinations. Elite requires contacting sales."
  },
  {
    q: "What are the overage charges?",
    a: "Orders beyond a plan's monthly allowance are billed per extra order at a rate that falls as the plan rises: $0.50 on Core, $0.15 on Advanced, $0.10 on Premium and $0.04 on Elite. Any destination beyond the plan's allowance costs $125/month on every tier."
  },
  {
    q: "Is my Elevar subscription affected?",
    a: "Stack Architect cannot verify what happens to existing subscriptions, contracts, data retention or support arrangements, because no vendor communication on those points was found. Check your billing portal and contact the vendor directly rather than relying on third-party summaries, including this one."
  },
  {
    q: "What is the free alternative to Elevar?",
    a: "CAPI Shield routes server-side purchase events from Shopify to Meta Conversions API and Google Enhanced Conversions through Make.com's free tier, at $0/month with no code. It covers Meta and Google server-side only; it does not replicate Google Consent Mode v2, Pinterest CAPI or Snapchat CAPI."
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": canonical + "#article",
      "headline": "Elevar Is Now Audiense — What Changed and What It Costs",
      "description": description,
      "inLanguage": "en-GB",
      "datePublished": "2026-08-08",
      "dateModified": dateModified,
      "author": { "@id": "https://stackarchitect.xyz/#luke" },
      "publisher": { "@id": "https://stackarchitect.xyz/#org" },
      "isPartOf": { "@id": "https://stackarchitect.xyz/#website" },
      "mainEntityOfPage": { "@id": canonical + "#webpage" },
      "citation": {
        "@type": "WebPage",
        "name": "Audiense Online Pricing — Powered by Elevar",
        "url": priceSourceUrl
      }
    },
    {
      "@type": "WebPage",
      "@id": canonical + "#webpage",
      "url": canonical,
      "name": title,
      "description": description,
      "inLanguage": "en-GB",
      "dateModified": dateModified,
      "isPartOf": { "@id": "https://stackarchitect.xyz/#website" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};
---

<Base title={title} description={description}>
<Fragment slot="head">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Fragment>

<main class="max-w-4xl mx-auto px-4 py-12">
  <nav aria-label="Breadcrumb" style="margin-bottom:16px;">
    <ol style="display:flex;align-items:center;gap:8px;list-style:none;padding:0;margin:0;font-family:var(--mono);font-size:11px;color:var(--text-4);">
      <li><a href="https://stackarchitect.xyz/" style="color:var(--text-4);text-decoration:none;">Home</a></li>
      <li aria-hidden="true" style="color:var(--border);">/</li>
      <li style="color:var(--text-3);">Elevar Is Now Audiense</li>
    </ol>
  </nav>

  <h1 id="answer-h" class="text-4xl md:text-5xl font-bold text-white mb-6" style="text-align:left;">
    Elevar Is Now<br><span class="green">Audiense.</span><br><span class="dim">Here Is What Changed.</span>
  </h1>

  <p id="answer" style="text-align:left;">Elevar's domain now redirects to Audiense, and its pricing page is titled "Audiense Online Pricing — Powered by Elevar". Published plans are Core at $225/month, Advanced at $650/month, Premium at $1,250/month, and Elite from $3,000/month. No vendor statement explaining the change has been found, so the reason remains unconfirmed.</p>

  <TableOfContents headings={tocHeadings} />

  <p class="text-xl text-gray-300 leading-relaxed mb-8" style="margin-top:2rem;">
    This page records only what can be checked against the vendor's own pricing page, transcribed on
    <strong>8 August 2026</strong>. Where something is not verifiable, it says so rather than filling the gap.
  </p>

  <!-- ── verifiable ─────────────────────────────────────────────── -->
  <h2 id="verified-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3rem;">What Is Verifiable Today</h2>
  <ul class="space-y-3 my-6">
    <li class="text-gray-300">
      <strong class="text-white">The domain redirects.</strong> Requests to <code>getelevar.com</code> — including
      <code>/pricing</code> and <code>/pricing-and-plans/</code> — return a <code>301 Moved Permanently</code> to
      Audiense. A 301 is the permanent variant, not a temporary one.
    </li>
    <li class="text-gray-300">
      <strong class="text-white">Both names appear on the destination.</strong> The pricing page is headed
      "Audiense Online Pricing — Powered by Elevar", so the Elevar name is retained as a sub-brand rather than removed.
    </li>
    <li class="text-gray-300">
      <strong class="text-white">The plan structure is published in full.</strong> Four named tiers with order
      allowances, destination allowances and per-order overage rates are listed openly, with only the top tier gated
      behind a sales conversation.
    </li>
  </ul>

  <!-- ── not verifiable ─────────────────────────────────────────── -->
  <h2 id="unknown-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3rem;">What We Cannot Confirm</h2>
  <div style="background:#1a1410;border:1px solid #5a3a1a;border-radius:12px;padding:1.25rem 1.5rem;margin:1.5rem 0;">
    <p class="text-gray-300" style="margin:0 0 .75rem 0;"><strong class="text-white">Deliberately left blank:</strong></p>
    <ul class="space-y-2" style="margin:0;">
      <li class="text-gray-300"><strong>Why the change happened.</strong> No announcement, press release or filing from either company has been located. Acquisition, merger and rebrand would all produce the same redirect, and guessing between them would be fabrication.</li>
      <li class="text-gray-300"><strong>What happens to existing contracts.</strong> No published guidance on renewals, price grandfathering or notice periods was found.</li>
      <li class="text-gray-300"><strong>Data retention and export.</strong> No statement on historical tracking data was found.</li>
      <li class="text-gray-300"><strong>Whether legacy plan names still bill.</strong> Older tier names circulating online do not appear on the current page; whether anyone is still billed on them is unknown.</li>
    </ul>
    <p class="text-gray-300" style="margin:.75rem 0 0 0;font-size:.92rem;">
      If you hold a subscription, your billing portal and the vendor's support channel are the authoritative sources
      for all four points — not this page.
    </p>
  </div>

  <!-- ── pricing ────────────────────────────────────────────────── -->
  <h2 id="pricing-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3rem;">Current Published Pricing</h2>
  <div style="overflow-x:auto;margin:1.5rem 0;">
    <table style="width:100%;border-collapse:collapse;font-size:.95rem;">
      <thead>
        <tr style="border-bottom:1px solid var(--border);">
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Plan</th>
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Price</th>
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Order allowance</th>
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Destinations</th>
          <th style="text-align:left;padding:10px 12px;color:var(--text-3);font-weight:600;">Overage</th>
        </tr>
      </thead>
      <tbody>
        {plans.map((p) => (
          <tr style="border-bottom:1px solid var(--border);">
            <td style="padding:10px 12px;color:#fff;font-weight:600;">{p.name}</td>
            <td style="padding:10px 12px;color:#fff;font-family:var(--mono);">{p.price}</td>
            <td style="padding:10px 12px;color:var(--text-3);">{p.orders}</td>
            <td style="padding:10px 12px;color:var(--text-3);">{p.dest}</td>
            <td style="padding:10px 12px;color:var(--text-3);font-family:var(--mono);">{p.overage}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="text-gray-300 leading-relaxed">
    Every tier charges <strong>$125/month</strong> for each destination beyond its allowance. The Elite tier is listed
    as a starting price and requires contacting sales, so its real cost cannot be quoted here. Prices transcribed
    {priceVerifiedDate} from <a href={priceSourceUrl} rel="nofollow noopener" target="_blank" style="color:var(--g);text-decoration:underline">{priceSourceUrl}</a>.
  </p>

  <!-- ── customers ──────────────────────────────────────────────── -->
  <h2 id="customers-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3rem;">What This Means If You Pay for Elevar</h2>
  <p class="text-gray-300 leading-relaxed mb-4">
    The practical consequences that follow from the published page — and only from it — are about
    <strong>shape of cost</strong>, not about the rebrand:
  </p>
  <ul class="space-y-3 my-6">
    <li class="text-gray-300"><strong class="text-white">Cost steps, it does not slope.</strong> Crossing 2,000 orders moves Core to Advanced, roughly tripling the bill. Growth near a tier boundary is where the surprise lands.</li>
    <li class="text-gray-300"><strong class="text-white">Overage punishes the cheapest plan hardest.</strong> At $0.50 per extra order on Core versus $0.04 on Elite, staying on a small plan while running over its allowance is the worst-value position.</li>
    <li class="text-gray-300"><strong class="text-white">Destinations are a second axis.</strong> Each ad platform beyond the allowance is $125/month regardless of tier, so a store on Core sending to four platforms pays for two extra destinations on top of the plan.</li>
  </ul>

  <!-- ── alternatives ───────────────────────────────────────────── -->
  <h2 id="alts-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3rem;">Alternatives to Elevar</h2>
  <p class="text-gray-300 leading-relaxed mb-4">
    Server-side tracking is an API integration. The platform endpoints — Meta Conversions API, Google Enhanced
    Conversions, TikTok Events API — are free to call. A managed tool sells the configuration interface, monitoring and
    onboarding around them, not privileged access.
  </p>
  <ul class="space-y-2 my-6">
    <li class="text-gray-300">→ <a href="/capi-shield/" style="color:var(--g);text-decoration:underline">CAPI Shield</a> — free Meta + Google server-side tracking via Make.com, no code.</li>
    <li class="text-gray-300">→ <a href="/tiktok-events-api-shopify/" style="color:var(--g);text-decoration:underline">TikTok Events API</a> — free TikTok server-side events.</li>
    <li class="text-gray-300">→ <a href="/elevar-alternative/" style="color:var(--g);text-decoration:underline">Full Elevar alternative and migration guide</a> — feature-by-feature comparison and what the free stack does not cover.</li>
    <li class="text-gray-300">→ <a href="/apps/elevar/" style="color:var(--g);text-decoration:underline">Elevar pricing record</a> — the tracked price for this vendor.</li>
  </ul>

  <CrossLinkCallout type="alternative" appSlug="elevar" appName="Elevar" />

  <!-- ── faq ────────────────────────────────────────────────────── -->
  <h2 id="faq-h" class="text-2xl font-bold text-white mb-4" style="margin-top:3rem;">Common Questions</h2>
  {faqs.map((f) => (
    <details class="sa-faq" style="border-bottom:1px solid var(--border);padding:12px 0;">
      <summary style="cursor:pointer;color:#fff;font-weight:600;">{f.q}</summary>
      <div class="faq-body"><p class="text-gray-300 leading-relaxed" style="margin-top:.5rem;">{f.a}</p></div>
    </details>
  ))}

  <p class="text-gray-300" style="margin-top:2.5rem;font-size:.9rem;border-top:1px solid var(--border);padding-top:1rem;">
    <strong class="text-white">Verification:</strong> pricing on this page was read directly from the vendor's own
    pricing page on {priceVerifiedDate} and is not sourced from comparison sites or review aggregators. Source:
    <a href={priceSourceUrl} rel="nofollow noopener" target="_blank" style="color:var(--g);text-decoration:underline">{priceSourceUrl}</a>.
    Vendors change prices without notice — re-check before making a purchasing decision.
  </p>

  <AuthorCard />
</main>
</Base>
