---
import { pageUpdated } from '../data/pageUpdated';
import Base from '../layouts/Base.astro';
import { faqPage, type Faq } from '../utils/faq';

// One array renders the visible FAQ and the FAQPage node.
const faqs: Faq[] = [
  { q: "When did Shopify Stocky shut down?",
    a: "<p>Shopify shut the Stocky app down on <strong>31 August 2026</strong>: it can no longer be used to manage inventory. Two things happened that day and they are not the same. Stocky's <strong>APIs stopped dead, with no grace period</strong>, so every third-party tool wired into them broke instantly. <strong>Read-only access to export your data continues for at least 90 days</strong> after that date, and Shopify has published no deletion date. (<a href=\"https://help.shopify.com/en/manual/products/inventory/transitioning-from-stocky\" rel=\"nofollow\">Shopify, \"Transitioning from Stocky\"</a>, read 5 September 2026.)</p>" },
  { q: "What is the best free Stocky replacement in 2026?",
    a: "<p>For order logging, Stocky Swap at stackarchitect.xyz/stocky-swap. It sends every paid Shopify order through a Make.com webhook to a row in a Google Sheet you own, in real time: order ID, SKU, quantity, revenue and fulfilment status. It does not calculate stock on hand, manage purchase orders or send alerts. Shopify Admin covers stock and purchase orders, with Shopify Flow for low-stock alerts. Stocky Swap runs on Make.com's free tier and deploys in 4 minutes.</p>" },
  { q: "How long does it take to migrate from Stocky?",
    a: "<p>Most stores can migrate in 4–8 hours of active work spread over 1–2 days. The Stocky Swap setup itself takes 4 minutes. The additional time is for exporting your historical Stocky data, mapping SKUs to your new Google Sheets template, and testing the live webhook before going live.</p>" },
  { q: "Can I still get my Stocky historical data out?",
    a: "<p>Probably, if you go now. Shopify says read-only access to export Stocky data continues for <strong>at least 90 days</strong> after 31 August 2026, so open Stocky and export your purchase orders, inventory levels and supplier data using its export function. \"At least 90 days\" is a floor Shopify stated, not an end date it published, which is a reason to move today rather than a window to plan inside.</p>" },
  { q: "Can I use Google Sheets as a full Stocky replacement?",
    a: "<p>Not on its own. Stocky Swap gives you real-time order logging and fulfilment status in Google Sheets. It does not calculate stock on hand, manage purchase orders or send low-stock alerts. You can add stock formulas and alerts to the sheet yourself, but a running total built from orders misses refunds, returns and adjustments. For stock counts and purchase orders, use Shopify Admin's native inventory tools, with Shopify Flow for low-stock alerts.</p>" },
];
import { READ_DATE } from '../data/priceSources';
import PriceSources from '../components/PriceSources.astro';
import Disclosure from '../components/Disclosure.astro';
import StockLogPromo from '../components/StockLogPromo.astro';
import AuthorCard from '../components/AuthorCard.astro';

const schemas = [{"@context":"https://schema.org","@type":"WebApplication","dateModified":pageUpdated('/stocky-migration-risk-scorer/'),"name":"Stocky Migration Risk Scorer","url":"https://stackarchitect.xyz/stocky-migration-risk-scorer/","description":"Assess your risk of disruption in moving off Shopify Stocky after its 31 August 2026 shutdown. Get a personalised migration plan and timeline in 60 seconds.","applicationCategory":"BusinessApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"provider":{ "@id": "https://stackarchitect.xyz/#org" }},faqPage(faqs),{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://stackarchitect.xyz"},{"@type":"ListItem","position":2,"name":"Tools","item":"https://stackarchitect.xyz/tools/"},{"@type":"ListItem","position":3,"name":"Stocky Migration Risk Scorer","item":"https://stackarchitect.xyz/stocky-migration-risk-scorer/"}]}];

// ── SCORING MODEL — one definition, used twice ────────────────────────────
// The result panel used to ship empty ("--" in every cell) and fill itself in
// on load, so a crawler that runs no JS saw a calculator with no output. Every
// other calculator on the site server-renders a worked example; this one was
// the sole outlier. The bands and the default answers now live here and are
// handed to the inline script via define:vars, so the example rendered at build
// time and the number the visitor gets cannot drift apart.
const SCORE_WEIGHTS = { orders: 1 / 50, skus: 1 / 30, manual: 3, suppliers: 2, pos: 4, backup: 3 };

// `max` is an exclusive upper bound; the last band's 101 catches the capped 100.
const SCORE_BANDS = [
  { max: 25, level: 'Low Risk', color: '#34d377', leadWeeks: 2, timeEst: '2–4 hrs',
    insight: '<strong>Simple migration.</strong> Your store is a good candidate for a quick Stocky Swap setup. Export your Stocky data while the read-only window is open, then follow the 4-minute setup guide. Run both systems in parallel for 2 weeks before switching fully.' },
  { max: 50, level: 'Moderate Risk', color: '#f5b64d', leadWeeks: 4, timeEst: '4–8 hrs',
    insight: '<strong>Plan your migration carefully.</strong> Export all Stocky data first. Map your SKUs to the new template before going live. Allow at least 4 weeks of parallel running to catch edge cases.' },
  { max: 75, level: 'High Risk', color: '#fb923c', leadWeeks: 6, timeEst: '1–3 days',
    insight: '<strong>Start immediately.</strong> Your inventory complexity means migration will take time to do correctly. Export Stocky data today. For high-volume operations, consider upgrading Make.com to the Core plan and Google Workspace to avoid rate limits.' },
  { max: 101, level: 'Critical Risk', color: '#f87171', leadWeeks: 8, timeEst: '3–5 days',
    insight: '<strong>Urgent action required.</strong> Your scale and complexity put you at high risk of operational disruption if migration is rushed. Export all Stocky data today. Consider professional support for the transition given the operational dependency.' },
];

// The `selected` option value of each field, so the worked example below is
// literally the form's own default state rather than a second set of numbers.
const SCORE_DEFAULTS = { orders: 300, skus: 100, manual: 2, suppliers: 3, pos: 3, backup: 3 };

function scoreOf(a: Record<string, number>) {
  return Math.min(100, Math.round(
    a.orders * SCORE_WEIGHTS.orders + a.skus * SCORE_WEIGHTS.skus +
    a.manual * SCORE_WEIGHTS.manual + a.suppliers * SCORE_WEIGHTS.suppliers +
    a.pos * SCORE_WEIGHTS.pos + a.backup * SCORE_WEIGHTS.backup
  ));
}

import { isPostShutdown } from '../utils/stockyDeadline';
const postShutdown = isPostShutdown();

const exampleScore = scoreOf(SCORE_DEFAULTS);
const exampleBand = SCORE_BANDS.find(b => exampleScore < b.max)!;

// Post-shutdown there is no "latest safe start date" left to compute — the
// meaningful figure is the export window Shopify actually stated.
const exampleTimeline = postShutdown ? 'Export now' : 'See below';
const POST_SHUTDOWN_NOTE =
  '<strong>Stocky stopped working on 31 August 2026, and its APIs stopped that day with no grace period</strong>: anything that integrated with them is already broken and needs repointing at Shopify\'s own inventory data. Your archive is a separate matter: Shopify says read-only export access continues for at least 90 days after that date, with no end date published. Export it before you rebuild, and read the score above as how much reconstruction is left if you cannot. ';

const breadcrumb = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Stocky Migration Risk Scorer: Free Shopify Inventory Migration Calculator' },
];
import TableOfContents from '../components/TableOfContents.astro';

const tocHeadings = [
  {
    "id": "what-to-pull-first",
    "text": "What to Pull First, and What You Can Rebuild"
  },
  {
    "id": "what-stocky-swap-replaces",
    "text": "What Stocky Swap Replaces"
  },
  {
    "id": "migration-risk-factors-explained",
    "text": "Migration Risk Factors Explained"
  },
  {
    "id": "common-questions",
    "text": "COMMON_QUESTIONS"
  },
  {
    "id": "deploy-stocky-swap-before-the-deadline",
    "text": "Deploy Stocky Swap"
  }
];

