<script is:inline define:vars={{ SCORE_WEIGHTS, SCORE_BANDS, postShutdown, POST_SHUTDOWN_NOTE }}>
  // Reading progress bar
  const bar = document.getElementById('reading-progress');
  if (bar) {
    window.addEventListener('scroll', () => {
      const pct = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
      bar.style.width = Math.min(pct, 100) + '%';
    }, { passive: true });
  }


  function calcStocky() {
    const a = {
      orders: parseInt(document.getElementById('sr-orders').value),
      skus: parseInt(document.getElementById('sr-skus').value),
      manual: parseInt(document.getElementById('sr-manual').value),
      suppliers: parseInt(document.getElementById('sr-suppliers').value),
      pos: parseInt(document.getElementById('sr-pos').value),
      backup: parseInt(document.getElementById('sr-backup').value)
    };

    // Weights and bands come from the frontmatter via define:vars, so this and
    // the worked example rendered at build time cannot disagree.
    const score = Math.min(100, Math.round(
      a.orders * SCORE_WEIGHTS.orders + a.skus * SCORE_WEIGHTS.skus +
      a.manual * SCORE_WEIGHTS.manual + a.suppliers * SCORE_WEIGHTS.suppliers +
      a.pos * SCORE_WEIGHTS.pos + a.backup * SCORE_WEIGHTS.backup
    ));
    const band = SCORE_BANDS.find(function (b) { return score < b.max; }) ||
                 SCORE_BANDS[SCORE_BANDS.length - 1];

    // The latest safe start date is derived from the shutdown date minus the
    // parallel-run window the band implies — never a typed month, which is what
    // left this cell reading "Before June 2026" long after June.
    const SHUTDOWN = new Date('2026-08-31T23:59:59Z');
    const now = new Date();
    const latestStart = new Date(SHUTDOWN.getTime() - band.leadWeeks * 7 * 86400000);
    let timeline, insight = band.insight;
    if (now > SHUTDOWN) {
      timeline = 'Export now';
      insight = POST_SHUTDOWN_NOTE + insight;
    } else if (now > latestStart) {
      timeline = 'Overdue';
    } else {
      timeline = latestStart.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    }

    document.getElementById('sr-score').textContent = score + '/100';
    document.getElementById('sr-score').style.color = band.color;
    document.getElementById('sr-level').textContent = band.level;
    document.getElementById('sr-timeline').textContent = timeline;
    document.getElementById('sr-time').textContent = band.timeEst;
    document.getElementById('sr-insight').innerHTML = insight;
    document.getElementById('sr-result').classList.add('show');
  }
  

  // Run once on load so the panel shows a real result rather than placeholders,
  // and recalculate as the visitor types rather than making them find the button.
  (function () {
    var ids = ["sr-orders","sr-skus","sr-manual","sr-suppliers","sr-pos","sr-backup"];
    var st = document.getElementById('sr-state');
    ids.forEach(function (id) {
      var el = document.getElementById(id);
      if (!el) return;
      el.addEventListener('change', function () {
        calcStocky();
        if (st) { st.textContent = 'Your answers'; st.classList.add('live'); }
      });
    });
    // No calcStocky() on load: the panel already holds the worked example,
    // rendered at build time from the same weights and bands. Recalculating it
    // here would only overwrite identical values.
  })();
</script>
