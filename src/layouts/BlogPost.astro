---
import StockyTimeline from '../components/StockyTimeline.astro';
import ToolShot from '../components/ToolShot.astro';
// A screenshot of the free tool each post sends readers to (src/data/toolShots.ts).
const POST_SHOT: Record<string, string> = {
  'shopify-meta-roas-dropped-2026-fix': 'attribution-gap-example',
  'how-to-fix-shopify-conversion-tracking-after-ios-updates': 'attribution-gap-example',
  'meta-one-click-conversions-api-shopify': 'capi-validator-example',
  'shopify-stocky-data-export-before-shutdown': 'stocky-risk-example',
  'when-to-upgrade-free-make-google-workspace': 'make-vs-zapier-example',
};
import KeyFacts from '../components/KeyFacts.astro';
import Base from './Base.astro';
import FAQSection from '../components/FAQSection.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import AuthorCard from '../components/AuthorCard.astro';
import Disclosure from '../components/Disclosure.astro';
import { pageUpdated } from '../data/pageUpdated';
import { CLOAKS } from '../../functions/go/_cloaks.js';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
  headings?: { depth: number; slug: string; text: string }[];
}

const { entry, headings = [] } = Astro.props;
// Contents, rendered at build time from the post's own H2s (20 Oct 2026).
// It used to be built by a script after load: crawlers that do not run it
// saw no section links, and the list arrived after the first paint, pushing
// the article down. Same three-heading threshold as before.
const toc = headings.filter((h) => h.depth === 2);
// A post whose sections are a numbered procedure ("Step 2: ...", "Stage 4:
// ...") gets them drawn as a path, the one visual its own structure supplies.
// The label is the heading's own words after the number; nothing is added.
const STEP_RE = /^(Step|Stage)\s+(\d+)[:.]\s*(.+)$/;
const steps = toc.map((h) => ({ h, m: STEP_RE.exec(h.text) })).filter((x) => x.m);
const stepWord = steps[0]?.m?.[1] ?? 'Step';
const isPath = steps.length >= 3;
// Past five steps a row of columns gets too narrow to read; stack them.
const pathClass = steps.length > 5 ? 'sa-path sa-path-v' : 'sa-path';
const shortLabel = (t: string) => t.replace(/\s*\([^)]*\)\s*$/, '') || t;
const others = isPath ? toc.filter((h) => !STEP_RE.test(h.text)) : toc;
const {
  title,
  heading,
  description,
  answer,
  canonical,
  publishDate,
  updatedDate,
  verifiedDate,
  category,
  readTime,
  badge,
  faqs,
  relatedGuides,
  affiliate,
  affiliateLabel,
} = entry.data;
// Frontmatter `affiliate: <cloak-slug>` renders the page's one affiliate
// button after the article body, with its own disclosure line directly above.
const cloak = affiliate ? CLOAKS[affiliate as keyof typeof CLOAKS] : undefined;
if (affiliate && !cloak) {
  throw new Error(`${entry.id}: frontmatter affiliate "${affiliate}" is not a cloak in functions/go/_cloaks.js`);
}
// Posts that carry a /go/* affiliate cloak get an on-page disclosure above the body,
// so it always precedes the first affiliate link rather than sitting in the footer.
const hasAffiliateLink = entry.body?.includes('/go/') ?? false;

const rawCanonical = canonical ?? `https://stackarchitect.xyz/blog/${entry.id}/`;
// The visible "Updated" date and Article dateModified both come from
// src/data/page-updated.json. The frontmatter updatedDate is only a fallback.
const pageDate = pageUpdated(`/blog/${entry.id}/`) ?? updatedDate;
const canonicalUrl = rawCanonical.endsWith('/') ? rawCanonical : rawCanonical + '/';

// BreadcrumbList JSON-LD
const categoryLabels: Record<string, string> = {
  tracking: 'Ad Tracking',
  inventory: 'Inventory',
  email: 'Email Marketing',
  automation: 'Automation',
  workflow: 'Workflow',
  ai: 'AI Tools',
  support: 'Customer Support',
  product: 'Products',
};

// The last breadcrumb shows the page title as visible text, where an em dash
// is not used; <title> itself keeps it.
const crumbTitle = title.replace(/\s+—\s+/g, ': ');

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://stackarchitect.xyz/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: categoryLabels[category] ?? category,
      item: 'https://stackarchitect.xyz/shopify-automation-guides/',
    },
    { '@type': 'ListItem', position: 3, name: crumbTitle, item: canonicalUrl },
  ],
};

// FAQPage JSON-LD — only if FAQs present
const faqSchema =
  faqs && faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map(({ question, answer }) => ({
          '@type': 'Question',
          name: question,
          acceptedAnswer: { '@type': 'Answer', text: answer },
        })),
      }
    : null;

const schemas = [
  breadcrumbSchema,
  ...(faqSchema ? [faqSchema] : []),
];

// Visible breadcrumb trail
const breadcrumb = [
  { label: 'Home', href: '/' },
  {
    label: categoryLabels[category] ?? category,
    href: '/shopify-automation-guides/',
  },
  { label: crumbTitle },
];

const displayDate = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });

// Runbook §3.2: titles ≤60 chars. The " | Stack Architect" suffix costs 18
// characters, and brand recognition at DR 0 is worth nothing next to a
// truncated headline — so it is dropped whenever it would push past 60.
const SUFFIX = ' | Stack Architect';
const pageTitle = (title + SUFFIX).length <= 60 ? title + SUFFIX : title;
---

<Base
  ogImage={entry.data.ogImage}
  title={pageTitle}
  description={description}
  canonical={canonicalUrl}
  schema={schemas}
  pageType="article"
  publishDate={publishDate}
  updatedDate={pageDate}
  verifiedDate={verifiedDate}
  breadcrumb={breadcrumb}
>

  <!-- Reading progress bar element -->
  <div id="reading-progress"></div>

  <main class="flex-1 max-w-3xl mx-auto px-4 py-10 w-full">
    <!-- Post metadata bar -->
    <div class="flex flex-wrap items-center gap-3 text-xs text-[#93a09a] font-mono mb-6 border-b border-[#222825] pb-4">
      <span>Published: {displayDate(publishDate)}</span>
      {pageDate && (
        <span>·</span><span data-page-updated>Updated <time datetime={pageDate}>{displayDate(pageDate)}</time></span>
      )}
      <span>· {readTime} min read</span>
      <span>· {categoryLabels[category] ?? category}</span>
    </div>

    <!--
      The H1 is rendered here from frontmatter, not from the markdown body.
      #answer must follow the H1 in the DOM: it is the quotable unit
      (Runbook §3.1) and reads as a summary of the title above it, not as
      a preamble to an unseen heading. seo-audit.mjs enforces this order.
    -->
    <header class="sa-post-head">
      <h1 class="sa-post-title">{heading ?? title}</h1>
      {answer && <p id="answer" class="sa-answer">{answer}</p>}
    </header>

    {entry.id === 'shopify-stocky-data-export-before-shutdown' && <StockyTimeline />}

    {POST_SHOT[entry.id] && <ToolShot id={POST_SHOT[entry.id]} compact />}

    {isPath && (
      <nav class={pathClass} aria-label={`${stepWord}s in this guide`}>
        <div class="sa-path-l">{steps.length} {stepWord.toLowerCase()}s in this guide</div>
        <ol>
          {steps.map(({ h, m }) => (
            <li><a href={`#${h.slug}`}><span class="sa-path-n" aria-hidden="true">{m![2]}</span><span class="sa-path-t"><span class="sa-sr">{stepWord} {m![2]}: </span>{shortLabel(m![3])}</span></a></li>
          ))}
        </ol>
        {others.length > 0 && (
          <p class="sa-path-more">Also here: {others.map((h, i) => <><a href={`#${h.slug}`}>{h.text}</a>{i < others.length - 1 ? ' · ' : ''}</>)}</p>
        )}
      </nav>
    )}

    {!isPath && toc.length >= 3 && (
      <nav class="sa-toc border border-[#222825] bg-[#0c0f0d] p-4 mb-8 font-mono" aria-label="Table of contents">
        <div class="text-xs text-[#93a09a] uppercase tracking-widest mb-3">In this guide</div>
        <ul class="space-y-1">
          {toc.map((h) => (
            <li><a href={`#${h.slug}`} class="sa-toc-a text-sm text-[#b6c0ba] hover:text-[#34d377] transition-colors flex items-baseline gap-2 py-0.5"><span class="text-[#4b5a52]" aria-hidden="true">→</span> {h.text}</a></li>
          ))}
        </ul>
      </nav>
    )}

    {hasAffiliateLink && <Disclosure />}

    <!-- MDX content -->
    <article id="post-body" class="sa-prose">
      <slot />
    </article>

    {cloak && (
      <div class="sa-post-aff">
        <Disclosure text={`I earn a commission if you sign up to ${cloak.vendor} through this link.`} />
        <a href={`/go/${affiliate}/?source=${entry.id}-cta`} target="_blank" rel="sponsored nofollow noopener" class="cta-primary">{affiliateLabel ?? `Visit ${cloak.vendor}`}</a>
      </div>
    )}

    <!-- Author block -->
    <KeyFacts title={heading ?? title} />
    <AuthorCard />

    {faqs && faqs.length > 0 && <FAQSection faqs={faqs} />}
    {relatedGuides && relatedGuides.length > 0 && <RelatedGuides guides={relatedGuides} />}
  </main>

</Base>

<style>
  /* The title block shares the column the meta bar, contents and key facts
     use. At --measure it was 50px narrower and indented, because 68ch at the
     header's font size is not 68ch at the prose's. */
  .sa-post-head {
    max-width: none;
    margin: 0;
  }
  /* Breadcrumb on posts sits on the same column as the text below it, not at
     the window's left edge. */
  :global(.breadcrumb) {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0.75rem 1rem 0;
    flex-wrap: wrap;
    width: 100%;
    justify-content: flex-start;
    box-sizing: border-box;
  }

  .sa-post-title {
    font-family: var(--font-display);
    font-size: clamp(30px, 5vw, 46px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-heading);
    margin: 0 0 20px;
    text-wrap: balance;
  }

  /* Inherits --text-body / --leading-body; the tint and rule carry the
     emphasis instead of a second font size. */
  .sa-post-aff {
    max-width: var(--measure);
    margin: 32px auto 8px;
  }

  /* Step path: numbered nodes on a line, vertical on a phone. */
  .sa-path { margin: 0 0 30px; padding: 18px 18px 14px; border: 1px solid #222825; border-radius: 12px; background: #0c0f0d; }
  .sa-path-l { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: #93a09a; margin-bottom: 14px; }
  .sa-path ol { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 8px; position: relative; }
  .sa-path ol::before { content: ''; position: absolute; left: 18px; right: 18px; top: 17px; height: 2px; background: linear-gradient(90deg, #34d377, #1f5c3c); }
  .sa-path li { margin: 0; padding: 0; position: relative; }
  .sa-path li::before { content: none !important; }
  .sa-path a { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; text-decoration: none !important; color: #e6ece8 !important; }
  .sa-path-n { flex: none; display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: #0c0f0d; border: 2px solid #34d377; color: #34d377; font-weight: 700; font-size: 15px; position: relative; transition: background .15s, color .15s; }
  .sa-path a:hover .sa-path-n, .sa-path a:focus-visible .sa-path-n { background: #34d377; color: #04130a; }
  .sa-path-t { font-size: 14px; line-height: 1.35; color: #e6ece8; }
  .sa-path a:hover .sa-path-t { color: #34d377; }
  .sa-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .sa-path-more { margin: 14px 0 0; font-size: 13px; line-height: 1.7; color: #93a09a; }
  .sa-path-more a { color: #b6c0ba !important; text-decoration: underline !important; }
  .sa-path-v ol { grid-auto-flow: row; gap: 10px; }
  .sa-path-v ol::before { left: 17px; right: auto; top: 18px; bottom: 18px; width: 2px; height: auto; background: linear-gradient(180deg, #34d377, #1f5c3c); }
  .sa-path-v a { flex-direction: row; align-items: center; gap: 12px; }
  .sa-path-v .sa-path-t { font-size: 15px; }
  @media (max-width: 760px) {
    .sa-path ol { grid-auto-flow: row; gap: 10px; }
    .sa-path ol::before { left: 17px; right: auto; top: 18px; bottom: 18px; width: 2px; height: auto; background: linear-gradient(180deg, #34d377, #1f5c3c); }
    .sa-path a { flex-direction: row; align-items: center; gap: 12px; }
    .sa-path-t { font-size: 15px; }
  }
  @media (prefers-reduced-motion: reduce) { .sa-path-n { transition: none; } }

  .sa-answer {
    margin: 0 0 28px;
    padding: 18px 20px;
    border-left: 3px solid var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 5%, transparent);
    border-radius: 0 8px 8px 0;
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--color-body);
  }
</style>

<!-- Reading progress bar script -->
<script>
  const bar = document.getElementById('reading-progress');
  if (bar) {
    window.addEventListener('scroll', () => {
      const body = document.body;
      const docEl = document.documentElement;
      const scrollTop = docEl.scrollTop || body.scrollTop;
      const scrollHeight = docEl.scrollHeight - docEl.clientHeight;
      const pct = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
      bar.style.width = `${Math.min(pct, 100)}%`;
    }, { passive: true });
  }
</script>
