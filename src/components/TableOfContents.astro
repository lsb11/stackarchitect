---
// TableOfContents.astro
export interface Props {
  headings?: { id: string; text: string }[];
}
const { headings = [] } = Astro.props;
---

{headings.length > 0 && (
  <nav class="toc-premium" aria-label="Table of contents">
    <div class="toc-header">
      <div class="toc-title">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
        CONTENTS
      </div>
    </div>
    <div class="toc-body">
      <ul class="toc-list">
        {headings.map((h) => (
          <li>
            <a href={`#${h.id}`}>
              <span class="toc-text">{h.text.replace(/&amp;/g, '&')}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<style>
  /* 
   * 2026 Premium Aesthetic:
   * Desktop: Sticky glassmorphism sidebar floating on the right.
   * Mobile: Sleek, compact inline block that doesn't push the hero out of view.
   */
  .toc-premium {
    /* Mobile defaults (Inline, compact) */
    width: 100%;
    max-width: 760px;
    margin: 2rem auto 3rem;
    padding: 1.25rem;
    border-radius: 12px;
    background: rgba(12, 15, 13, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);
    z-index: 50;
  }

  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  
  .toc-title {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
    color: #6b7671;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .toc-list li {
    margin: 0;
    padding: 0;
  }

  .toc-list a {
    display: block;
    text-decoration: none;
    color: #8c9691;
    font-family: "Inter", -apple-system, sans-serif;
    font-size: 0.82rem;
    line-height: 1.4;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    transition: all 0.2s ease;
    border-left: 2px solid transparent;
  }

  .toc-list a:hover, .toc-list a.active {
    color: #fff;
    background: rgba(255,255,255,0.03);
    border-left-color: #34d377;
    transform: translateX(2px);
  }

  /* DESKTOP FLOATING SIDEBAR (1280px and up) */
  @media (min-width: 1280px) {
    .toc-premium {
      position: fixed;
      top: 120px;
      right: max(24px, calc(50vw - 580px)); /* Keeps it nicely bound to the right of centered content */
      width: 260px;
      max-height: calc(100vh - 160px);
      margin: 0;
      overflow-y: auto;
      padding: 1.5rem;
      /* Scrollbar styling for the sidebar */
      scrollbar-width: thin;
      scrollbar-color: rgba(52,211,119,0.3) transparent;
    }
    
    .toc-premium::-webkit-scrollbar { width: 4px; }
    .toc-premium::-webkit-scrollbar-track { background: transparent; }
    .toc-premium::-webkit-scrollbar-thumb { background: rgba(52,211,119,0.3); border-radius: 4px; }
  }
</style>

<script>
  // Smooth scroll and active state intersection observer
  document.addEventListener('DOMContentLoaded', () => {
    const links = document.querySelectorAll('.toc-premium a[href^="#"]');
    const sections = Array.from(links).map(link => {
      const id = link.getAttribute('href');
      return id ? document.querySelector(id) : null;
    }).filter(Boolean);

    // Smooth scroll logic
    links.forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const href = this.getAttribute('href');
        if (!href) return;
        const target = document.querySelector(href);
        if (target) {
          const offset = 100;
          const bodyRect = document.body.getBoundingClientRect().top;
          const elementRect = target.getBoundingClientRect().top;
          window.scrollTo({
            top: (elementRect - bodyRect) - offset,
            behavior: 'smooth'
          });
          history.pushState(null, '', href);
        }
      });
    });

    // Active state observer
    if (sections.length > 0) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            links.forEach(link => link.classList.remove('active'));
            const activeLink = document.querySelector(`.toc-premium a[href="#${entry.target.id}"]`);
            if (activeLink) activeLink.classList.add('active');
          }
        });
      }, { rootMargin: '-120px 0px -60% 0px' });

      sections.forEach(sec => observer.observe(sec));
    }
  });
</script>
