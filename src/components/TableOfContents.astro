---
// TableOfContents.astro
export interface Props {
  headings?: { id: string; text: string }[];
}
const { headings = [] } = Astro.props;
---

{headings.length > 0 && (
  <nav 
    class="toc-premium" 
    aria-label="Table of contents"
  >
    <div class="toc-header">CONTENTS //</div>
    <ul class="toc-list">
      {headings.map((h) => (
        <li>
          <a href={`#${h.id}`}>
            <span class="toc-arrow">&rarr;</span>
            <span class="toc-text">{h.text.replace(/&amp;/g, '&')}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc-premium {
    max-width: 760px;
    margin: 2rem auto 3rem;
    padding: 1.5rem 1.75rem;
    border-radius: 12px;
    background: rgba(12, 15, 13, 0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 
      0 4px 30px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      inset 0 0 20px rgba(52, 211, 119, 0.02);
  }

  .toc-header {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
    color: #6b7671;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
  }
  
  .toc-header::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(107, 118, 113, 0.2), transparent);
    margin-left: 12px;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .toc-list li {
    margin: 0;
    padding: 0;
  }

  .toc-list a {
    display: flex;
    align-items: flex-start;
    text-decoration: none;
    color: #9ca3af;
    font-family: "Inter", -apple-system, sans-serif;
    font-size: 0.875rem;
    line-height: 1.5;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 0.25rem 0;
  }

  .toc-arrow {
    color: #4b5563;
    margin-right: 12px;
    font-family: monospace;
    transition: color 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .toc-list a:hover {
    color: #fff;
  }

  .toc-list a:hover .toc-arrow {
    color: #34d377;
    transform: translateX(4px);
  }
</style>

<script>
  // Progressive enhancement: smooth scroll to anchor links
  document.querySelectorAll('.toc-premium a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const href = this.getAttribute('href');
      if (!href) return;
      const target = document.querySelector(href);
      if (target) {
        // Scroll to the target with some top offset for stick headers
        const offset = 80;
        const bodyRect = document.body.getBoundingClientRect().top;
        const elementRect = target.getBoundingClientRect().top;
        const elementPosition = elementRect - bodyRect;
        const offsetPosition = elementPosition - offset;

        window.scrollTo({
          top: offsetPosition,
          behavior: 'smooth'
        });
        
        // Update URL hash without jumping
        history.pushState(null, '', href);
      }
    });
  });
</script>
