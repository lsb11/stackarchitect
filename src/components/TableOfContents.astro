---
// TableOfContents.astro
---
<div id="toc-container" style="max-width:860px;margin:0 auto 2rem;padding:0 24px;"></div>
<script>
  const main = document.querySelector('main') || document.body;
  const tocContainer = document.getElementById('toc-container');
  if (main && tocContainer) {
    // Exclude h2s inside the toc itself or footer
    const h2s = Array.from(main.querySelectorAll('h2')).filter(h2 => !h2.closest('#toc-container'));
    if (h2s.length >= 2) {
      h2s.forEach((h, i) => {
        if (!h.id) h.id = `section-${i}-${(h.textContent||'').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`;
      });
      const toc = document.createElement('nav');
      toc.setAttribute('aria-label', 'Table of contents');
      toc.style.cssText = 'border:1px solid #222825;background:#0c0f0d;padding:16px;font-family:"JetBrains Mono",monospace;';
      toc.innerHTML = '<div style="font-size:12px;color:#6b7671;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:12px;">CONTENTS //</div>';
      
      const ul = document.createElement('ul');
      ul.style.cssText = 'list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:6px;';
      
      h2s.forEach(h => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.innerHTML = `<span style="color:#262c29;margin-right:8px;">→</span>${h.textContent}`;
        a.style.cssText = 'font-size:12px;color:#9ca3af;text-decoration:none;display:flex;align-items:center;transition:color 0.2s;';
        a.addEventListener('mouseover', () => a.style.color = '#34d377');
        a.addEventListener('mouseout', () => a.style.color = '#9ca3af');
        li.appendChild(a);
        ul.appendChild(li);
      });
      toc.appendChild(ul);
      tocContainer.appendChild(toc);
    }
  }
</script>
