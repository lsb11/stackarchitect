---
// TableOfContents.astro
export interface Props {
  headings?: { id: string; text: string }[];
}
const { headings = [] } = Astro.props;
---

{headings.length > 0 && (
  <div class="toc-wrapper">
    <!-- Floating Widget for scrolling (Desktop & Mobile) -->
    <div class="toc-floating-widget" id="toc-widget">
      <button class="toc-fab" id="toc-fab" aria-label="Toggle Table of Contents" title="Table of Contents">
        <svg class="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
        <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <nav class="toc-floating-panel" id="toc-panel" aria-label="Table of contents">
        <div class="toc-header">
          <div class="toc-title">CONTENTS</div>
        </div>
        <div class="toc-body">
          <ul class="toc-list">
            {headings.map((h) => (
              <li>
                <a href={`#${h.id}`}>
                  <span class="toc-text">{h.text.replace(/&amp;/g, '&')}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    </div>
  </div>
)}

<style>
  /* Shared Styles */
  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  
  .toc-title {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
    color: #6b7671;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .toc-list li { margin: 0; padding: 0; }

  .toc-list a {
    display: block;
    text-decoration: none;
    color: #8c9691;
    font-family: "Inter", -apple-system, sans-serif;
    font-size: 0.82rem;
    line-height: 1.4;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    transition: all 0.2s ease;
    border-left: 2px solid transparent;
  }

  .toc-list a:hover, .toc-list a.active {
    color: #fff;
    background: rgba(255,255,255,0.03);
    border-left-color: #34d377;
    transform: translateX(2px);
  }

  /* Floating Widget Styles */
  .toc-floating-widget {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    pointer-events: none; /* Let clicks pass through widget container */
  }

  .toc-fab {
    pointer-events: auto;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(12, 15, 13, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(52, 211, 119, 0.2);
    color: #34d377;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4), inset 0 0 10px rgba(52, 211, 119, 0.05);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    opacity: 0;
    transform: translateY(20px) scale(0.8);
    visibility: hidden;
  }

  /* Show FAB based on scroll */
  .toc-floating-widget.is-visible .toc-fab {
    opacity: 1;
    transform: translateY(0) scale(1);
    visibility: visible;
  }

  .toc-fab:hover {
    background: rgba(52, 211, 119, 0.1);
    border-color: rgba(52, 211, 119, 0.4);
    transform: translateY(-2px) scale(1.05);
  }

  .toc-fab .icon-close { display: none; }
  .toc-floating-widget.is-open .toc-fab .icon-menu { display: none; }
  .toc-floating-widget.is-open .toc-fab .icon-close { display: block; }
  .toc-floating-widget.is-open .toc-fab {
    background: #34d377;
    color: #0c0f0d;
  }

  .toc-floating-panel {
    pointer-events: auto;
    position: absolute;
    bottom: 64px;
    right: 0;
    width: 280px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding: 1.5rem;
    border-radius: 16px;
    background: rgba(12, 15, 13, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    
    /* Animation state */
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transform-origin: bottom right;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    
    scrollbar-width: thin;
    scrollbar-color: rgba(52,211,119,0.3) transparent;
  }

  .toc-floating-panel::-webkit-scrollbar { width: 4px; }
  .toc-floating-panel::-webkit-scrollbar-track { background: transparent; }
  .toc-floating-panel::-webkit-scrollbar-thumb { background: rgba(52,211,119,0.3); border-radius: 4px; }

  .toc-floating-widget.is-open .toc-floating-panel {
    opacity: 1;
    transform: translateY(0) scale(1);
    visibility: visible;
  }

  @media (max-width: 640px) {
    .toc-floating-panel {
      width: calc(100vw - 48px);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const widget = document.getElementById('toc-widget');
    const fab = document.getElementById('toc-fab');
    
    // 1. FAB Toggle Logic
    if (fab && widget) {
      fab.addEventListener('click', () => {
        widget.classList.toggle('is-open');
      });

      // Close panel when clicking outside
      document.addEventListener('click', (e) => {
        if (widget.classList.contains('is-open') && !widget.contains(e.target as Node)) {
          widget.classList.remove('is-open');
        }
      });
    }

    // 2. Show/Hide FAB based on scroll position (show after scrolling down 300px)
    if (widget) {
      const handleScroll = () => {
        if (window.scrollY > 300) {
          widget.classList.add('is-visible');
        } else {
          widget.classList.remove('is-visible');
          widget.classList.remove('is-open'); // auto-close if scrolled back to top
        }
      };
      
      // Check on load
      handleScroll();
      // Check on scroll
      window.addEventListener('scroll', handleScroll, { passive: true });
    }

    // 3. Smooth scroll and active state logic
    const links = document.querySelectorAll('.toc-wrapper a[href^="#"]');
    const sections = Array.from(links).map(link => {
      const id = link.getAttribute('href');
      return id ? document.querySelector(id) : null;
    }).filter(Boolean);

    const uniqueSections = [...new Set(sections)];

    links.forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const href = this.getAttribute('href');
        if (!href) return;
        const target = document.querySelector(href);
        if (target) {
          const offset = 100;
          const bodyRect = document.body.getBoundingClientRect().top;
          const elementRect = target.getBoundingClientRect().top;
          window.scrollTo({
            top: (elementRect - bodyRect) - offset,
            behavior: 'smooth'
          });
          history.pushState(null, '', href);
          
          // Auto-close floating panel after click
          if (widget) {
            widget.classList.remove('is-open');
          }
        }
      });
    });

    if (uniqueSections.length > 0) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            links.forEach(link => link.classList.remove('active'));
            // Highlight active link
            const activeLinks = document.querySelectorAll(`.toc-wrapper a[href="#${entry.target.id}"]`);
            activeLinks.forEach(activeLink => activeLink.classList.add('active'));
          }
        });
      }, { rootMargin: '-120px 0px -60% 0px' });

      uniqueSections.forEach(sec => observer.observe(sec));
    }
  });
</script>
