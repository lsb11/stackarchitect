---
// How Shopify server-side tracking flows (20 Oct 2026), now one instance of
// <FlowDiagram>. Wording is the diagram's
// (public/diagrams/shopify-server-side-tracking-flow-2026.svg), which stays
// the page's schema image.
import FlowDiagram from './FlowDiagram.astro';
---
<FlowDiagram
  id="tf"
  eyebrow="How it works · $0 on free plans"
  source={{ name: 'Shopify', desc: 'An order is paid; the <code>orders/paid</code> webhook fires from Shopify&rsquo;s backend.', tag: 'No app install · no theme code' }}
  hub={{ name: 'Make.com scenario', desc: 'Hashes email, phone, name, IP and user agent with SHA-256, then posts the purchase.', tag: '1 scenario · free tier · about 1 credit per module per order' }}
  dests={[
    { name: 'Meta Conversions API', desc: '<code>Purchase</code> event, full match keys', tone: 'meta' },
    { name: 'TikTok Events API', desc: '<code>CompletePayment</code>, Advanced Matching', tone: 'tt' },
    { name: 'Google Ads', desc: 'Not in the scenario: turn on enhanced conversions in Shopify&rsquo;s Google &amp; YouTube app', tone: 'gg' },
  ]}
  note={{ title: 'The old browser-pixel path', body: 'iOS 17+ Link Tracking Protection strips click IDs in Mail and Messages, and ad blockers stop the pixel, so some ad-driven purchases never reach the platforms. We publish no loss figure.' }}
  caption="The $0 architecture: one webhook and one Make.com scenario feed Meta and TikTok server-to-server. Nothing in that path runs in the browser."
/>
