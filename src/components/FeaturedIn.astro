<style>
  .featured-in-wrapper {
    margin: 2.5rem auto;
    padding: 1.5rem 2rem;
    background: rgba(12, 15, 13, 0.6);
    border: 1px solid rgba(52, 211, 119, 0.15);
    border-radius: 16px;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    text-align: center;
    position: relative;
    overflow: hidden;
    max-width: 900px;
  }

  /* Subtle glow effect behind the component */
  .featured-in-wrapper::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, rgba(52, 211, 119, 0.05) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
  }

  .fi-label {
    position: relative;
    z-index: 1;
    font-family: var(--mono, ui-monospace, monospace);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #6b7671;
    margin-bottom: 1.25rem;
    font-weight: 600;
  }

  .fi-logos {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2rem 3rem;
  }

  .fi-logo-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #a0aba5;
    text-decoration: none;
    font-family: var(--sans, system-ui, sans-serif);
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    opacity: 0.8;
    filter: grayscale(100%);
  }

  .fi-logo-link:hover {
    color: #ffffff;
    opacity: 1;
    filter: grayscale(0%);
    transform: translateY(-2px);
  }
  
  .fi-logo-link:hover .fi-icon {
    color: #34d377;
  }

  .fi-icon {
    width: 24px;
    height: 24px;
    transition: color 0.3s ease;
  }
  
  .astro-icon {
    width: 28px;
    height: 28px;
  }

  @media (max-width: 640px) {
    .featured-in-wrapper {
      padding: 1.25rem 1rem;
      border-radius: 12px;
    }
    .fi-logos {
      gap: 1.25rem;
      flex-direction: column;
    }
  }
</style>
