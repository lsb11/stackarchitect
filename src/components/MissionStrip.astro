---
// Who this site is for, how it checks what it says, and how it earns.
// Copy lives in src/data/mission.ts.
import { AUDIENCE, HOW_WE_CHECK, HOW_WE_EARN } from '../data/mission';
---

<section class="sa-mission" aria-labelledby="sa-mission-h">
  <h2 id="sa-mission-h" class="sa-mission-h">What Stack Architect does</h2>
  <div class="sa-mission-grid">
    <div class="sa-mission-col" style="--tone:#34d377">
      <h3><span class="sa-mi" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18.5 14.8c1.6.8 2.6 2.6 3 5.2"/></svg></span>Who it is for</h3>
      <ul class="sa-who">
        {AUDIENCE.map((a) => <li><strong>{a.who}</strong><span>{a.what}</span></li>)}
      </ul>
    </div>
    <div class="sa-mission-col" style="--tone:#38bdf8">
      <h3><span class="sa-mi" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg></span>How we check</h3>
      <p>{HOW_WE_CHECK} <a href="/how-we-test/">Our method</a>.</p>
    </div>
    <div class="sa-mission-col" style="--tone:#fbbf24">
      <h3><span class="sa-mi" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M14.8 9.2c-.5-1-1.6-1.6-2.8-1.6-1.6 0-2.8.9-2.8 2.2 0 3 5.6 1.5 5.6 4.4 0 1.3-1.2 2.2-2.8 2.2-1.3 0-2.4-.6-2.9-1.7M12 6v1.6M12 16.4V18"/></svg></span>How we earn</h3>
      <p>{HOW_WE_EARN} <a href="/about/">Who runs it</a>.</p>
    </div>
  </div>
</section>

<style>
  .sa-mission {
    max-width: 1100px;
    margin: 48px auto;
    padding: 0 24px;
    box-sizing: border-box;
    text-align: left;
  }
  .sa-mission-h { font-size: 24px; letter-spacing: -0.01em; color: #f2f5f3; margin: 0 0 18px; }
  .sa-mission-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .sa-mission-col {
    position: relative;
    border: 1px solid #222825;
    border-radius: 14px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--tone) 7%, #0c0f0d) 0%, #0c0f0d 55%);
    padding: 22px 22px 20px;
    overflow: hidden;
  }
  .sa-mission-col::before {
    content: ""; position: absolute; inset: 0 0 auto 0; height: 3px;
    background: var(--tone); opacity: .85;
  }
  .sa-mission-col h3 {
    display: flex; align-items: center; gap: 10px;
    font-size: 16px; font-weight: 650; color: var(--tone); margin: 0 0 14px;
  }
  .sa-mi {
    display: inline-grid; place-items: center; flex: none;
    width: 30px; height: 30px; border-radius: 9px;
    color: var(--tone);
    background: color-mix(in srgb, var(--tone) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--tone) 30%, transparent);
  }
  .sa-mission-col p, .sa-mission-col li { font-size: 15px; color: #b6c0ba; line-height: 1.6; margin: 0; }
  .sa-who { list-style: none; margin: 0; padding: 0; }
  .sa-who li { display: grid; gap: 2px; padding: 0 0 0 14px; border-left: 2px solid color-mix(in srgb, var(--tone) 45%, transparent); }
  .sa-who li + li { margin-top: 14px; }
  .sa-who strong { color: #f2f5f3; font-weight: 650; }
  .sa-mission-col a { color: var(--tone); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 800px) {
    .sa-mission-grid { grid-template-columns: 1fr; }
    .sa-mission { padding: 0 16px; }
  }
</style>
